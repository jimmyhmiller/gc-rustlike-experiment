// The gc-rust prelude — auto-imported into every program. Written in gc-rust
// itself. A user item with the same name as a prelude item shadows it, along
// with the prelude's impls for that type or trait.
//
// The API follows Rust's standard library: collections and strings are used
// through methods (`Vec::new()`, `v.push(x)`, `v[i]`, `s.len()`), and
// operators on non-scalar types dispatch to the traits below (`a + b` →
// `Add::add`, `a == b` → `Eq::eq`, `a < b` → `Ord::cmp`). There are no
// references: a struct value is a GC reference, and `mut self` methods mutate
// the object in place, so every alias observes the change.

// ---- Core sum types -------------------------------------------------------

// A value (unboxed) enum: a flat tag + payload, no heap allocation. This keeps
// `get` returning `Option<T>` free of per-access allocation — when the result
// is matched immediately, LLVM collapses the Option entirely.
#[value]
enum Option<T> { None, Some(T) }

// Also a value enum, so `?`, `ok_or`, and `map_err` allocate nothing.
#[value]
enum Result<T, E> { Ok(T), Err(E) }

// The result of `Ord::cmp`.
#[value]
enum Ordering { Less, Equal, Greater }

// ---- Operator and comparison traits ----------------------------------------
// Scalars use the built-in operators. For any other type, an operator calls
// the method of that type's impl of the matching trait.

// `Eq` is Rust's `PartialEq` (`PartialEq` names it too); an empty
// `impl Eq for T {}` marker is accepted and adds nothing.
trait Eq<Rhs = Self> {
    fn eq(self, other: Rhs) -> bool;
    fn ne(self, other: Rhs) -> bool { !self.eq(other) }
}
// `Ord` types are also partially ordered; `<` uses `cmp`, or `partial_cmp`
// for a type that is only `PartialOrd` (an unordered pair compares false).
trait Ord {
    fn cmp(self, other: Self) -> Ordering;
    fn partial_cmp(self, other: Self) -> Option<Ordering> { Option::Some(self.cmp(other)) }
    fn max(self, other: Self) -> Self { if self.cmp(other) == Ordering::Greater { self } else { other } }
    fn min(self, other: Self) -> Self { if self.cmp(other) == Ordering::Greater { other } else { self } }
    fn clamp(self, lo: Self, hi: Self) -> Self { self.max(lo).min(hi) }
}
trait PartialOrd<Rhs = Self> { fn partial_cmp(self, other: Rhs) -> Option<Ordering>; }

// Arithmetic and bitwise operators, shaped like Rust's: `Rhs` defaults to
// `Self` and `Output` to `Self`, so `impl Add for V { fn add(self, o: V) -> V }`
// works as well as `impl Add<f64> for V { type Output = V; ... }`.
trait Add<Rhs = Self> { type Output = Self; fn add(self, rhs: Rhs) -> Self::Output; }
trait Sub<Rhs = Self> { type Output = Self; fn sub(self, rhs: Rhs) -> Self::Output; }
trait Mul<Rhs = Self> { type Output = Self; fn mul(self, rhs: Rhs) -> Self::Output; }
trait Div<Rhs = Self> { type Output = Self; fn div(self, rhs: Rhs) -> Self::Output; }
trait Rem<Rhs = Self> { type Output = Self; fn rem(self, rhs: Rhs) -> Self::Output; }
trait BitAnd<Rhs = Self> { type Output = Self; fn bitand(self, rhs: Rhs) -> Self::Output; }
trait BitOr<Rhs = Self> { type Output = Self; fn bitor(self, rhs: Rhs) -> Self::Output; }
trait BitXor<Rhs = Self> { type Output = Self; fn bitxor(self, rhs: Rhs) -> Self::Output; }
trait Neg { type Output = Self; fn neg(self) -> Self::Output; }
trait Not { type Output = Self; fn not(self) -> Self::Output; }
// `a += b` calls `add_assign` when the type implements it, else `a = a + b`.
trait AddAssign<Rhs = Self> { fn add_assign(mut self, rhs: Rhs); }
trait SubAssign<Rhs = Self> { fn sub_assign(mut self, rhs: Rhs); }
trait MulAssign<Rhs = Self> { fn mul_assign(mut self, rhs: Rhs); }
trait DivAssign<Rhs = Self> { fn div_assign(mut self, rhs: Rhs); }
trait RemAssign<Rhs = Self> { fn rem_assign(mut self, rhs: Rhs); }

// `x[i]` on a non-array type calls `Index::index`; `x[i] = v` calls
// `IndexSet::index_set`. (Without references there is no `IndexMut`, so
// assignment through an index is its own trait.)
trait Index<Idx> { type Output; fn index(self, idx: Idx) -> Self::Output; }
trait IndexSet<T> { fn index_set(mut self, i: i64, value: T); }
// `x[lo..hi]` (also `x[lo..]`, `x[..hi]`, `x[lo..=hi]`) calls
// `IndexRange::index_range(lo, hi)`, which returns a copy of that part.
trait IndexRange<T> { fn index_range(self, lo: i64, hi: i64) -> T; }

// `Hash` lets a type be used as a `HashMap<K, V>` key; implement it together
// with `Eq`. The map folds the hash into a power-of-two bucket index, so any
// i64 (including negative) is fine.
trait Hash { fn hash(self) -> i64; }

trait ToString { fn to_string(self) -> String; }

// Marker: values of the type may be shared between threads. Usually derived
// from the type's fields; `impl Sync for T {}` asserts it.
trait Sync {}
// Bounds Rust code uses that every type here meets: values are copied or
// shared through the GC, and thread sharing is checked through `Sync`.
trait Copy {}
trait Send {}
trait Sized {}
trait Unpin {}

// Conversions: `T::from(x)`, `let t: T = From::from(x)`.
trait From<T> { fn from(value: T) -> Self; }
// `x.into()` is `From::from(x)` into the expected type; `T: Into<U>` holds
// when `U: From<T>`, and every type converts into itself.
trait Into<T> { fn into(self) -> T; }

// Fallible conversions (`u32::try_from(x)`, `x.try_into()`).
trait TryFrom<T> { type Error; fn try_from(value: T) -> Result<Self, Self::Error>; }
trait TryInto<T> { type Error; fn try_into(self) -> Result<T, Self::Error>; }
impl<T, U: TryFrom<T>> TryInto<U> for T {
    type Error = U::Error;
    fn try_into(self) -> Result<U, U::Error> { U::try_from(self) }
}
struct TryFromIntError {}
impl Display for TryFromIntError {
    fn fmt(self, f: Formatter) -> FmtResult { f.write_str("out of range integral type conversion attempted") }
}
impl Debug for TryFromIntError {
    fn fmt(self, f: Formatter) -> FmtResult { f.write_str("TryFromIntError(())") }
}
macro_rules! try_from_i64 {
    ($($t:ty),*) => {$(
        impl TryFrom<i64> for $t {
            type Error = TryFromIntError;
            fn try_from(value: i64) -> Result<$t, TryFromIntError> {
                if value < (<$t>::MIN as i64) || value > (<$t>::MAX as i64) { Result::Err(TryFromIntError {}) }
                else { Result::Ok(value as $t) }
            }
        }
    )*};
}
try_from_i64!(i8, i16, i32, u8, u16, u32);
impl TryFrom<i64> for i64 {
    type Error = TryFromIntError;
    fn try_from(value: i64) -> Result<i64, TryFromIntError> { Result::Ok(value) }
}
impl TryFrom<i64> for u64 {
    type Error = TryFromIntError;
    fn try_from(value: i64) -> Result<u64, TryFromIntError> {
        if value < 0 { Result::Err(TryFromIntError {}) } else { Result::Ok(value as u64) }
    }
}

// `clone` copies a collection's storage, so the copy and the original can be
// mutated independently; a `Vec`'s elements are cloned too, as in Rust. A
// type with no `Clone` impl is cloned by sharing it (in Rust, such a clone
// is an `Rc`/`Arc` one).
trait Clone { fn clone(self) -> Self; }

impl Ordering {
    fn is_eq(self) -> bool { match self { Ordering::Equal => true, _ => false } }
    fn is_ne(self) -> bool { match self { Ordering::Equal => false, _ => true } }
    fn is_lt(self) -> bool { match self { Ordering::Less => true, _ => false } }
    fn is_gt(self) -> bool { match self { Ordering::Greater => true, _ => false } }
    fn is_le(self) -> bool { match self { Ordering::Greater => false, _ => true } }
    fn is_ge(self) -> bool { match self { Ordering::Less => false, _ => true } }
    fn reverse(self) -> Ordering {
        match self { Ordering::Less => Ordering::Greater, Ordering::Equal => Ordering::Equal, Ordering::Greater => Ordering::Less }
    }
}
impl Eq for Ordering {
    fn eq(self, other: Ordering) -> bool {
        match self {
            Ordering::Less => other.is_lt(),
            Ordering::Equal => other.is_eq(),
            Ordering::Greater => other.is_gt(),
        }
    }
}

// ---- Scalar trait impls ------------------------------------------------------

impl Eq for i8 { fn eq(self, other: i8) -> bool { self == other } }
impl Eq for i16 { fn eq(self, other: i16) -> bool { self == other } }
impl Eq for i32 { fn eq(self, other: i32) -> bool { self == other } }
impl Eq for i64 { fn eq(self, other: i64) -> bool { self == other } }
impl Eq for u8 { fn eq(self, other: u8) -> bool { self == other } }
impl Eq for u16 { fn eq(self, other: u16) -> bool { self == other } }
impl Eq for u32 { fn eq(self, other: u32) -> bool { self == other } }
impl Eq for u64 { fn eq(self, other: u64) -> bool { self == other } }
impl Eq for f32 { fn eq(self, other: f32) -> bool { self == other } }
impl Eq for f64 { fn eq(self, other: f64) -> bool { self == other } }
impl Eq for bool { fn eq(self, other: bool) -> bool { self == other } }
impl Eq for char { fn eq(self, other: char) -> bool { self == other } }

impl Ord for i8 { fn cmp(self, other: i8) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for i16 { fn cmp(self, other: i16) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for i32 { fn cmp(self, other: i32) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for i64 { fn cmp(self, other: i64) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for u8 { fn cmp(self, other: u8) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for u16 { fn cmp(self, other: u16) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for u32 { fn cmp(self, other: u32) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for u64 { fn cmp(self, other: u64) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for bool { fn cmp(self, other: bool) -> Ordering { if self == other { Ordering::Equal } else if self { Ordering::Greater } else { Ordering::Less } } }
impl PartialOrd for f32 {
    fn partial_cmp(self, other: f32) -> Option<Ordering> {
        if self < other { Option::Some(Ordering::Less) } else if self > other { Option::Some(Ordering::Greater) }
        else if self == other { Option::Some(Ordering::Equal) } else { Option::None }
    }
}
impl PartialOrd for f64 {
    fn partial_cmp(self, other: f64) -> Option<Ordering> {
        if self < other { Option::Some(Ordering::Less) } else if self > other { Option::Some(Ordering::Greater) }
        else if self == other { Option::Some(Ordering::Equal) } else { Option::None }
    }
}
impl Ord for char { fn cmp(self, other: char) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }

// SplitMix64-style finalizer: scrambles sequential integer keys so they don't
// cluster in the open-addressed table. Arithmetic wraps (gc-rust ints wrap by
// default); the constants are < 2^32 so the literals never overflow i64.
impl Hash for i64 {
    fn hash(self) -> i64 {
        let mut z = self;
        z = (z ^ (z >> 33)) * 2654435769;
        z = (z ^ (z >> 29)) * 2246822519;
        z = z ^ (z >> 32);
        z
    }
}
impl Hash for i32 { fn hash(self) -> i64 { (self as i64).hash() } }
impl Hash for u8 { fn hash(self) -> i64 { (self as i64).hash() } }
impl Hash for u32 { fn hash(self) -> i64 { (self as i64).hash() } }
impl Hash for u64 { fn hash(self) -> i64 { (self as i64).hash() } }
impl Hash for bool { fn hash(self) -> i64 { if self { 1 } else { 0 } } }
impl Hash for char { fn hash(self) -> i64 { (self as i64).hash() } }

impl ToString for i8 { fn to_string(self) -> String { to_string(self) } }
impl ToString for i16 { fn to_string(self) -> String { to_string(self) } }
impl ToString for i32 { fn to_string(self) -> String { to_string(self) } }
impl ToString for i64 { fn to_string(self) -> String { to_string(self) } }
impl ToString for u8 { fn to_string(self) -> String { to_string(self) } }
impl ToString for u16 { fn to_string(self) -> String { to_string(self) } }
impl ToString for u32 { fn to_string(self) -> String { to_string(self) } }
impl ToString for u64 { fn to_string(self) -> String { to_string(self) } }
impl ToString for f32 { fn to_string(self) -> String { to_string(self) } }
impl ToString for f64 { fn to_string(self) -> String { to_string(self) } }
impl ToString for bool { fn to_string(self) -> String { if self { "true" } else { "false" } } }
impl ToString for char { fn to_string(self) -> String { char_to_str(self as i64) } }

// ---- Chars: a string's chars, decoded lazily --------------------------------------

struct Chars { s: String, i: i64, end: i64 }
// The width of the UTF-8 sequence that starts with byte `b0`.
fn utf8_width(b0: i64) -> i64 { if b0 < 128 { 1 } else if b0 < 224 { 2 } else if b0 < 240 { 3 } else { 4 } }
// The char whose UTF-8 sequence starts at byte `i` of `s`.
fn utf8_char_at(s: String, i: i64) -> char {
    let b0 = str_get(s, i);
    if b0 < 128 { b0 as char }
    else if b0 < 224 { (((b0 & 31) << 6) | (str_get(s, i + 1) & 63)) as char }
    else if b0 < 240 { (((b0 & 15) << 12) | ((str_get(s, i + 1) & 63) << 6) | (str_get(s, i + 2) & 63)) as char }
    else { (((b0 & 7) << 18) | ((str_get(s, i + 1) & 63) << 12) | ((str_get(s, i + 2) & 63) << 6) | (str_get(s, i + 3) & 63)) as char }
}
impl Iterator for Chars {
    type Item = char;
    fn next(mut self) -> Option<char> {
        if self.i >= self.end { return Option::None; }
        let c = utf8_char_at(self.s, self.i);
        self.i = self.i + utf8_width(str_get(self.s, self.i));
        Option::Some(c)
    }
}
impl Chars {
    // Back to front.
    fn rev(self) -> CharsRev { CharsRev { s: self.s, i: self.i, end: self.end } }
    // The part not yet taken (`Chars::as_str`).
    fn as_str(self) -> String { str_substring(self.s, self.i, self.end) }
}
struct CharsRev { s: String, i: i64, end: i64 }
impl Iterator for CharsRev {
    type Item = char;
    fn next(mut self) -> Option<char> {
        if self.end <= self.i { return Option::None; }
        // Step back over continuation bytes (10xxxxxx) to the sequence start.
        let mut j = self.end - 1;
        while j > self.i && (str_get(self.s, j) & 192) == 128 { j -= 1; }
        self.end = j;
        Option::Some(utf8_char_at(self.s, j))
    }
}

// ---- Bytes and UTF-8 ------------------------------------------------------------

// `String::from_utf8`'s error: the bytes, and how many of them are valid.
#[derive(Debug, Clone, PartialEq)]
struct FromUtf8Error { bytes: Vec<u8>, valid_up_to: i64 }
impl FromUtf8Error {
    fn into_bytes(self) -> Vec<u8> { self.bytes }
    fn valid_up_to(self) -> i64 { self.valid_up_to }
}
impl Display for FromUtf8Error {
    fn fmt(self, f: Formatter) -> FmtResult { f.write_str(format!("invalid utf-8 sequence at byte {}", self.valid_up_to)) }
}

impl String {
    // A copy of the string's bytes (strings are immutable, so a copy is the
    // only way to hand them out).
    fn as_bytes(self) -> Vec<u8> {
        let n = str_len(self);
        let bytes: Array<u8> = Array::new(n);
        str_copy_bytes(self, bytes);
        Vec::from_array(bytes)
    }
    fn into_bytes(self) -> Vec<u8> { self.as_bytes() }
    fn bytes(self) -> VecIter<u8> { self.as_bytes().into_iter() }
    fn as_str(self) -> String { self }
    fn from_utf8(bytes: Vec<u8>) -> Result<String, FromUtf8Error> {
        let valid = str_from_utf8_prefix(bytes.data, bytes.len());
        if valid.len() == bytes.len() { Ok(valid) }
        else { Err(FromUtf8Error { bytes: bytes, valid_up_to: valid.len() }) }
    }
}

impl u8 {
    fn is_ascii(self) -> bool { self < 128 }
    fn is_ascii_digit(self) -> bool { self >= b'0' && self <= b'9' }
    fn is_ascii_hexdigit(self) -> bool { self.is_ascii_digit() || (self >= b'a' && self <= b'f') || (self >= b'A' && self <= b'F') }
    fn is_ascii_lowercase(self) -> bool { self >= b'a' && self <= b'z' }
    fn is_ascii_uppercase(self) -> bool { self >= b'A' && self <= b'Z' }
    fn is_ascii_alphabetic(self) -> bool { self.is_ascii_lowercase() || self.is_ascii_uppercase() }
    fn is_ascii_alphanumeric(self) -> bool { self.is_ascii_alphabetic() || self.is_ascii_digit() }
    fn is_ascii_whitespace(self) -> bool { self == b' ' || self == b'\t' || self == b'\n' || self == 12 || self == b'\r' }
    fn is_ascii_punctuation(self) -> bool { (self >= 33 && self <= 47) || (self >= 58 && self <= 64) || (self >= 91 && self <= 96) || (self >= 123 && self <= 126) }
    fn to_ascii_lowercase(self) -> u8 { if self.is_ascii_uppercase() { self + 32 } else { self } }
    fn to_ascii_uppercase(self) -> u8 { if self.is_ascii_lowercase() { self - 32 } else { self } }
}

impl<T> Vec<T> {
    // Keep the elements `keep` accepts, in order.
    fn retain(mut self, keep: fn(T) -> bool) {
        let mut j = 0;
        let mut i = 0;
        while i < self.len {
            let x = self.data[i];
            if keep(x) { self.data[j] = x; j += 1; }
            i += 1;
        }
        self.len = j;
    }
}

// ---- Parsing: `s.parse::<T>()` -----------------------------------------------

trait FromStr {
    type Err;
    fn from_str(s: String) -> Result<Self, Self::Err>;
}
impl String {
    fn parse<F: FromStr>(self) -> Result<F, F::Err> { F::from_str(self) }
}

#[derive(Debug, Clone, Copy, PartialEq)]
enum IntErrorKind { Empty, InvalidDigit, PosOverflow, NegOverflow, Zero }
#[derive(Debug, Clone, PartialEq)]
struct ParseIntError { kind: IntErrorKind }
impl ParseIntError {
    fn kind(self) -> IntErrorKind { self.kind }
}
impl Display for ParseIntError {
    fn fmt(self, f: Formatter) -> FmtResult {
        f.write_str(match self.kind {
            IntErrorKind::Empty => "cannot parse integer from empty string",
            IntErrorKind::InvalidDigit => "invalid digit found in string",
            IntErrorKind::PosOverflow => "number too large to fit in target type",
            IntErrorKind::NegOverflow => "number too small to fit in target type",
            IntErrorKind::Zero => "number would be zero for non-zero type",
        })
    }
}
#[derive(Debug, Clone, PartialEq)]
struct ParseFloatError { empty: bool }
impl Display for ParseFloatError {
    fn fmt(self, f: Formatter) -> FmtResult {
        f.write_str(if self.empty { "cannot parse float from empty string" } else { "invalid float literal" })
    }
}

// An i64 in [min, max], or why not.
fn parse_int_in(s: String, min: i64, max: i64) -> Result<i64, ParseIntError> {
    let n = str_len(s);
    if n == 0 { return Err(ParseIntError { kind: IntErrorKind::Empty }); }
    let first = str_get(s, 0);
    let neg = first == 45;
    let start = if neg || first == 43 { 1 } else { 0 };
    if start == n { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
    if neg && min == 0 { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
    let mut i = start;
    while i < n {
        let c = str_get(s, i);
        if c < 48 || c > 57 { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
        i += 1;
    }
    match s.parse_i64() {
        Some(v) => if v > max { Err(ParseIntError { kind: IntErrorKind::PosOverflow }) } else if v < min { Err(ParseIntError { kind: IntErrorKind::NegOverflow }) } else { Ok(v) },
        None => Err(ParseIntError { kind: if neg { IntErrorKind::NegOverflow } else { IntErrorKind::PosOverflow } }),
    }
}
macro_rules! from_str_ints {
    ($($t:ty)*) => { $(
        impl FromStr for $t {
            type Err = ParseIntError;
            fn from_str(s: String) -> Result<$t, ParseIntError> {
                parse_int_in(s, <$t>::MIN as i64, <$t>::MAX as i64).map(|v| v as $t)
            }
        }
    )* };
}
from_str_ints!(i8 i16 i32 i64 u8 u16 u32);
impl FromStr for u64 {
    type Err = ParseIntError;
    fn from_str(s: String) -> Result<u64, ParseIntError> {
        // Through u128, so the upper half of u64 parses.
        match u128::from_str(s) {
            Ok(v) => if v > u64::MAX as u128 { Err(ParseIntError { kind: IntErrorKind::PosOverflow }) } else { Ok(v as u64) },
            Err(e) => Err(e),
        }
    }
}
impl FromStr for u128 {
    type Err = ParseIntError;
    fn from_str(s: String) -> Result<u128, ParseIntError> {
        let n = str_len(s);
        if n == 0 { return Err(ParseIntError { kind: IntErrorKind::Empty }); }
        let start = if str_get(s, 0) == 43 { 1 } else { 0 };
        if start == n { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
        let mut acc: u128 = 0;
        let mut i = start;
        while i < n {
            let c = str_get(s, i);
            if c < 48 || c > 57 { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
            let d = (c - 48) as u128;
            if acc > (u128::MAX - d) / 10 { return Err(ParseIntError { kind: IntErrorKind::PosOverflow }); }
            acc = acc * 10 + d;
            i += 1;
        }
        Ok(acc)
    }
}
impl FromStr for i128 {
    type Err = ParseIntError;
    fn from_str(s: String) -> Result<i128, ParseIntError> {
        let neg = str_len(s) > 0 && str_get(s, 0) == 45;
        let digits = if neg { str_substring(s, 1, str_len(s)) } else { s };
        if neg && str_len(digits) > 0 && str_get(digits, 0) == 43 { return Err(ParseIntError { kind: IntErrorKind::InvalidDigit }); }
        match u128::from_str(digits) {
            Ok(v) => if neg {
                if v > (1u128 << 127) { Err(ParseIntError { kind: IntErrorKind::NegOverflow }) } else { Ok((0u128 - v) as i128) }
            } else if v > i128::MAX as u128 { Err(ParseIntError { kind: IntErrorKind::PosOverflow }) } else { Ok(v as i128) },
            Err(e) => Err(if neg && e.kind == IntErrorKind::PosOverflow { ParseIntError { kind: IntErrorKind::NegOverflow } } else { e }),
        }
    }
}
impl FromStr for f64 {
    type Err = ParseFloatError;
    fn from_str(s: String) -> Result<f64, ParseFloatError> {
        match s.parse_f64() { Some(v) => Ok(v), None => Err(ParseFloatError { empty: str_len(s) == 0 }) }
    }
}
impl FromStr for f32 {
    type Err = ParseFloatError;
    fn from_str(s: String) -> Result<f32, ParseFloatError> { f64::from_str(s).map(|v| v as f32) }
}
impl FromStr for bool {
    type Err = String;
    fn from_str(s: String) -> Result<bool, String> {
        if s == "true" { Ok(true) } else if s == "false" { Ok(false) } else { Err("provided string was not `true` or `false`") }
    }
}
impl FromStr for char {
    type Err = String;
    fn from_str(s: String) -> Result<char, String> {
        let cs = s.char_vec();
        if cs.len() == 1 { Ok(cs[0]) } else if cs.len() == 0 { Err("cannot parse char from empty string") } else { Err("too many characters in string") }
    }
}
impl FromStr for String {
    type Err = String;
    fn from_str(s: String) -> Result<String, String> { Ok(s) }
}

// ---- 128-bit integers ---------------------------------------------------------

// Decimal digits, 18 at a time so most of the work is in i64.
fn u128_to_string(v: u128) -> String {
    if v == 0 { return "0"; }
    let mut u = v;
    let mut out: Vec<String> = Vec::new();
    while u > 0 {
        let chunk = (u % 1000000000000000000) as i64;
        u = u / 1000000000000000000;
        let digits = to_string(chunk);
        out.push(if u > 0 { "0".repeat(18 - digits.len()) + digits } else { digits });
    }
    out.reverse();
    out.join("")
}
// `i128::MIN` negates to itself, whose `u128` reading is its magnitude.
fn i128_to_string(v: i128) -> String {
    if v < 0 { "-" + u128_to_string((0 - v) as u128) } else { u128_to_string(v as u128) }
}

impl Eq for i128 { fn eq(self, other: i128) -> bool { self == other } }
impl Eq for u128 { fn eq(self, other: u128) -> bool { self == other } }
impl Ord for i128 { fn cmp(self, other: i128) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Ord for u128 { fn cmp(self, other: u128) -> Ordering { if self < other { Ordering::Less } else if self > other { Ordering::Greater } else { Ordering::Equal } } }
impl Hash for i128 { fn hash(self) -> i64 { ((self as i64) ^ ((self >> 64) as i64).hash()).hash() } }
impl Hash for u128 { fn hash(self) -> i64 { (self as i128).hash() } }
impl ToString for i128 { fn to_string(self) -> String { i128_to_string(self) } }
impl ToString for u128 { fn to_string(self) -> String { u128_to_string(self) } }
impl Display for i128 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(i128_to_string(self)) } }
impl Display for u128 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(u128_to_string(self)) } }
impl Debug for i128 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(i128_to_string(self)) } }
impl Debug for u128 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(u128_to_string(self)) } }
impl Default for i128 { fn default() -> i128 { 0 } }
impl Default for u128 { fn default() -> u128 { 0 } }
impl Clone for i128 { fn clone(self) -> i128 { self } }
impl Clone for u128 { fn clone(self) -> u128 { self } }
impl Sum for i128 { fn zero() -> i128 { 0 } fn one() -> i128 { 1 } }
impl Sum for u128 { fn zero() -> u128 { 0 } fn one() -> u128 { 1 } }

// ---- Integer and float methods -----------------------------------------------

// Unsigned integer helpers (wrapping `+`/`-`/`*` detect overflow by the
// result wrapping around).
macro_rules! unsigned_methods {
    ($($t:ty),*) => {$(
        impl $t {
            fn div_ceil(self, d: $t) -> $t { let q = self / d; if self % d != 0 { q + 1 } else { q } }
            fn checked_add(self, o: $t) -> Option<$t> { let r = self + o; if r < self { Option::None } else { Option::Some(r) } }
            fn checked_sub(self, o: $t) -> Option<$t> { if o > self { Option::None } else { Option::Some(self - o) } }
            fn saturating_add(self, o: $t) -> $t { let r = self + o; if r < self { <$t>::MAX } else { r } }
            fn saturating_sub(self, o: $t) -> $t { if o > self { 0 } else { self - o } }
            fn wrapping_add(self, o: $t) -> $t { self + o }
            fn wrapping_sub(self, o: $t) -> $t { self - o }
            fn abs_diff(self, o: $t) -> $t { if self > o { self - o } else { o - self } }
            fn is_power_of_two(self) -> bool { self != 0 && (self & (self - 1)) == 0 }
        }
    )*};
}
unsigned_methods!(u8, u16, u32, u64, u128);

impl i64 {
    // The largest and smallest i64 values.
    fn max_value() -> i64 { 9223372036854775807 }
    fn min_value() -> i64 { 0 - 9223372036854775807 - 1 }

    fn min(self, other: i64) -> i64 { if self < other { self } else { other } }
    fn max(self, other: i64) -> i64 { if self > other { self } else { other } }
    fn clamp(self, lo: i64, hi: i64) -> i64 {
        if lo > hi { panic("i64::clamp: lo is greater than hi"); }
        self.max(lo).min(hi)
    }
    // Wraps for i64::MIN, like Rust's release-mode `abs`.
    fn abs(self) -> i64 { if self < 0 { 0 - self } else { self } }
    fn signum(self) -> i64 { if self < 0 { 0 - 1 } else if self > 0 { 1 } else { 0 } }

    // `self` raised to `exp`; plain `*`, so the result wraps on overflow.
    fn pow(self, exp: i64) -> i64 {
        if exp < 0 { panic("i64::pow: negative exponent"); }
        let mut result = 1;
        let mut i = 0;
        while i < exp {
            result = result * self;
            i += 1;
        }
        result
    }

    // Overflow-checked arithmetic. Plain `+`/`-`/`*` wrap on overflow (see
    // docs/overflow.md); these return None when the wrapped result differs from
    // the true mathematical result.
    fn checked_add(self, other: i64) -> Option<i64> {
        // Overflows iff both operands share a sign and the sum has the other one.
        let s = self + other;
        if (self < 0) == (other < 0) && (s < 0) != (self < 0) { Option::None } else { Option::Some(s) }
    }
    fn checked_sub(self, other: i64) -> Option<i64> {
        // Overflows iff the operands differ in sign and the result's sign
        // differs from `self`'s.
        let d = self - other;
        if (self < 0) != (other < 0) && (d < 0) != (self < 0) { Option::None } else { Option::Some(d) }
    }
    fn checked_mul(self, other: i64) -> Option<i64> {
        if self == 0 || other == 0 {
            Option::Some(0)
        } else if (self == i64::min_value() && other == 0 - 1) || (other == i64::min_value() && self == 0 - 1) {
            Option::None
        } else {
            // Overflows iff dividing the wrapped product back doesn't recover `self`.
            let p = self * other;
            if p / other == self { Option::Some(p) } else { Option::None }
        }
    }

    fn checked_neg(self) -> Option<i64> { if self == i64::min_value() { Option::None } else { Option::Some(0 - self) } }
    fn checked_abs(self) -> Option<i64> { if self == i64::min_value() { Option::None } else { Option::Some(self.abs()) } }
    fn checked_div(self, other: i64) -> Option<i64> {
        if other == 0 || (self == i64::min_value() && other == 0 - 1) { Option::None } else { Option::Some(self / other) }
    }
    fn checked_rem(self, other: i64) -> Option<i64> {
        if other == 0 || (self == i64::min_value() && other == 0 - 1) { Option::None } else { Option::Some(self % other) }
    }
    fn checked_pow(self, exp: u32) -> Option<i64> {
        let mut result: i64 = 1;
        let mut i: u32 = 0;
        while i < exp {
            result = result.checked_mul(self)?;
            i += 1;
        }
        Option::Some(result)
    }
    fn saturating_add(self, other: i64) -> i64 {
        match self.checked_add(other) { Option::Some(v) => v, Option::None => if other > 0 { i64::max_value() } else { i64::min_value() } }
    }
    fn saturating_sub(self, other: i64) -> i64 {
        match self.checked_sub(other) { Option::Some(v) => v, Option::None => if other < 0 { i64::max_value() } else { i64::min_value() } }
    }
    fn div_euclid(self, other: i64) -> i64 {
        let q = self / other;
        if self % other < 0 { if other > 0 { q - 1 } else { q + 1 } } else { q }
    }
    fn rem_euclid(self, other: i64) -> i64 {
        let r = self % other;
        if r < 0 { if other < 0 { r - other } else { r + other } } else { r }
    }

    // Explicit wrapping forms (identical to `+`/`-`/`*`).
    fn wrapping_add(self, other: i64) -> i64 { self + other }
    fn wrapping_sub(self, other: i64) -> i64 { self - other }
    fn wrapping_mul(self, other: i64) -> i64 { self * other }

    // Byte classes, for the bytes returned by `String::byte_at`.
    fn is_ascii_whitespace(self) -> bool { self == 32 || self == 9 || self == 10 || self == 12 || self == 13 }
    fn is_ascii_digit(self) -> bool { self >= 48 && self <= 57 }
}

extern "C" fn pow(x: f64, y: f64) -> f64;
extern "C" fn atan2(y: f64, x: f64) -> f64;
extern "C" fn fmod(x: f64, y: f64) -> f64;

impl f64 {
    fn min(self, other: f64) -> f64 { if self < other { self } else { other } }
    fn max(self, other: f64) -> f64 { if self > other { self } else { other } }
    fn abs(self) -> f64 { if self < 0.0 { 0.0 - self } else { self } }
    fn sqrt(self) -> f64 { float_sqrt(self) }
    fn floor(self) -> f64 { float_floor(self) }
    fn ceil(self) -> f64 { float_ceil(self) }
    // Halfway cases round away from zero.
    fn round(self) -> f64 { float_round(self) }
    fn trunc(self) -> f64 { float_trunc(self) }
    fn fract(self) -> f64 { self - float_trunc(self) }
    fn sin(self) -> f64 { float_sin(self) }
    fn cos(self) -> f64 { float_cos(self) }
    fn tan(self) -> f64 { float_tan(self) }
    fn exp(self) -> f64 { float_exp(self) }
    fn ln(self) -> f64 { float_ln(self) }
    fn log10(self) -> f64 { float_log10(self) }
    fn log2(self) -> f64 { float_log2(self) }
    fn powf(self, n: f64) -> f64 { unsafe { pow(self, n) } }
    fn powi(self, n: i32) -> f64 { unsafe { pow(self, n as f64) } }
    fn atan2(self, x: f64) -> f64 { unsafe { atan2(self, x) } }
    fn is_nan(self) -> bool { self != self }
    fn is_infinite(self) -> bool { self == f64::INFINITY || self == f64::NEG_INFINITY }
    fn is_finite(self) -> bool { !self.is_nan() && !self.is_infinite() }
    fn signum(self) -> f64 { if self.is_nan() { self } else if self < 0.0 || (self == 0.0 && 1.0 / self < 0.0) { 0.0 - 1.0 } else { 1.0 } }
    fn clamp(self, lo: f64, hi: f64) -> f64 { self.max(lo).min(hi) }
    fn mul_add(self, a: f64, b: f64) -> f64 { self * a + b }
    fn recip(self) -> f64 { 1.0 / self }
    fn to_degrees(self) -> f64 { self * 57.2957795130823208767981548141051703 }
    fn to_radians(self) -> f64 { self * 0.0174532925199432957692369076848861271 }
}

// ---- Option<T> and Result<T, E> ----------------------------------------------

impl<T: Clone> Option<T> {
    // `Option<&T>` → `Option<T>` in Rust; here a copy of the contents.
    fn cloned(self) -> Option<T> { match self { Option::Some(x) => Option::Some(x.clone()), Option::None => Option::None } }
}
impl<T, E> Option<Result<T, E>> {
    fn transpose(self) -> Result<Option<T>, E> {
        match self {
            Option::Some(Result::Ok(x)) => Result::Ok(Option::Some(x)),
            Option::Some(Result::Err(e)) => Result::Err(e),
            Option::None => Result::Ok(Option::None),
        }
    }
}
impl<T, E> Result<Option<T>, E> {
    fn transpose(self) -> Option<Result<T, E>> {
        match self {
            Result::Ok(Option::Some(x)) => Option::Some(Result::Ok(x)),
            Result::Ok(Option::None) => Option::None,
            Result::Err(e) => Option::Some(Result::Err(e)),
        }
    }
}
impl<T> Option<Option<T>> {
    fn flatten(self) -> Option<T> { match self { Option::Some(x) => x, Option::None => Option::None } }
}
impl<T: Default> Option<T> {
    fn unwrap_or_default(self) -> T { match self { Option::Some(x) => x, Option::None => T::default() } }
}
impl<T> Option<T> {
    // Without references, the borrowing adapters are the option itself.
    fn as_ref(self) -> Option<T> { self }
    fn as_mut(self) -> Option<T> { self }
    fn as_deref(self) -> Option<T> { self }
    fn copied(self) -> Option<T> { self }
    fn is_some(self) -> bool { match self { Option::Some(_x) => true, Option::None => false } }
    fn is_none(self) -> bool { match self { Option::Some(_x) => false, Option::None => true } }
    fn unwrap(self) -> T {
        match self { Option::Some(x) => x, Option::None => panic("called `Option::unwrap()` on a `None` value") }
    }
    fn expect(self, message: String) -> T {
        match self { Option::Some(x) => x, Option::None => panic(message) }
    }
    fn unwrap_or(self, default: T) -> T {
        match self { Option::Some(x) => x, Option::None => default }
    }
    fn unwrap_or_else(self, f: fn() -> T) -> T {
        match self { Option::Some(x) => x, Option::None => f() }
    }
    fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self { Option::Some(x) => Option::Some(f(x)), Option::None => Option::None }
    }
    fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self { Option::Some(x) => f(x), Option::None => Option::None }
    }
    fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self { Option::Some(x) => Result::Ok(x), Option::None => Result::Err(err) }
    }
    fn ok_or_else<E>(self, err: fn() -> E) -> Result<T, E> {
        match self { Option::Some(x) => Result::Ok(x), Option::None => Result::Err(err()) }
    }
    fn or(self, other: Option<T>) -> Option<T> { match self { Option::Some(x) => Option::Some(x), Option::None => other } }
    fn or_else(self, f: fn() -> Option<T>) -> Option<T> { match self { Option::Some(x) => Option::Some(x), Option::None => f() } }
    fn xor(self, other: Option<T>) -> Option<T> {
        match (self, other) {
            (Option::Some(x), Option::None) => Option::Some(x),
            (Option::None, Option::Some(y)) => Option::Some(y),
            _ => Option::None,
        }
    }
    fn and<U>(self, other: Option<U>) -> Option<U> { match self { Option::Some(_x) => other, Option::None => Option::None } }
    fn filter(self, p: fn(T) -> bool) -> Option<T> {
        match self { Option::Some(x) => if p(x) { Option::Some(x) } else { Option::None }, Option::None => Option::None }
    }
    fn map_or<U>(self, default: U, f: fn(T) -> U) -> U { match self { Option::Some(x) => f(x), Option::None => default } }
    fn map_or_else<U>(self, default: fn() -> U, f: fn(T) -> U) -> U { match self { Option::Some(x) => f(x), Option::None => default() } }
    fn is_some_and(self, p: fn(T) -> bool) -> bool { match self { Option::Some(x) => p(x), Option::None => false } }
    fn is_none_or(self, p: fn(T) -> bool) -> bool { match self { Option::Some(x) => p(x), Option::None => true } }
    fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        match (self, other) { (Option::Some(x), Option::Some(y)) => Option::Some((x, y)), _ => Option::None }
    }
    fn inspect(self, f: fn(T)) -> Option<T> { match self { Option::Some(x) => { f(x); Option::Some(x) } Option::None => Option::None } }
    // Take the value out, leaving None.
    fn take(mut self) -> Option<T> { let v = self; self = Option::None; v }
    fn replace(mut self, v: T) -> Option<T> { let old = self; self = Option::Some(v); old }
    fn iter(self) -> OptionIter<T> { OptionIter { v: self } }
}

impl<T: Eq> Eq for Option<T> {
    fn eq(self, other: Option<T>) -> bool {
        match self {
            Option::Some(a) => match other { Option::Some(b) => a == b, Option::None => false },
            Option::None => other.is_none(),
        }
    }
}

impl<T: Eq, E: Eq> Eq for Result<T, E> {
    fn eq(self, other: Result<T, E>) -> bool {
        match self {
            Result::Ok(a) => match other { Result::Ok(b) => a == b, Result::Err(_e) => false },
            Result::Err(a) => match other { Result::Ok(_x) => false, Result::Err(b) => a == b },
        }
    }
}

impl<T, E> Result<T, E> {
    fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> { match self { Result::Ok(x) => f(x), Result::Err(e) => Result::Err(e) } }
    fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> { match self { Result::Ok(x) => Result::Ok(x), Result::Err(e) => f(e) } }
    fn and<U>(self, other: Result<U, E>) -> Result<U, E> { match self { Result::Ok(_x) => other, Result::Err(e) => Result::Err(e) } }
    fn or<F>(self, other: Result<T, F>) -> Result<T, F> { match self { Result::Ok(x) => Result::Ok(x), Result::Err(_e) => other } }
    fn unwrap_or_else(self, f: fn(E) -> T) -> T { match self { Result::Ok(x) => x, Result::Err(e) => f(e) } }
    fn map_or<U>(self, default: U, f: fn(T) -> U) -> U { match self { Result::Ok(x) => f(x), Result::Err(_e) => default } }
    fn map_or_else<U>(self, default: fn(E) -> U, f: fn(T) -> U) -> U { match self { Result::Ok(x) => f(x), Result::Err(e) => default(e) } }
    fn is_ok_and(self, p: fn(T) -> bool) -> bool { match self { Result::Ok(x) => p(x), Result::Err(_e) => false } }
    fn is_err_and(self, p: fn(E) -> bool) -> bool { match self { Result::Ok(_x) => false, Result::Err(e) => p(e) } }
    fn inspect_err(self, f: fn(E)) -> Result<T, E> { match self { Result::Ok(x) => Result::Ok(x), Result::Err(e) => { f(e); Result::Err(e) } } }
    fn as_ref(self) -> Result<T, E> { self }
    fn iter(self) -> OptionIter<T> { OptionIter { v: self.ok() } }
    fn is_ok(self) -> bool { match self { Result::Ok(_x) => true, Result::Err(_e) => false } }
    fn is_err(self) -> bool { match self { Result::Ok(_x) => false, Result::Err(_e) => true } }
    fn unwrap(self) -> T {
        match self { Result::Ok(x) => x, Result::Err(_e) => panic("called `Result::unwrap()` on an `Err` value") }
    }
    fn expect(self, message: String) -> T {
        match self { Result::Ok(x) => x, Result::Err(_e) => panic(message) }
    }
    fn unwrap_err(self) -> E {
        match self { Result::Ok(_x) => panic("called `Result::unwrap_err()` on an `Ok` value"), Result::Err(e) => e }
    }
    fn expect_err(self, message: String) -> E {
        match self { Result::Ok(_x) => panic(message), Result::Err(e) => e }
    }
    fn unwrap_or(self, default: T) -> T {
        match self { Result::Ok(x) => x, Result::Err(_e) => default }
    }
    fn ok(self) -> Option<T> {
        match self { Result::Ok(x) => Option::Some(x), Result::Err(_e) => Option::None }
    }
    fn err(self) -> Option<E> {
        match self { Result::Ok(_x) => Option::None, Result::Err(e) => Option::Some(e) }
    }
    fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self { Result::Ok(x) => Result::Ok(f(x)), Result::Err(e) => Result::Err(e) }
    }
    fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self { Result::Ok(x) => Result::Ok(x), Result::Err(e) => Result::Err(f(e)) }
    }
}

// ---- Array<T> -------------------------------------------------------------------
// The built-in fixed-length array; its operations are compiler intrinsics.
// `Array::new(n)` allocates (the element type comes from the annotation),
// `a.len()`, `a.is_empty()`, `a.get(i)` (an Option), `a[i]` (aborting out of
// bounds), and `a[i] = v`. Scalar slots start zeroed; reference and
// inline-value slots must be written before they are read.

// ---- Vec<T> — a growable, GC-managed vector --------------------------------------
// A reference struct over an `Array<T>` backing store. `push` and the other
// `mut self` methods update the Vec in place: every alias of a Vec sees its
// pushes, like a Java `ArrayList`. Use `clone` for an independent copy.
//
// Unsynchronized collection: shared mutation (including backing-array aliases)
// requires external synchronization. Concurrent collections use separate APIs.
struct Vec<T> { data: Array<T>, len: i64, cap: i64 }

// New storage of `cap` slots holding the first `len` elements of `data`.
// Growth takes the storage, not the Vec, so a Vec used only in one function
// can live in locals there.
#[cold]
#[inline(never)]
fn vec_grow<T>(data: Array<T>, len: i64, cap: i64) -> Array<T> {
    let mut grown: Array<T> = Array::new(cap);
    array_copy(data, 0, grown, 0, len);
    grown
}

impl<T> Vec<T> {
    fn new() -> Vec<T> { Vec { data: Array::new(4), len: 0, cap: 4 } }

    // A Vec that takes over `a` as its storage (`vec![a, b, c]`).
    fn from_array(a: Array<T>) -> Vec<T> {
        let n = a.len();
        if n == 0 { return Vec::new(); }
        Vec { data: a, len: n, cap: n }
    }

    fn with_capacity(cap: i64) -> Vec<T> {
        if cap < 0 { panic("Vec::with_capacity: negative capacity"); }
        let c = cap.max(1);
        Vec { data: Array::new(c), len: 0, cap: c }
    }

    #[inline]
    fn len(self) -> i64 { self.len }
    #[inline]
    fn is_empty(self) -> bool { self.len == 0 }

    // Bounds-checked access: Some(element) when 0 <= i < len, otherwise None.
    #[inline]
    fn get(self, i: i64) -> Option<T> {
        if i < 0 || i >= self.len { Option::None } else { Option::Some(self.data[i]) }
    }
    fn first(self) -> Option<T> { self.get(0) }
    fn last(self) -> Option<T> { self.get(self.len - 1) }

    #[inline]
    fn push(mut self, x: T) {
        if self.len == self.cap {
            self.cap = (self.cap * 2).max(4);
            self.data = vec_grow(self.data, self.len, self.cap);
        }
        self.data[self.len] = x;
        self.len += 1;
    }



    // Remove and return the last element, or None if the Vec is empty.
    fn pop(mut self) -> Option<T> {
        if self.len == 0 {
            Option::None
        } else {
            self.len -= 1;
            Option::Some(self.data[self.len])
        }
    }

    // Shorten to `n` elements; no effect when `n >= len`.
    fn truncate(mut self, n: i64) {
        if n < 0 { panic("Vec::truncate: negative length"); }
        if n < self.len { self.len = n; }
    }
    fn clear(mut self) { self.len = 0; }

    // Put `x` at index `i`, shifting the rest up.
    fn insert(mut self, i: i64, x: T) {
        if i < 0 || i > self.len { panic!("insertion index (is {}) should be <= len (is {})", i, self.len); }
        self.push(x);
        array_copy(self.data, i, self.data, i + 1, self.len - 1 - i);
        self.data[i] = x;
    }
    // Take out the element at `i`, shifting the rest down.
    fn remove(mut self, i: i64) -> T {
        if i < 0 || i >= self.len { panic!("removal index (is {}) should be < len (is {})", i, self.len); }
        let x = self.data[i];
        array_copy(self.data, i + 1, self.data, i, self.len - 1 - i);
        self.len = self.len - 1;
        x
    }
    // Take out the element at `i`, moving the last element into its place.
    fn swap_remove(mut self, i: i64) -> T {
        if i < 0 || i >= self.len { panic!("swap_remove index (is {}) should be < len (is {})", i, self.len); }
        let x = self.data[i];
        self.data[i] = self.data[self.len - 1];
        self.len = self.len - 1;
        x
    }

    fn swap(mut self, i: i64, j: i64) {
        let tmp = self[i];
        self[i] = self[j];
        self[j] = tmp;
    }

    // Values are shared, so the mutable view of an element is the element.
    fn last_mut(self) -> Option<T> { self.last() }
    fn first_mut(self) -> Option<T> { self.first() }
    fn get_mut(self, i: i64) -> Option<T> { self.get(i) }

    // Split off the elements from `at` on into a new Vec.
    fn split_off(mut self, at: i64) -> Vec<T> {
        if at < 0 || at > self.len { panic!("`at` split index (is {}) should be <= len (is {})", at, self.len); }
        let n = self.len - at;
        let mut out: Vec<T> = Vec::with_capacity(n);
        array_copy(self.data, at, out.data, 0, n);
        out.len = n;
        self.len = at;
        out
    }

    // Grow to `n` elements with copies of `x`, or shorten to `n`.
    fn resize(mut self, n: i64, x: T) {
        if n < self.len { self.truncate(n); }
        while self.len < n { self.push(x); }
    }
    // Grow to `n` elements made by `f`, or shorten to `n`.
    fn resize_with(mut self, n: i64, f: fn() -> T) {
        if n < self.len { self.truncate(n); }
        while self.len < n { self.push(f()); }
    }

    // Every run of `n` consecutive elements, in order.
    fn windows(self, n: i64) -> Vec<Vec<T>> {
        if n <= 0 { panic("window size must be non-zero"); }
        let mut out: Vec<Vec<T>> = Vec::new();
        let mut i = 0;
        while i + n <= self.len { out.push(self[i..i + n]); i += 1; }
        out
    }

    // Append every element of `other`.
    fn extend(mut self, other: Vec<T>) {
        let n = other.len;
        if self.len + n > self.cap {
            self.cap = (self.cap * 2).max(self.len + n);
            self.data = vec_grow(self.data, self.len, self.cap);
        }
        array_copy(other.data, 0, self.data, self.len, n);
        self.len += n;
    }

    // Reverse the elements in place.
    fn reverse(mut self) {
        let mut i = 0;
        let mut j = self.len - 1;
        while i < j {
            let tmp = self.data[i];
            self.data[i] = self.data[j];
            self.data[j] = tmp;
            i += 1;
            j -= 1;
        }
    }

    // ---- Eager iterator-style combinators. Each returns a new Vec or a
    // reduced value; the receiver is unchanged.

    fn map<U>(self, f: fn(T) -> U) -> Vec<U> {
        let mut out: Vec<U> = Vec::with_capacity(self.len);
        let mut i = 0;
        while i < self.len {
            out.push(f(self.data[i]));
            i += 1;
        }
        out
    }

    fn filter(self, pred: fn(T) -> bool) -> Vec<T> {
        let mut out: Vec<T> = Vec::new();
        let mut i = 0;
        while i < self.len {
            let x = self.data[i];
            if pred(x) { out.push(x); }
            i += 1;
        }
        out
    }

    fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A {
        let mut acc = init;
        let mut i = 0;
        while i < self.len {
            acc = f(acc, self.data[i]);
            i += 1;
        }
        acc
    }

    fn for_each(self, f: fn(T)) {
        let mut i = 0;
        while i < self.len {
            f(self.data[i]);
            i += 1;
        }
    }

    fn any(self, pred: fn(T) -> bool) -> bool {
        let mut i = 0;
        while i < self.len {
            if pred(self.data[i]) { return true; }
            i += 1;
        }
        false
    }

    fn all(self, pred: fn(T) -> bool) -> bool {
        let mut i = 0;
        while i < self.len {
            if !pred(self.data[i]) { return false; }
            i += 1;
        }
        true
    }

    // The first element satisfying `pred`.
    fn find(self, pred: fn(T) -> bool) -> Option<T> {
        let mut i = 0;
        while i < self.len {
            let x = self.data[i];
            if pred(x) { return Option::Some(x); }
            i += 1;
        }
        Option::None
    }

    // Stable in-place merge sort by `compare`.
    fn sort_by(mut self, compare: fn(T, T) -> Ordering) {
        if self.len < 2 { return; }
        let mut scratch: Array<T> = Array::new(self.len);
        let mut width = 1;
        while width < self.len {
            let mut lo = 0;
            while lo < self.len {
                let mid = (lo + width).min(self.len);
                let hi = (lo + width * 2).min(self.len);
                let mut a = lo;
                let mut b = mid;
                let mut k = lo;
                while k < hi {
                    // Take from the left run unless the right element is
                    // strictly smaller, which keeps equal elements in order.
                    if a < mid && (b >= hi || !compare(self.data[b], self.data[a]).is_lt()) {
                        scratch[k] = self.data[a];
                        a += 1;
                    } else {
                        scratch[k] = self.data[b];
                        b += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            let mut i = 0;
            while i < self.len {
                self.data[i] = scratch[i];
                i += 1;
            }
            width = width * 2;
        }
    }

    // The index of the first element satisfying `pred`.
    fn position(self, pred: fn(T) -> bool) -> Option<i64> {
        let mut i = 0;
        while i < self.len {
            if pred(self.data[i]) { return Option::Some(i); }
            i += 1;
        }
        Option::None
    }
}

// The failure of `v[i]`, kept out of line.
#[cold]
#[inline(never)]
fn vec_index_fail(i: i64, len: i64) {
    panic!("index out of bounds: the len is {} but the index is {}", len, i);
}

impl<T> Index<i64> for Vec<T> {
    type Output = T;
    #[inline]
    fn index(self, i: i64) -> T {
        if i < 0 || i >= self.len { vec_index_fail(i, self.len); }
        self.data[i]
    }
}

// `v[lo..hi]`: a new Vec holding a copy of elements [lo, hi).
impl<T> IndexRange<Vec<T>> for Vec<T> {
    fn index_range(self, lo: i64, hi: i64) -> Vec<T> {
        if lo < 0 || hi < lo || hi > self.len {
            panic!("range {}..{} is out of bounds for a Vec of length {}", lo, hi, self.len);
        }
        let mut out: Vec<T> = Vec::with_capacity(hi - lo);
        array_copy(self.data, lo, out.data, 0, hi - lo);
        out.len = hi - lo;
        out
    }
}

impl<T> IndexSet<T> for Vec<T> {
    #[inline]
    fn index_set(mut self, i: i64, value: T) {
        if i < 0 || i >= self.len { vec_index_fail(i, self.len); }
        self.data[i] = value;
    }
}

// As in Rust, each element is cloned (a `Vec<Frame>` clone is a snapshot).
impl<T: Clone> Clone for Vec<T> {
    fn clone(self) -> Vec<T> {
        let cap = self.cap.max(1);
        let mut data: Array<T> = Array::new(cap);
        let mut i = 0;
        while i < self.len {
            data[i] = self.data[i].clone();
            i += 1;
        }
        Vec { data: data, len: self.len, cap: cap }
    }
}

impl<T: Eq> Eq for Vec<T> {
    fn eq(self, other: Vec<T>) -> bool {
        if self.len != other.len { return false; }
        let mut i = 0;
        while i < self.len {
            if !(self.data[i] == other.data[i]) { return false; }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Vec<T> {
    fn contains(self, x: T) -> bool {
        let mut i = 0;
        while i < self.len {
            if self.data[i] == x { return true; }
            i += 1;
        }
        false
    }
    fn starts_with(self, prefix: Vec<T>) -> bool {
        if prefix.len > self.len { return false; }
        let mut i = 0;
        while i < prefix.len {
            if !(self.data[i] == prefix.data[i]) { return false; }
            i += 1;
        }
        true
    }
    fn ends_with(self, suffix: Vec<T>) -> bool {
        if suffix.len > self.len { return false; }
        let off = self.len - suffix.len;
        let mut i = 0;
        while i < suffix.len {
            if !(self.data[off + i] == suffix.data[i]) { return false; }
            i += 1;
        }
        true
    }
    // Remove consecutive repeated elements.
    fn dedup(mut self) {
        if self.len < 2 { return; }
        let mut w = 1;
        let mut r = 1;
        while r < self.len {
            if !(self.data[r] == self.data[w - 1]) { self.data[w] = self.data[r]; w += 1; }
            r += 1;
        }
        self.len = w;
    }
}

impl<T: Ord> Vec<T> {
    // Stable in-place sort, ascending by `Ord`.
    fn sort(mut self) { self.sort_by(|a: T, b: T| a.cmp(b)); }

    fn max(self) -> Option<T> {
        if self.len == 0 { return Option::None; }
        let mut best = self.data[0];
        let mut i = 1;
        while i < self.len {
            let x = self.data[i];
            if x > best { best = x; }
            i += 1;
        }
        Option::Some(best)
    }

    fn min(self) -> Option<T> {
        if self.len == 0 { return Option::None; }
        let mut best = self.data[0];
        let mut i = 1;
        while i < self.len {
            let x = self.data[i];
            if x < best { best = x; }
            i += 1;
        }
        Option::Some(best)
    }
}

impl Vec<i64> {
    fn sum(self) -> i64 {
        let mut acc = 0;
        let mut i = 0;
        while i < self.len {
            acc += self.data[i];
            i += 1;
        }
        acc
    }
}

impl Vec<String> {
    // The elements concatenated with `sep` between them.
    fn join(self, sep: String) -> String { str_join_array(self.data, self.len, sep) }
}

// ---- String ------------------------------------------------------------------------
// `String` is a built-in immutable UTF-8 byte string. `len`, `byte_at`, and
// `substring` work in bytes; `chars` decodes Unicode code points.

impl Eq for String { fn eq(self, other: String) -> bool { str_eq(self, other) } }

// Lexicographic UTF-8 byte order.
impl Ord for String {
    fn cmp(self, other: String) -> Ordering {
        let n = str_len(self);
        let m = str_len(other);
        let count = n.min(m);
        let mut i = 0;
        while i < count {
            let a = str_get(self, i);
            let b = str_get(other, i);
            if a < b { return Ordering::Less; }
            if a > b { return Ordering::Greater; }
            i += 1;
        }
        n.cmp(m)
    }
}

impl Hash for String { fn hash(self) -> i64 { str_hash(self) } }
impl ToString for String { fn to_string(self) -> String { self } }
impl Add for String { fn add(self, other: String) -> String { str_concat(self, other) } }

// `s[lo..hi]`: a new string holding bytes [lo, hi).
impl IndexRange<String> for String {
    fn index_range(self, lo: i64, hi: i64) -> String {
        if lo < 0 || hi < lo || hi > str_len(self) {
            panic!("byte range {}..{} is out of bounds of a string of length {}", lo, hi, str_len(self));
        }
        str_substring(self, lo, hi)
    }
}

// What `find`, `split`, `starts_with`, ... search for: a string or a char.
trait Pattern { fn into_needle(self) -> String; }
impl Pattern for String { fn into_needle(self) -> String { self } }
impl Pattern for char { fn into_needle(self) -> String { char_to_str(self as i64) } }

impl String {
    fn new() -> String { "" }
    // Strings are immutable, so capacity is only a hint.
    fn with_capacity(_n: i64) -> String { "" }
    fn len(self) -> i64 { str_len(self) }
    // The lines of the text, without their `\n` (or `\r\n`) endings.
    fn lines(self) -> VecIter<String> {
        let mut out: Vec<String> = Vec::new();
        let n = str_len(self);
        let mut start = 0;
        let mut i = 0;
        while i < n {
            if str_get(self, i) == 10 {
                let end = if i > start && str_get(self, i - 1) == 13 { i - 1 } else { i };
                out.push(str_substring(self, start, end));
                start = i + 1;
            }
            i += 1;
        }
        if start < n {
            let end = if str_get(self, n - 1) == 13 { n - 1 } else { n };
            out.push(str_substring(self, start, end));
        }
        out.into_iter()
    }
    fn is_empty(self) -> bool { str_len(self) == 0 }

    // The byte at index `i`; aborts when `i` is out of bounds.
    fn byte_at(self, i: i64) -> i64 {
        // The intrinsic yields -1 exactly when `i` is out of range (a byte is
        // 0..=255), so one runtime call both reads and bounds-checks.
        let b = str_get(self, i);
        if b < 0 {
            panic!("byte index {} is out of bounds of a string of length {}", i, str_len(self));
        }
        b
    }

    // Does `needle` occur at byte offset `at`?
    fn starts_with_at(self, needle: String, at: i64) -> bool {
        let n = str_len(needle);
        if at < 0 || at + n > str_len(self) { return false; }
        let mut j = 0;
        while j < n {
            if str_get(self, at + j) != str_get(needle, j) { return false; }
            j += 1;
        }
        true
    }
    fn starts_with<P: Pattern>(self, prefix: P) -> bool { self.starts_with_at(prefix.into_needle(), 0) }
    fn ends_with<P: Pattern>(self, suffix: P) -> bool {
        let suffix = suffix.into_needle();
        self.starts_with_at(suffix, str_len(self) - str_len(suffix))
    }
    fn strip_prefix<P: Pattern>(self, prefix: P) -> Option<String> {
        let prefix = prefix.into_needle();
        if self.starts_with_at(prefix, 0) { Option::Some(str_substring(self, str_len(prefix), str_len(self))) } else { Option::None }
    }
    fn strip_suffix<P: Pattern>(self, suffix: P) -> Option<String> {
        let suffix = suffix.into_needle();
        let at = str_len(self) - str_len(suffix);
        if self.starts_with_at(suffix, at) { Option::Some(str_substring(self, 0, at)) } else { Option::None }
    }
    // Remove every leading (trailing) repetition of `p`.
    fn trim_start_matches<P: Pattern>(self, p: P) -> String {
        let needle = p.into_needle();
        let n = str_len(needle);
        if n == 0 { return self; }
        let mut at = 0;
        while self.starts_with_at(needle, at) { at += n; }
        str_substring(self, at, str_len(self))
    }
    fn trim_end_matches<P: Pattern>(self, p: P) -> String {
        let needle = p.into_needle();
        let n = str_len(needle);
        if n == 0 { return self; }
        let mut end = str_len(self);
        while end >= n && self.starts_with_at(needle, end - n) { end -= n; }
        str_substring(self, 0, end)
    }
    fn trim_matches<P: Pattern>(self, p: P) -> String {
        let needle = p.into_needle();
        self.trim_start_matches(needle).trim_end_matches(needle)
    }

    // The byte offset of the first occurrence of `needle` that starts within
    // [from, end) and ends by `end`. Bounds are clamped to the string; an
    // empty needle matches at the clamped `from` unless the range is reversed.
    fn find_between(self, needle: String, from: i64, end: i64) -> Option<i64> {
        // Hot path (line scanning in the apps): one inline byte loop, no
        // per-candidate calls or allocations.
        let n = str_len(needle);
        let len = str_len(self);
        let stop = if end < 0 { 0 } else if end > len { len } else { end };
        let mut i = if from < 0 { 0 } else { from };
        if i > stop { return Option::None; }
        if n == 1 {
            // A one-byte needle (`"\n"`, `","`) needs one read per position.
            let b = str_get(needle, 0);
            while i < stop {
                if str_get(self, i) == b { return Option::Some(i); }
                i += 1;
            }
            return Option::None;
        }
        while n <= stop - i {
            let mut j = 0;
            while j < n && str_get(self, i + j) == str_get(needle, j) { j += 1; }
            if j == n { return Option::Some(i); }
            i += 1;
        }
        Option::None
    }
    fn find_from(self, needle: String, from: i64) -> Option<i64> { self.find_between(needle, from, str_len(self)) }
    fn find<P: Pattern>(self, needle: P) -> Option<i64> { self.find_between(needle.into_needle(), 0, str_len(self)) }
    fn contains<P: Pattern>(self, needle: P) -> bool { self.find(needle).is_some() }
    // The byte offset of the last occurrence of `needle`.
    fn rfind<P: Pattern>(self, needle: P) -> Option<i64> {
        let needle = needle.into_needle();
        let mut i = str_len(self) - str_len(needle);
        while i >= 0 {
            if self.starts_with_at(needle, i) { return Option::Some(i); }
            i -= 1;
        }
        Option::None
    }
    // Split at the first (last) occurrence of `sep`.
    fn split_once<P: Pattern>(self, sep: P) -> Option<(String, String)> {
        let sep = sep.into_needle();
        match self.find(sep) {
            Option::Some(i) => Option::Some((str_substring(self, 0, i), str_substring(self, i + str_len(sep), str_len(self)))),
            Option::None => Option::None,
        }
    }
    fn rsplit_once<P: Pattern>(self, sep: P) -> Option<(String, String)> {
        let sep = sep.into_needle();
        match self.rfind(sep) {
            Option::Some(i) => Option::Some((str_substring(self, 0, i), str_substring(self, i + str_len(sep), str_len(self)))),
            Option::None => Option::None,
        }
    }

    // Strip leading and trailing ASCII whitespace.
    fn trim(self) -> String {
        let n = str_len(self);
        let mut lo = 0;
        while lo < n && str_get(self, lo).is_ascii_whitespace() { lo += 1; }
        let mut hi = n;
        while hi > lo && str_get(self, hi - 1).is_ascii_whitespace() { hi -= 1; }
        str_substring(self, lo, hi)
    }

    // Split on every non-overlapping occurrence of `sep`. Adjacent separators
    // give empty pieces; the result always has at least one piece. An empty
    // `sep` aborts.
    // The pieces between occurrences of `sep`, last first.
    fn rsplit<P: Pattern>(self, sep: P) -> VecIter<String> {
        let mut parts = self.split(sep);
        parts.reverse();
        parts.into_iter()
    }
    fn split<P: Pattern>(self, sep: P) -> Vec<String> {
        let sep = sep.into_needle();
        let sl = str_len(sep);
        if sl == 0 { panic("String::split: empty separator"); }
        let mut parts: Vec<String> = Vec::new();
        let n = str_len(self);
        let mut start = 0;
        let mut i = 0;
        while i + sl <= n {
            let mut j = 0;
            while j < sl && str_get(self, i + j) == str_get(sep, j) { j += 1; }
            if j == sl {
                parts.push(str_substring(self, start, i));
                i += sl;
                start = i;
            } else {
                i += 1;
            }
        }
        parts.push(str_substring(self, start, n));
        parts
    }

    // Replace every non-overlapping occurrence of `from` with `to`. An empty
    // `from` aborts.
    fn replace<P: Pattern>(self, from: P, to: String) -> String {
        let from = from.into_needle();
        let fl = str_len(from);
        if fl == 0 { panic("String::replace: empty pattern"); }
        let mut parts: Vec<String> = Vec::new();
        let n = str_len(self);
        let mut start = 0;
        let mut i = 0;
        while i + fl <= n {
            let mut j = 0;
            while j < fl && str_get(self, i + j) == str_get(from, j) { j += 1; }
            if j == fl {
                parts.push(str_substring(self, start, i));
                parts.push(to);
                i += fl;
                start = i;
            } else {
                i += 1;
            }
        }
        parts.push(str_substring(self, start, n));
        parts.join("")
    }

    fn repeat(self, n: i64) -> String {
        if n < 0 { panic("String::repeat: negative count"); }
        let mut parts: Vec<String> = Vec::with_capacity(n);
        let mut i = 0;
        while i < n { parts.push(self); i += 1; }
        parts.join("")
    }

    // Left-pad with copies of `pad` until the string is at least `width`
    // bytes long (whole copies, so use a one-byte `pad` for an exact width).
    fn pad_left(self, width: i64, pad: String) -> String {
        if str_len(pad) == 0 { panic("String::pad_left: empty pad"); }
        let mut out = self;
        while str_len(out) < width { out = pad + out; }
        out
    }
    fn pad_right(self, width: i64, pad: String) -> String {
        if str_len(pad) == 0 { panic("String::pad_right: empty pad"); }
        let mut out = self;
        while str_len(out) < width { out += pad; }
        out
    }

    // ASCII-only case mapping; other characters are unchanged.
    fn to_uppercase(self) -> String {
        let mut cs = self.char_vec();
        let mut i = 0;
        while i < cs.len() {
            let c = cs[i];
            if c >= 'a' && c <= 'z' { cs[i] = ((c as i64) - 32) as char; }
            i += 1;
        }
        String::from_chars(cs)
    }
    fn to_lowercase(self) -> String {
        let mut cs = self.char_vec();
        let mut i = 0;
        while i < cs.len() {
            let c = cs[i];
            if c >= 'A' && c <= 'Z' { cs[i] = ((c as i64) + 32) as char; }
            i += 1;
        }
        String::from_chars(cs)
    }

    // The chars, front to back, decoded as they are taken (as in Rust).
    fn chars(self) -> Chars { Chars { s: self, i: 0, end: str_len(self) } }

    // Decode the UTF-8 bytes into Unicode code points. Assumes well-formed
    // UTF-8 (true of literals, concatenations, and checked file reads).
    fn char_vec(self) -> Vec<char> {
        let n = str_len(self);
        let mut out: Vec<char> = Vec::new();
        let mut i = 0;
        while i < n {
            let b0 = str_get(self, i);
            if b0 < 128 {
                out.push(b0 as char);
                i += 1;
            } else if b0 < 224 {
                let b1 = str_get(self, i + 1);
                out.push((((b0 & 31) << 6) | (b1 & 63)) as char);
                i += 2;
            } else if b0 < 240 {
                let b1 = str_get(self, i + 1);
                let b2 = str_get(self, i + 2);
                out.push((((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)) as char);
                i += 3;
            } else {
                let b1 = str_get(self, i + 1);
                let b2 = str_get(self, i + 2);
                let b3 = str_get(self, i + 3);
                out.push((((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)) as char);
                i += 4;
            }
        }
        out
    }

    // Encode code points as a UTF-8 string (the inverse of `chars`).
    fn from_chars(cs: Vec<char>) -> String {
        let mut parts: Vec<String> = Vec::with_capacity(cs.len());
        let mut i = 0;
        while i < cs.len() {
            parts.push(char_to_str(cs[i] as i64));
            i += 1;
        }
        parts.join("")
    }

    // Parse a base-10 i64 with an optional leading `-` or `+`. Empty,
    // malformed, and out-of-range strings give None. Accumulates negatively so
    // the asymmetric i64 minimum stays representable.
    fn parse_i64(self) -> Option<i64> {
        let n = str_len(self);
        if n == 0 { return Option::None; }
        let first = str_get(self, 0);
        let neg = first == 45;
        let mut i = if neg || first == 43 { 1 } else { 0 };
        if i == n { return Option::None; }
        let limit = if neg { i64::min_value() } else { 0 - i64::max_value() };
        let mut acc = 0;
        while i < n {
            let c = str_get(self, i);
            if c < 48 || c > 57 { return Option::None; }
            let digit = c - 48;
            if acc < limit / 10 { return Option::None; }
            acc = acc * 10;
            if acc < limit + digit { return Option::None; }
            acc -= digit;
            i += 1;
        }
        Option::Some(if neg { acc } else { 0 - acc })
    }

    // Parse a decimal float: optional sign, digits with an optional `.`
    // fraction (at least one digit overall), and an optional exponent; or
    // `inf`, `infinity`, `nan` in any case. Anything else gives None.
    fn parse_f64(self) -> Option<f64> {
        let n = str_len(self);
        let mut i = 0;
        if n > 0 && (str_get(self, 0) == 43 || str_get(self, 0) == 45) { i = 1; }
        let word = str_substring(self, i, n).to_lowercase();
        if word == "inf" || word == "infinity" || word == "nan" { return Option::Some(str_to_float(self)); }
        let mut digits = 0;
        while i < n && str_get(self, i).is_ascii_digit() { i += 1; digits += 1; }
        if i < n && str_get(self, i) == 46 {
            i += 1;
            while i < n && str_get(self, i).is_ascii_digit() { i += 1; digits += 1; }
        }
        if digits == 0 { return Option::None; }
        if i < n && (str_get(self, i) == 101 || str_get(self, i) == 69) {
            i += 1;
            if i < n && (str_get(self, i) == 43 || str_get(self, i) == 45) { i += 1; }
            let mut exp_digits = 0;
            while i < n && str_get(self, i).is_ascii_digit() { i += 1; exp_digits += 1; }
            if exp_digits == 0 { return Option::None; }
        }
        if i != n { return Option::None; }
        Option::Some(str_to_float(self))
    }
}

// Print `s` followed by a newline.
fn println(s: String) -> i64 { print_str(s) }

// ---- HashMap<K, V> -------------------------------------------------------------
// Open addressing with linear probing over parallel `keys`/`vals`/`used`
// arrays. Grows (rehashes into a 2x table) past a 0.7 load factor, so a probe
// always finds an empty slot. No removal yet. Keys need `Eq + Hash`.
//
// Unsynchronized map: callers synchronize shared mutation and backing aliases.
struct HashMap<K, V> { keys: Array<K>, vals: Array<V>, used: Array<bool>, len: i64, cap: i64 }

impl<K: Eq + Hash, V> HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        let cap = 8;
        HashMap { keys: Array::new(cap), vals: Array::new(cap), used: Array::new(cap), len: 0, cap: cap }
    }

    fn len(self) -> i64 { self.len }
    fn is_empty(self) -> bool { self.len == 0 }

    // The slot holding `key`, or the empty slot where it would go.
    fn probe(self, key: K) -> i64 {
        let mask = self.cap - 1;
        let mut i = key.hash() & mask;
        loop {
            if !self.used[i] || self.keys[i] == key { return i; }
            i = (i + 1) & mask;
        }
    }

    // Insert or replace; returns the previous value for `key`, if any.
    fn insert(mut self, key: K, val: V) -> Option<V> {
        if (self.len + 1) * 10 >= self.cap * 7 { self.grow(); }
        let slot = self.probe(key);
        if self.used[slot] {
            let old = self.vals[slot];
            self.vals[slot] = val;
            Option::Some(old)
        } else {
            self.keys[slot] = key;
            self.vals[slot] = val;
            self.used[slot] = true;
            self.len += 1;
            Option::None
        }
    }

    // Double the table and re-insert every entry.
    fn grow(mut self) {
        let old_keys = self.keys;
        let old_vals = self.vals;
        let old_used = self.used;
        let old_cap = self.cap;
        self.cap = old_cap * 2;
        self.keys = Array::new(self.cap);
        self.vals = Array::new(self.cap);
        self.used = Array::new(self.cap);
        let mut i = 0;
        while i < old_cap {
            if old_used[i] {
                let slot = self.probe(old_keys[i]);
                self.keys[slot] = old_keys[i];
                self.vals[slot] = old_vals[i];
                self.used[slot] = true;
            }
            i += 1;
        }
    }

    fn get(self, key: K) -> Option<V> {
        let slot = self.probe(key);
        if self.used[slot] { Option::Some(self.vals[slot]) } else { Option::None }
    }

    fn contains_key(self, key: K) -> bool { self.used[self.probe(key)] }

    // Keys and values in table order (the same order for both).
    fn keys(self) -> Vec<K> {
        let mut out: Vec<K> = Vec::with_capacity(self.len);
        let mut i = 0;
        while i < self.cap {
            if self.used[i] { out.push(self.keys[i]); }
            i += 1;
        }
        out
    }
    fn values(self) -> Vec<V> {
        let mut out: Vec<V> = Vec::with_capacity(self.len);
        let mut i = 0;
        while i < self.cap {
            if self.used[i] { out.push(self.vals[i]); }
            i += 1;
        }
        out
    }
}

impl<K, V> Clone for HashMap<K, V> {
    fn clone(self) -> HashMap<K, V> {
        let mut keys: Array<K> = Array::new(self.cap);
        let mut vals: Array<V> = Array::new(self.cap);
        let mut used: Array<bool> = Array::new(self.cap);
        let mut i = 0;
        while i < self.cap {
            if self.used[i] {
                keys[i] = self.keys[i];
                vals[i] = self.vals[i];
                used[i] = true;
            }
            i += 1;
        }
        HashMap { keys: keys, vals: vals, used: used, len: self.len, cap: self.cap }
    }
}

impl<K: Eq + Hash, V> HashMap<K, V> {
    // Remove `key`; returns its value, if it was present. Later entries of
    // the probe run move back, so every lookup still ends at an empty slot.
    fn remove(mut self, key: K) -> Option<V> {
        let mut hole = self.probe(key);
        if !self.used[hole] { return Option::None; }
        let old = self.vals[hole];
        self.used[hole] = false;
        self.len -= 1;
        let mask = self.cap - 1;
        let mut j = hole;
        loop {
            j = (j + 1) & mask;
            if !self.used[j] { break; }
            let home = self.keys[j].hash() & mask;
            // An entry stays unless the hole lies between its home and it.
            let stays = if hole <= j { home > hole && home <= j } else { home > hole || home <= j };
            if !stays {
                self.keys[hole] = self.keys[j];
                self.vals[hole] = self.vals[j];
                self.used[hole] = true;
                self.used[j] = false;
                hole = j;
            }
        }
        Option::Some(old)
    }
    fn clear(mut self) {
        let fresh: HashMap<K, V> = HashMap::new();
        self.keys = fresh.keys; self.vals = fresh.vals; self.used = fresh.used;
        self.len = 0; self.cap = fresh.cap;
    }
}

// ---- HashSet<T> ------------------------------------------------------------
// A `HashMap<T, ()>`: membership only. Iteration order is unspecified.
struct HashSet<T> { map: HashMap<T, ()> }

impl<T: Eq + Hash> HashSet<T> {
    fn new() -> HashSet<T> { HashSet { map: HashMap::new() } }
    fn with_capacity(_n: i64) -> HashSet<T> { HashSet::new() }
    fn len(self) -> i64 { self.map.len() }
    fn is_empty(self) -> bool { self.map.is_empty() }
    // Add `x`; true when it was not already present.
    fn insert(mut self, x: T) -> bool { self.map.insert(x, ()).is_none() }
    fn contains(self, x: T) -> bool { self.map.contains_key(x) }
    fn remove(mut self, x: T) -> bool { self.map.remove(x).is_some() }
    fn clear(mut self) { self.map.clear(); }
    fn iter(self) -> VecIter<T> { self.map.keys().into_iter() }
    fn extend<I: IntoIterator<Item = T>>(mut self, items: I) {
        let mut it = items.into_iter();
        while let Option::Some(x) = it.next() { self.map.insert(x, ()); }
    }
    fn is_subset(self, other: HashSet<T>) -> bool {
        let mut it = self.iter();
        while let Option::Some(x) = it.next() { if !other.contains(x) { return false; } }
        true
    }
}
impl<T> Clone for HashSet<T> {
    fn clone(self) -> HashSet<T> { HashSet { map: self.map.clone() } }
}
impl<T: Eq + Hash> Default for HashSet<T> { fn default() -> HashSet<T> { HashSet::new() } }
impl<T: Eq + Hash> Eq for HashSet<T> {
    fn eq(self, other: HashSet<T>) -> bool { self.len() == other.len() && self.is_subset(other) }
}
impl<T: Eq + Hash> FromIterator<T> for HashSet<T> {
    fn from_iter<I: Iterator<Item = T>>(iter: I) -> HashSet<T> {
        let mut set: HashSet<T> = HashSet::new();
        set.extend(iter);
        set
    }
}
impl<T: Eq + Hash> IntoIterator for HashSet<T> {
    type Item = T;
    type IntoIter = VecIter<T>;
    fn into_iter(self) -> VecIter<T> { self.iter() }
}

// ---- BTreeMap<K, V> ----------------------------------------------------------
// An ordered map: keys kept sorted (by `Ord`) in parallel vectors, found by
// binary search. Iteration is in key order, like Rust's.
struct BTreeMap<K, V> { keys: Vec<K>, vals: Vec<V> }

impl<K: Ord, V> BTreeMap<K, V> {
    fn new() -> BTreeMap<K, V> { BTreeMap { keys: Vec::new(), vals: Vec::new() } }
    fn len(self) -> i64 { self.keys.len() }
    fn is_empty(self) -> bool { self.keys.is_empty() }
    // `Ok(i)` when keys[i] == key, else `Err(i)` where it would go.
    fn search(self, key: K) -> Result<i64, i64> {
        let mut lo = 0;
        let mut hi = self.keys.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            match self.keys[mid].cmp(key) {
                Ordering::Less => { lo = mid + 1; }
                Ordering::Greater => { hi = mid; }
                Ordering::Equal => { return Result::Ok(mid); }
            }
        }
        Result::Err(lo)
    }
    fn insert(mut self, key: K, val: V) -> Option<V> {
        match self.search(key) {
            Result::Ok(i) => { let old = self.vals[i]; self.vals[i] = val; Option::Some(old) }
            Result::Err(i) => { self.keys.insert(i, key); self.vals.insert(i, val); Option::None }
        }
    }
    fn get(self, key: K) -> Option<V> {
        match self.search(key) { Result::Ok(i) => Option::Some(self.vals[i]), Result::Err(_) => Option::None }
    }
    fn contains_key(self, key: K) -> bool { self.search(key).is_ok() }
    fn remove(mut self, key: K) -> Option<V> {
        match self.search(key) {
            Result::Ok(i) => { self.keys.remove(i); Option::Some(self.vals.remove(i)) }
            Result::Err(_) => Option::None,
        }
    }
    fn clear(mut self) { self.keys.clear(); self.vals.clear(); }
    fn keys(self) -> VecIter<K> { self.keys.clone().into_iter() }
    fn values(self) -> VecIter<V> { self.vals.clone().into_iter() }
    fn iter(self) -> VecIter<(K, V)> {
        let mut pairs: Vec<(K, V)> = Vec::with_capacity(self.keys.len());
        let mut i = 0;
        while i < self.keys.len() { pairs.push((self.keys[i], self.vals[i])); i += 1; }
        pairs.into_iter()
    }
    fn first_key_value(self) -> Option<(K, V)> {
        if self.keys.is_empty() { Option::None } else { Option::Some((self.keys[0], self.vals[0])) }
    }
    fn last_key_value(self) -> Option<(K, V)> {
        let n = self.keys.len();
        if n == 0 { Option::None } else { Option::Some((self.keys[n - 1], self.vals[n - 1])) }
    }
    fn extend<I: IntoIterator<Item = (K, V)>>(mut self, items: I) {
        let mut it = items.into_iter();
        while let Option::Some(kv) = it.next() { self.insert(kv.0, kv.1); }
    }
}
impl<K, V> Clone for BTreeMap<K, V> {
    fn clone(self) -> BTreeMap<K, V> { BTreeMap { keys: self.keys.clone(), vals: self.vals.clone() } }
}
impl<K: Ord, V> Default for BTreeMap<K, V> { fn default() -> BTreeMap<K, V> { BTreeMap::new() } }
impl<K: Ord + Eq, V: Eq> Eq for BTreeMap<K, V> {
    fn eq(self, other: BTreeMap<K, V>) -> bool { self.keys == other.keys && self.vals == other.vals }
}
impl<K: Ord, V> FromIterator<(K, V)> for BTreeMap<K, V> {
    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> BTreeMap<K, V> {
        let mut m: BTreeMap<K, V> = BTreeMap::new();
        m.extend(iter);
        m
    }
}
impl<K: Ord, V> IntoIterator for BTreeMap<K, V> {
    type Item = (K, V);
    type IntoIter = VecIter<(K, V)>;
    fn into_iter(self) -> VecIter<(K, V)> { self.iter() }
}

// `std::mem::drop`: values are collected when unreachable, so this only
// ends the caller's use of `x`.
fn drop<T>(_x: T) {}

// ---- std::marker::PhantomData --------------------------------------------------
// A zero-sized marker for a type parameter a struct has no field of.
struct PhantomData<T>;

// ---- std::error::Error --------------------------------------------------------
// Named `StdError` here (`std::error::Error` and `use std::error::Error` name
// it), so a program's own `Error` type keeps its name.
trait StdError: Debug + Display {}

// ---- std::any ----------------------------------------------------------------
// Every type is `Any`. A `dyn Any` remembers its value's type, and
// `downcast_ref::<T>()` gives the value back when it is a `T`. Types are
// identified by name (`type_name::<T>()`).
struct TypeId { name: String }
impl TypeId {
    fn of<T>() -> TypeId { TypeId { name: any_type_name::<T>() } }
}
impl Eq for TypeId { fn eq(self, other: TypeId) -> bool { self.name == other.name } }
impl Hash for TypeId { fn hash(self) -> i64 { self.name.hash() } }
impl Clone for TypeId { fn clone(self) -> TypeId { self } }
impl Debug for TypeId {
    fn fmt(self, f: Formatter) -> FmtResult { f.write_str("TypeId(" + self.name + ")") }
}

fn type_name<T>() -> String { any_type_name::<T>() }

// A `dyn Any`'s value, boxed so that it is one heap object whatever `T` is.
struct AnyBox<T> { value: T }

trait Any {
    fn type_id(self) -> TypeId;
    fn any_box(self) -> AnyBox<()>;
}
impl<T> Any for T {
    fn type_id(self) -> TypeId { TypeId::of::<T>() }
    fn any_box(self) -> AnyBox<()> { unsafe { ref_cast::<AnyBox<()>>(AnyBox { value: self }) } }
}
impl dyn Any {
    fn is<T>(self) -> bool { self.type_id() == TypeId::of::<T>() }
    fn downcast_ref<T>(self) -> Option<T> {
        if self.is::<T>() {
            let b = unsafe { ref_cast::<AnyBox<T>>(self.any_box()) };
            Option::Some(b.value)
        } else {
            Option::None
        }
    }
    // Values are shared, so the mutable view is the same value.
    fn downcast_mut<T>(self) -> Option<T> { self.downcast_ref::<T>() }
}

// ---- Thread<T> — OS-thread concurrency (see docs/threads.md) ---------------
// `Thread::spawn(f)` runs the no-arg closure `f` on a new OS thread sharing this
// heap; the GC stops the world across all threads when it collects. `t.join()`
// blocks and returns `f`'s result — of ANY type `T` (scalar or heap value).
//
// The result travels via the handle's `result` field (the Future model, à la
// Java's `FutureTask.outcome`): the child stores `f()` into a plain heap cell on
// finish, and because the parent holds the (GC-rooted) handle, the result is
// traced + relocated for free until joined. Cross-thread safe publication comes
// from `thread_join`: the first observer joins the OS thread; subsequent
// observers acquire the completion mutex and inherit that publication edge.
// Lambdas and named fns are interchangeable.
struct ThreadResult<T> { v: Option<T> }

// Sharing the cell between child (one write, before finishing) and parent (one
// reads, after join) is safe because `thread_join` orders them — assert Sync
// (the auto-deriver can't see the join provides the ordering).
impl<T> Sync for ThreadResult<T> {}

struct Thread<T> { handle: RawPtr, result: ThreadResult<T> }

// Completion records follow the Thread object itself after native join.
// Concurrent joins synchronize before reading it; the child writes once.
impl<T> Sync for Thread<T> {}

impl Thread {
    fn spawn<T>(f: fn() -> T) -> Thread<T> {
        let cell: ThreadResult<T> = ThreadResult { v: Option::None };
        // The child computes `f()` and stores it into the shared cell (a plain
        // field write), then returns 0 (the runtime's i64 channel is unused).
        let handle = (unsafe { thread_spawn(|| {
            let mut c = cell;
            c.v = Option::Some(f());
            0
        }) });
        // Bind to the wrapper identity: its result field can be replaced safely.
        // Metadata remains until native join and collection of every wrapper alias.
        let thread = unsafe { Thread { handle: handle, result: cell } };
        unsafe { thread_bind_owner(handle, thread); }
        thread
    }
    fn sleep(ms: i64) { let _u = thread_sleep(ms); }
    fn yield_now() { let _u = thread_yield(); }
    fn current_id() -> i64 { thread_current_id() }
}

impl<T> Thread<T> {
    fn join(self) -> T {
        let _h = (unsafe { thread_join(self.handle) });   // wait for the OS thread (happens-before)
        // The child has stored its result before finishing, so this reads `Some`.
        // The `None` arm is unreachable; the loop satisfies the return type.
        let mut r = self.result;
        loop {
            match r.v {
                Option::Some(v) => { return v; }
                Option::None => {}
            }
        }
    }
}

// ---- AtomicI64 — a lock-free shared integer (see docs/threads.md) ----------
// The cell lives off the GC heap (stable address), so concurrent CAS/fetch_add
// are safe. Native cells weakly follow the managed wrapper identity.
// Shareable across threads.
struct AtomicI64 { cell: RawPtr }

impl AtomicI64 {
    // Only this constructor supplies a live atomic cell to this representation.
    fn new(v: i64) -> AtomicI64 {
        let cell = unsafe { atomic_i64_new(v) };
        let wrapper = unsafe { AtomicI64 { cell: cell } };
        unsafe { atomic_i64_bind_owner(cell, wrapper); }
        wrapper
    }
}
impl AtomicI64 {
    fn load(self) -> i64 { (unsafe { atomic_i64_load(self.cell) }) }
    fn store(self, v: i64) -> i64 { (unsafe { atomic_i64_store(self.cell, v) }) }
    fn fetch_add(self, delta: i64) -> i64 { (unsafe { atomic_i64_fetch_add(self.cell, delta) }) }
    fn compare_and_set(self, expected: i64, new: i64) -> bool { (unsafe { atomic_i64_cas(self.cell, expected, new) }) == 1 }
}

// ---- std::sync::atomic ----------------------------------------------------------
// Rust's atomics, over `AtomicI64` cells. Every access is sequentially
// consistent, which satisfies any requested `Ordering` (`std::sync::atomic::
// Ordering` is `AtomicOrdering` here; the prelude's `Ordering` is `cmp`'s).
enum AtomicOrdering { Relaxed, Release, Acquire, AcqRel, SeqCst }

struct AtomicU64 { cell: AtomicI64 }
impl AtomicU64 {
    fn new(v: u64) -> AtomicU64 { AtomicU64 { cell: AtomicI64::new(v as i64) } }
    fn load(self, _order: AtomicOrdering) -> u64 { self.cell.load() as u64 }
    fn store(self, v: u64, _order: AtomicOrdering) { self.cell.store(v as i64); }
    fn fetch_add(self, delta: u64, _order: AtomicOrdering) -> u64 { self.cell.fetch_add(delta as i64) as u64 }
    fn fetch_sub(self, delta: u64, _order: AtomicOrdering) -> u64 { self.cell.fetch_add(0 - delta as i64) as u64 }
}

struct AtomicUsize { cell: AtomicI64 }
impl AtomicUsize {
    fn new(v: usize) -> AtomicUsize { AtomicUsize { cell: AtomicI64::new(v) } }
    fn load(self, _order: AtomicOrdering) -> usize { self.cell.load() }
    fn store(self, v: usize, _order: AtomicOrdering) { self.cell.store(v); }
    fn fetch_add(self, delta: usize, _order: AtomicOrdering) -> usize { self.cell.fetch_add(delta) }
    fn fetch_sub(self, delta: usize, _order: AtomicOrdering) -> usize { self.cell.fetch_add(0 - delta) }
}

struct AtomicBool { cell: AtomicI64 }
impl AtomicBool {
    fn new(v: bool) -> AtomicBool { AtomicBool { cell: AtomicI64::new(if v { 1 } else { 0 }) } }
    fn load(self, _order: AtomicOrdering) -> bool { self.cell.load() != 0 }
    fn store(self, v: bool, _order: AtomicOrdering) { self.cell.store(if v { 1 } else { 0 }); }
    fn swap(self, v: bool, _order: AtomicOrdering) -> bool {
        let new = if v { 1 } else { 0 };
        loop {
            let old = self.cell.load();
            if self.cell.compare_and_set(old, new) { return old != 0; }
        }
    }
}

// ---- std::time::Duration ------------------------------------------------------
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]
struct Duration { nanos: u128 }
impl Duration {
    const ZERO: Duration = Duration { nanos: 0 };
    fn from_secs(s: u64) -> Duration { Duration { nanos: s as u128 * 1000000000 } }
    fn from_millis(ms: u64) -> Duration { Duration { nanos: ms as u128 * 1000000 } }
    fn from_micros(us: u64) -> Duration { Duration { nanos: us as u128 * 1000 } }
    fn from_nanos(ns: u64) -> Duration { Duration { nanos: ns as u128 } }
    fn from_secs_f64(s: f64) -> Duration { Duration { nanos: (s * 1000000000.0) as u128 } }
    fn as_nanos(self) -> u128 { self.nanos }
    fn as_micros(self) -> u128 { self.nanos / 1000 }
    fn as_millis(self) -> u128 { self.nanos / 1000000 }
    fn as_secs(self) -> u64 { (self.nanos / 1000000000) as u64 }
    fn as_secs_f64(self) -> f64 { self.nanos as f64 / 1000000000.0 }
    fn subsec_nanos(self) -> u32 { (self.nanos % 1000000000) as u32 }
    fn is_zero(self) -> bool { self.nanos == 0 }
}
impl Add for Duration {
    type Output = Duration;
    fn add(self, other: Duration) -> Duration { Duration { nanos: self.nanos + other.nanos } }
}
impl Sub for Duration {
    type Output = Duration;
    fn sub(self, other: Duration) -> Duration { Duration { nanos: self.nanos - other.nanos } }
}

// ---- std::time::Instant -----------------------------------------------------------
// A reading of a monotonic clock.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
struct Instant { nanos: i64 }
impl Instant {
    fn now() -> Instant { Instant { nanos: monotonic_nanos() } }
    fn elapsed(self) -> Duration { Instant::now().duration_since(self) }
    fn duration_since(self, earlier: Instant) -> Duration {
        Duration { nanos: if self.nanos > earlier.nanos { (self.nanos - earlier.nanos) as u128 } else { 0 } }
    }
    fn checked_duration_since(self, earlier: Instant) -> Option<Duration> {
        if self.nanos >= earlier.nanos { Option::Some(self.duration_since(earlier)) } else { Option::None }
    }
    fn saturating_duration_since(self, earlier: Instant) -> Duration { self.duration_since(earlier) }
}
impl Add<Duration> for Instant {
    type Output = Instant;
    fn add(self, d: Duration) -> Instant { Instant { nanos: self.nanos + d.nanos as i64 } }
}
impl Sub<Duration> for Instant {
    type Output = Instant;
    fn sub(self, d: Duration) -> Instant { Instant { nanos: self.nanos - d.nanos as i64 } }
}

// ---- std::thread ----------------------------------------------------------------
// `std::thread::JoinHandle`: a panic ends the whole program here, so
// `join` always gives `Ok`. Like Rust's, these threads do not keep the
// program running once `main` returns (they are daemons).
struct JoinHandle<T> { thread: Thread<T> }
impl<T> JoinHandle<T> {
    fn join(self) -> Result<T, dyn Any> { Result::Ok(self.thread.join()) }
    fn is_finished(self) -> bool { false }
}

// `std::thread::sleep`: block this thread for at least `d`.
fn sleep(d: Duration) { Thread::sleep(((d.nanos + 999999) / 1000000) as i64); }

// `std::thread::spawn`.
fn spawn<T>(f: fn() -> T) -> JoinHandle<T> {
    let thread = Thread::spawn(f);
    unsafe { thread_mark_daemon(thread.handle); }
    JoinHandle { thread: thread }
}

// `std::thread::Builder`: names are accepted for compatibility.
struct Builder { name: Option<String> }
impl Builder {
    fn new() -> Builder { Builder { name: Option::None } }
    fn name(self, name: String) -> Builder { Builder { name: Option::Some(name) } }
    fn stack_size(self, _size: usize) -> Builder { self }
    fn spawn<T>(self, f: fn() -> T) -> Result<JoinHandle<T>, IoError> { Result::Ok(spawn(f)) }
}

// ---- Atom<T> — a Clojure-style atom (see docs/threads.md) ------------------
// Operations support scalars and managed references; inline aggregates are rejected.
// Scalar CAS compares representation bits (including float NaNs/signed zero);
// reference CAS compares identity. Holds a single immutable value. Atomically SWAP
// which immutable value the atom points at. `swap` applies a pure function and
// retries on contention (lock-free CAS loop). Shareable across threads; reads
// always see a consistent immutable snapshot.
struct Atom<T> { value: T }

impl<T> Atom<T> {
    fn new(v: T) -> Atom<T> { Atom { value: v } }
}

impl<T> Atom<T> {
    // @atom — the current value (atomic load).
    fn deref(self) -> T { (unsafe { atom_load(self) }) }

    // compare-and-set! — install `new` iff the current value is `old`.
    fn compare_and_set(self, old: T, new: T) -> bool { (unsafe { atom_cas(self, old, new) }) }

    // swap! — apply the pure function `f` to the current value and install the
    // result, retrying the whole function if another thread swapped in between.
    fn swap(self, f: fn(T) -> T) -> T {
        loop {
            let old = (unsafe { atom_load(self) });
            let new = f(old);
            if (unsafe { atom_cas(self, old, new) }) {
                return new;
            }
        }
    }

    // reset! — set a new value unconditionally (retry the CAS until it sticks).
    fn reset(self, v: T) -> T {
        loop {
            let old = (unsafe { atom_load(self) });
            if (unsafe { atom_cas(self, old, v) }) {
                return v;
            }
        }
    }
}

// ---- Channel<T> — bounded FIFO with rooted messages and idempotent close ----
// The zero-length witness carries the generic type only. Runtime-owned slots
// retain and relocate queued message boxes, independently of witness mutation.
struct ChannelMessage<T> { value: T }
struct Channel<T> { buf: Array<ChannelMessage<T>>, ctrl: RawPtr }

impl<T> Channel<T> {
    fn new(cap: i64) -> Channel<T> {
        let b: Array<ChannelMessage<T>> = Array::new(0);
        // The control record and witness have the same message type.
        let ctrl = unsafe { chan_new(cap, b) };
        let channel = unsafe { Channel { buf: b, ctrl: ctrl } };
        unsafe { chan_bind_owner(ctrl, channel); }
        channel
    }
    fn send(self, v: T) -> Result<(), T> {
        let message = ChannelMessage { value: v };
        let status = unsafe { chan_send(self.buf, self.ctrl, message) };
        if status == 0 { Result::Ok(()) }
        else { Result::Err(v) }
    }
    fn recv(self) -> Option<T> {
        let result = unsafe { chan_recv(self.buf, self.ctrl) };
        match result {
            Option::Some(message) => Option::Some(message.value),
            Option::None => Option::None
        }
    }
    // Convenience for callers whose protocol requires another message.
    fn recv_value(self) -> T {
        match self.recv() { Option::Some(value) => value, Option::None => panic("receive on closed drained channel") }
    }
    fn close(self) -> i64 { (unsafe { chan_close(self.ctrl) }); 0 }
    fn waiting_senders(self) -> i64 { let n = unsafe { chan_waiting_senders(self.ctrl) }; n }
    fn waiting_receivers(self) -> i64 { let n = unsafe { chan_waiting_receivers(self.ctrl) }; n }
}
impl<T> Sync for Channel<T> {}

// ---- Formatting ---------------------------------------------------------------
// `format!("{}", x)` renders `x.to_string()`; a type implementing `Display`
// gets `to_string` from it. `{:?}` renders through `Debug`. Both traits write
// into a `Formatter`, as in Rust: `write!(f, "...", args)` appends to it.
// A `Formatter` is a GC object, so `f: Formatter` (no `&mut`) is enough.

struct FmtError {}
type FmtResult = Result<(), FmtError>;

struct Formatter { parts: Vec<String>, alt: bool }

impl Formatter {
    fn new() -> Formatter { Formatter { parts: Vec::new(), alt: false } }
    fn new_alternate() -> Formatter { Formatter { parts: Vec::new(), alt: true } }
    fn write_str(self, s: String) -> FmtResult {
        let mut f = self;
        f.parts.push(s);
        Result::Ok(())
    }
    fn write_char(self, c: char) -> FmtResult { self.write_str(c.to_string()) }
    // `{:#?}`: pretty-printed Debug output was requested.
    fn alternate(self) -> bool { self.alt }
    fn finish_string(self) -> String { self.parts.join("") }

    fn debug_struct(self, name: String) -> DebugStruct {
        self.write_str(name);
        DebugStruct { b: DebugInner::new(self, " { ", " }", " {\n", "}", "") }
    }
    fn debug_tuple(self, name: String) -> DebugTuple {
        self.write_str(name);
        DebugTuple { b: DebugInner::new(self, "(", ")", "(\n", ")", "") }
    }
    fn debug_list(self) -> DebugList { DebugList { b: DebugInner::new(self, "[", "]", "[\n", "]", "[]") } }
    fn debug_set(self) -> DebugSet { DebugSet { b: DebugInner::new(self, "{", "}", "{\n", "}", "{}") } }
    fn debug_map(self) -> DebugMap { DebugMap { b: DebugInner::new(self, "{", "}", "{\n", "}", "{}") } }
}

trait Display {
    fn fmt(self, f: Formatter) -> FmtResult;
    fn to_string(self) -> String {
        let f = Formatter::new();
        Display::fmt(self, f);
        f.finish_string()
    }
}

trait Debug {
    fn fmt(self, f: Formatter) -> FmtResult;
    fn to_debug_string(self) -> String {
        let f = Formatter::new();
        Debug::fmt(self, f);
        f.finish_string()
    }
    fn to_debug_string_pretty(self) -> String {
        let f = Formatter::new_alternate();
        Debug::fmt(self, f);
        f.finish_string()
    }
}

// The shared state of the `debug_*` builders: the open/close text for one-line
// and pretty (`{:#?}`) output.
struct DebugInner { f: Formatter, open: String, close: String, open_pretty: String, close_pretty: String, empty: String, has_fields: bool }

impl DebugInner {
    fn new(f: Formatter, open: String, close: String, open_pretty: String, close_pretty: String, empty: String) -> DebugInner {
        DebugInner { f, open, close, open_pretty, close_pretty, empty, has_fields: false }
    }
    fn render<T: Debug>(self, value: T) -> String {
        if self.f.alt { value.to_debug_string_pretty() } else { value.to_debug_string() }
    }
    fn entry(self, text: String) {
        let mut b = self;
        if b.f.alt {
            if !b.has_fields { b.f.write_str(b.open_pretty); }
            b.f.write_str("    " + fmt_indent(text) + ",\n");
        } else {
            b.f.write_str(if b.has_fields { ", " } else { b.open });
            b.f.write_str(text);
        }
        b.has_fields = true;
    }
    fn finish(self) -> FmtResult {
        if !self.has_fields { self.f.write_str(self.empty) }
        else if self.f.alt { self.f.write_str(self.close_pretty) }
        else { self.f.write_str(self.close) }
    }
}

struct DebugStruct { b: DebugInner }
impl DebugStruct {
    fn field<T: Debug>(self, name: String, value: T) -> DebugStruct {
        self.b.entry(name + ": " + self.b.render(value));
        self
    }
    fn finish(self) -> FmtResult { self.b.finish() }
    fn finish_non_exhaustive(self) -> FmtResult {
        self.b.entry("..");
        self.b.finish()
    }
}

struct DebugTuple { b: DebugInner }
impl DebugTuple {
    fn field<T: Debug>(self, value: T) -> DebugTuple {
        self.b.entry(self.b.render(value));
        self
    }
    fn finish(self) -> FmtResult { self.b.finish() }
}

struct DebugList { b: DebugInner }
impl DebugList {
    fn entry<T: Debug>(self, value: T) -> DebugList {
        self.b.entry(self.b.render(value));
        self
    }
    fn entries<T: Debug>(self, values: Vec<T>) -> DebugList {
        for v in values { self.b.entry(self.b.render(v)); }
        self
    }
    fn finish(self) -> FmtResult { self.b.finish() }
}

struct DebugSet { b: DebugInner }
impl DebugSet {
    fn entry<T: Debug>(self, value: T) -> DebugSet {
        self.b.entry(self.b.render(value));
        self
    }
    fn entries<T: Debug>(self, values: Vec<T>) -> DebugSet {
        for v in values { self.b.entry(self.b.render(v)); }
        self
    }
    fn finish(self) -> FmtResult { self.b.finish() }
}

struct DebugMap { b: DebugInner }
impl DebugMap {
    fn entry<K: Debug, V: Debug>(self, key: K, value: V) -> DebugMap {
        self.b.entry(self.b.render(key) + ": " + self.b.render(value));
        self
    }
    fn finish(self) -> FmtResult { self.b.finish() }
}

// Indent every line after the first (nested pretty output).
fn fmt_indent(s: String) -> String { s.replace("\n", "\n    ") }

// The number of chars (not bytes) in `s`.
fn fmt_char_len(s: String) -> i64 {
    let mut n = 0;
    let mut i = 0;
    let len = str_len(s);
    while i < len {
        if (str_get(s, i) & 192) != 128 { n += 1; }
        i += 1;
    }
    n
}

// Apply a format spec's sign, `#` prefix, zero padding, fill, and alignment.
// `align` is 0 (the default: right for numbers, left otherwise), 1 `<`,
// 2 `>`, or 3 `^`.
fn fmt_pad(body: String, prefix: String, fill: String, align: i64, width: i64, numeric: bool, plus: bool, zero: bool) -> String {
    let mut sign = "";
    let mut digits = body;
    if numeric && digits.starts_with("-") {
        sign = "-";
        digits = digits[1..];
    } else if numeric && plus {
        sign = "+";
    }
    let head = sign + prefix;
    let len = fmt_char_len(head) + fmt_char_len(digits);
    if len >= width { return head + digits; }
    let pad = width - len;
    if zero && numeric { return head + "0".repeat(pad) + digits; }
    let s = head + digits;
    let a = if align == 0 { if numeric { 2 } else { 1 } } else { align };
    if a == 1 { s + fill.repeat(pad) }
    else if a == 2 { fill.repeat(pad) + s }
    else { fill.repeat(pad / 2) + s + fill.repeat(pad - pad / 2) }
}

// `v` in base `radix`, as an unsigned `bits`-wide integer (so a negative
// i32 prints its two's complement, like Rust).
fn fmt_radix(v: i64, radix: i64, upper: bool, bits: i64) -> String {
    let mut u = v as u64;
    if bits < 64 { u = u & ((1u64 << (bits as u64)) - 1u64); }
    if u == 0u64 { return "0"; }
    let r = radix as u64;
    let digits = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let mut out: Vec<String> = Vec::new();
    while u > 0u64 {
        let d = (u % r) as i64;
        out.push(digits[d..d + 1]);
        u = u / r;
    }
    out.reverse();
    out.join("")
}

// `v` in base `radix` (128-bit integers; `fmt_radix` covers the rest).
fn fmt_radix128(v: u128, radix: i64, upper: bool) -> String {
    if v == 0 { return "0"; }
    let mut u = v;
    let r = radix as u128;
    let digits = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let mut out: Vec<String> = Vec::new();
    while u > 0 {
        let d = (u % r) as i64;
        out.push(digits[d..d + 1]);
        u = u / r;
    }
    out.reverse();
    out.join("")
}

fn fmt_debug_list(open: String, close: String, parts: Vec<String>, pretty: bool, single_comma: bool) -> String {
    if parts.len() == 0 { return open + close; }
    if pretty {
        let mut s = open + "\n";
        for p in parts { s = s + "    " + fmt_indent(p) + ",\n"; }
        return s + close;
    }
    let mut s = open + parts.join(", ");
    if single_comma && parts.len() == 1 { s = s + ","; }
    s + close
}

// Debug output for a tuple whose elements are already rendered.
fn fmt_debug_seq(open: String, close: String, items: Array<String>, pretty: bool, single_comma: bool) -> String {
    let mut parts: Vec<String> = Vec::new();
    for it in items { parts.push(it); }
    fmt_debug_list(open, close, parts, pretty, single_comma)
}

// Debug output for an array.
fn fmt_debug_array<A>(a: A, pretty: bool) -> String {
    let mut parts: Vec<String> = Vec::new();
    for x in a { parts.push(if pretty { x.to_debug_string_pretty() } else { x.to_debug_string() }); }
    fmt_debug_list("[", "]", parts, pretty, false)
}

// `s` with Rust's Debug escapes, without the quotes.
fn fmt_escape(s: String, quote: char) -> String {
    let mut out: Vec<String> = Vec::new();
    for c in s.chars() {
        if c == '\n' { out.push("\\n"); }
        else if c == '\t' { out.push("\\t"); }
        else if c == '\r' { out.push("\\r"); }
        else if c == '\0' { out.push("\\0"); }
        else if c == '\\' { out.push("\\\\"); }
        else if c == quote { out.push("\\" + c.to_string()); }
        else if (c as i64) < 32 || (c as i64) == 127 { out.push("\\u{" + fmt_radix(c as i64, 16, false, 64) + "}"); }
        else { out.push(c.to_string()); }
    }
    out.join("")
}

impl String {
    // The first `n` chars (`{:.N}` on a string).
    fn fmt_truncate(self, n: i64) -> String {
        let cs = self.char_vec();
        if cs.len() <= n { self } else { String::from_chars(cs[..n]) }
    }
}

impl Display for i8 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for i16 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for i32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for i64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for u8 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for u16 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for u32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for u64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for f32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for f64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Display for bool { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(self.to_string()) } }
impl Display for char { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(self.to_string()) } }
impl Display for String { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(self) } }

impl Debug for i8 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for i16 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for i32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for i64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for u8 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for u16 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for u32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for u64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(to_string(self)) } }
impl Debug for f32 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(fmt_f64(self as f64, 0 - 1, 1)) } }
impl Debug for f64 { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(fmt_f64(self, 0 - 1, 1)) } }
impl Debug for bool { fn fmt(self, f: Formatter) -> FmtResult { f.write_str(self.to_string()) } }
impl Debug for char { fn fmt(self, f: Formatter) -> FmtResult { f.write_str("'" + fmt_escape(self.to_string(), '\'') + "'") } }
impl Debug for String { fn fmt(self, f: Formatter) -> FmtResult { f.write_str("\"" + fmt_escape(self, '"') + "\"") } }
impl Debug for Ordering {
    fn fmt(self, f: Formatter) -> FmtResult {
        f.write_str(match self { Ordering::Less => "Less", Ordering::Equal => "Equal", Ordering::Greater => "Greater" })
    }
}

impl<T: Debug> Debug for Vec<T> {
    fn fmt(self, f: Formatter) -> FmtResult { f.debug_list().entries(self).finish() }
}
impl<T: Debug> Debug for Option<T> {
    fn fmt(self, f: Formatter) -> FmtResult {
        match self {
            Option::Some(v) => f.debug_tuple("Some").field(v).finish(),
            Option::None => f.write_str("None"),
        }
    }
}
impl<T: Debug, E: Debug> Debug for Result<T, E> {
    fn fmt(self, f: Formatter) -> FmtResult {
        match self {
            Result::Ok(v) => f.debug_tuple("Ok").field(v).finish(),
            Result::Err(e) => f.debug_tuple("Err").field(e).finish(),
        }
    }
}
impl<K: Eq + Hash + Debug, V: Debug> Debug for HashMap<K, V> {
    fn fmt(self, f: Formatter) -> FmtResult {
        let m = f.debug_map();
        let ks = self.keys();
        let vs = self.values();
        let mut i = 0;
        while i < ks.len() {
            m.entry(ks[i], vs[i]);
            i += 1;
        }
        m.finish()
    }
}
impl Debug for FmtError { fn fmt(self, f: Formatter) -> FmtResult { f.write_str("Error") } }

// ---- Default -------------------------------------------------------------------

trait Default { fn default() -> Self; }
impl Default for i8 { fn default() -> i8 { 0 } }
impl Default for i16 { fn default() -> i16 { 0 } }
impl Default for i32 { fn default() -> i32 { 0 } }
impl Default for i64 { fn default() -> i64 { 0 } }
impl Default for u8 { fn default() -> u8 { 0 } }
impl Default for u16 { fn default() -> u16 { 0 } }
impl Default for u32 { fn default() -> u32 { 0 } }
impl Default for u64 { fn default() -> u64 { 0 } }
impl Default for f32 { fn default() -> f32 { 0.0 } }
impl Default for f64 { fn default() -> f64 { 0.0 } }
impl Default for bool { fn default() -> bool { false } }
impl Default for char { fn default() -> char { '\0' } }
impl Default for String { fn default() -> String { "" } }
impl<T> Default for Vec<T> { fn default() -> Vec<T> { Vec::new() } }
impl<T> Default for Option<T> { fn default() -> Option<T> { Option::None } }
impl<K: Eq + Hash, V> Default for HashMap<K, V> { fn default() -> HashMap<K, V> { HashMap::new() } }

// ---- Clone for scalars and strings ----------------------------------------------
// Copying a scalar or an immutable String is cloning it.

impl Clone for i8 { fn clone(self) -> i8 { self } }
impl Clone for i16 { fn clone(self) -> i16 { self } }
impl Clone for i32 { fn clone(self) -> i32 { self } }
impl Clone for i64 { fn clone(self) -> i64 { self } }
impl Clone for u8 { fn clone(self) -> u8 { self } }
impl Clone for u16 { fn clone(self) -> u16 { self } }
impl Clone for u32 { fn clone(self) -> u32 { self } }
impl Clone for u64 { fn clone(self) -> u64 { self } }
impl Clone for f32 { fn clone(self) -> f32 { self } }
impl Clone for f64 { fn clone(self) -> f64 { self } }
impl Clone for bool { fn clone(self) -> bool { self } }
impl Clone for char { fn clone(self) -> char { self } }
impl Clone for String { fn clone(self) -> String { self } }
impl<T: Clone> Clone for Option<T> {
    fn clone(self) -> Option<T> {
        match self { Option::Some(v) => Option::Some(v.clone()), Option::None => Option::None }
    }
}
impl<T: Clone, E: Clone> Clone for Result<T, E> {
    fn clone(self) -> Result<T, E> {
        match self { Result::Ok(v) => Result::Ok(v.clone()), Result::Err(e) => Result::Err(e.clone()) }
    }
}

// The shared storage of a `let mut` variable that a closure assigns to (see
// src/capture.rs): the variable and its closures all use `cell.v`.
struct MutCell<T> { v: T }

// ---- Iterators ------------------------------------------------------------------
// Lazy, as in Rust: adapters (`map`, `filter`, `zip`, ...) build iterator
// structs and do no work until a consumer (`collect`, `sum`, `count`, a `for`
// loop, ...) calls `next`. An iterator is a GC object, so `let mut it =
// v.iter(); it.next()` advances it in place. Consumers take `self`, so they
// work on temporaries: `v.iter().map(f).count()`.

trait Iterator {
    type Item;
    fn next(mut self) -> Option<Self::Item>;

    fn map<B>(self, f: fn(Self::Item) -> B) -> Map<Self, Self::Item, B> { Map { iter: self, f: f } }
    fn filter(self, p: fn(Self::Item) -> bool) -> Filter<Self, Self::Item> { Filter { iter: self, p: p } }
    fn filter_map<B>(self, f: fn(Self::Item) -> Option<B>) -> FilterMap<Self, Self::Item, B> { FilterMap { iter: self, f: f } }
    fn enumerate(self) -> Enumerate<Self> { Enumerate { iter: self, i: 0 } }
    fn take(self, n: i64) -> Take<Self> { Take { iter: self, n: n } }
    fn skip(self, n: i64) -> Skip<Self> { Skip { iter: self, n: n } }
    fn step_by(self, step: i64) -> StepBy<Self> {
        if step <= 0 { panic("Iterator::step_by: step must be positive"); }
        StepBy { iter: self, step: step, first: true }
    }
    fn zip<J: IntoIterator>(self, other: J) -> Zip<Self, J::IntoIter> { Zip { a: self, b: other.into_iter() } }
    fn chain<J: IntoIterator<Item = Self::Item>>(self, other: J) -> Chain<Self, J::IntoIter> { Chain { a: self, b: other.into_iter(), first: true } }
    fn take_while(self, p: fn(Self::Item) -> bool) -> TakeWhile<Self, Self::Item> { TakeWhile { iter: self, p: p, done: false } }
    fn skip_while(self, p: fn(Self::Item) -> bool) -> SkipWhile<Self, Self::Item> { SkipWhile { iter: self, p: p, started: false } }
    fn flat_map<J: Iterator>(self, f: fn(Self::Item) -> J) -> FlatMap<Self, Self::Item, J> {
        FlatMap { iter: self, f: f, current: Option::None }
    }
    fn inspect(self, f: fn(Self::Item)) -> Inspect<Self, Self::Item> { Inspect { iter: self, f: f } }
    fn peekable(self) -> Peekable<Self, Self::Item> { Peekable { iter: self, peeked: Option::None } }
    // Values are already copies or shared references: these adapt nothing.
    fn cloned(self) -> Self { self }
    fn copied(self) -> Self { self }
    fn by_ref(self) -> Self { self }
    fn into_iter(self) -> Self { self }

    fn count(self) -> i64 {
        let mut it = self;
        let mut n = 0;
        while let Option::Some(_) = it.next() { n += 1; }
        n
    }
    fn last(self) -> Option<Self::Item> {
        let mut it = self;
        let mut last = Option::None;
        while let Option::Some(x) = it.next() { last = Option::Some(x); }
        last
    }
    fn nth(self, n: i64) -> Option<Self::Item> {
        let mut it = self;
        let mut i = 0;
        while let Option::Some(x) = it.next() {
            if i == n { return Option::Some(x); }
            i += 1;
        }
        Option::None
    }
    fn fold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        let mut it = self;
        let mut acc = init;
        while let Option::Some(x) = it.next() { acc = f(acc, x); }
        acc
    }
    fn reduce(self, f: fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {
        let mut it = self;
        match it.next() {
            Option::None => Option::None,
            Option::Some(first) => {
                let mut acc = first;
                while let Option::Some(x) = it.next() { acc = f(acc, x); }
                Option::Some(acc)
            }
        }
    }
    fn for_each(self, f: fn(Self::Item)) {
        let mut it = self;
        while let Option::Some(x) = it.next() { f(x); }
    }
    fn any(self, p: fn(Self::Item) -> bool) -> bool {
        let mut it = self;
        while let Option::Some(x) = it.next() { if p(x) { return true; } }
        false
    }
    fn all(self, p: fn(Self::Item) -> bool) -> bool {
        let mut it = self;
        while let Option::Some(x) = it.next() { if !p(x) { return false; } }
        true
    }
    fn find(self, p: fn(Self::Item) -> bool) -> Option<Self::Item> {
        let mut it = self;
        while let Option::Some(x) = it.next() { if p(x) { return Option::Some(x); } }
        Option::None
    }
    fn find_map<B>(self, f: fn(Self::Item) -> Option<B>) -> Option<B> {
        let mut it = self;
        while let Option::Some(x) = it.next() {
            match f(x) { Option::Some(y) => { return Option::Some(y); }, Option::None => {} }
        }
        Option::None
    }
    fn position(self, p: fn(Self::Item) -> bool) -> Option<i64> {
        let mut it = self;
        let mut i = 0;
        while let Option::Some(x) = it.next() {
            if p(x) { return Option::Some(i); }
            i += 1;
        }
        Option::None
    }
    fn max(self) -> Option<Self::Item> where Self::Item: Ord {
        let mut it = self;
        let mut best = it.next();
        while let Option::Some(x) = it.next() {
            match best { Option::Some(b) => { if x.cmp(b) != Ordering::Less { best = Option::Some(x); } }, Option::None => {} }
        }
        best
    }
    fn min(self) -> Option<Self::Item> where Self::Item: Ord {
        let mut it = self;
        let mut best = it.next();
        while let Option::Some(x) = it.next() {
            match best { Option::Some(b) => { if x.cmp(b) == Ordering::Less { best = Option::Some(x); } }, Option::None => {} }
        }
        best
    }
    fn max_by_key<K: Ord>(self, f: fn(Self::Item) -> K) -> Option<Self::Item> {
        let mut it = self;
        let mut best = Option::None;
        let mut best_key = Option::None;
        while let Option::Some(x) = it.next() {
            let k = f(x);
            let better = match best_key { Option::Some(bk) => k.cmp(bk) != Ordering::Less, Option::None => true };
            if better { best = Option::Some(x); best_key = Option::Some(k); }
        }
        best
    }
    fn min_by_key<K: Ord>(self, f: fn(Self::Item) -> K) -> Option<Self::Item> {
        let mut it = self;
        let mut best = Option::None;
        let mut best_key = Option::None;
        while let Option::Some(x) = it.next() {
            let k = f(x);
            let better = match best_key { Option::Some(bk) => k.cmp(bk) == Ordering::Less, Option::None => true };
            if better { best = Option::Some(x); best_key = Option::Some(k); }
        }
        best
    }
    fn max_by(self, f: fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next();
        while let Option::Some(x) = it.next() {
            match best { Option::Some(b) => { if f(x, b) != Ordering::Less { best = Option::Some(x); } }, Option::None => {} }
        }
        best
    }
    fn min_by(self, f: fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next();
        while let Option::Some(x) = it.next() {
            match best { Option::Some(b) => { if f(x, b) == Ordering::Less { best = Option::Some(x); } }, Option::None => {} }
        }
        best
    }
    fn sum(self) -> Self::Item where Self::Item: Sum {
        let mut it = self;
        let mut acc: Self::Item = Sum::zero();
        while let Option::Some(x) = it.next() { acc = acc + x; }
        acc
    }
    fn product(self) -> Self::Item where Self::Item: Sum {
        let mut it = self;
        let mut acc: Self::Item = Sum::one();
        while let Option::Some(x) = it.next() { acc = acc * x; }
        acc
    }
    // The items in a Vec. `collect()` builds whatever `FromIterator` type is
    // expected (`Vec`, `String`, `HashMap`, ...), defaulting to a Vec.
    fn collect_vec(self) -> Vec<Self::Item> {
        let mut it = self;
        let mut v: Vec<Self::Item> = Vec::new();
        while let Option::Some(x) = it.next() { v.push(x); }
        v
    }
    fn partition(self, p: fn(Self::Item) -> bool) -> (Vec<Self::Item>, Vec<Self::Item>) {
        let mut it = self;
        let mut yes: Vec<Self::Item> = Vec::new();
        let mut no: Vec<Self::Item> = Vec::new();
        while let Option::Some(x) = it.next() { if p(x) { yes.push(x); } else { no.push(x); } }
        (yes, no)
    }
}

// The additive and multiplicative identities, for `Iterator::sum`/`product`.
trait Sum { fn zero() -> Self; fn one() -> Self; }
impl Sum for i8 { fn zero() -> i8 { 0 } fn one() -> i8 { 1 } }
impl Sum for i16 { fn zero() -> i16 { 0 } fn one() -> i16 { 1 } }
impl Sum for i32 { fn zero() -> i32 { 0 } fn one() -> i32 { 1 } }
impl Sum for i64 { fn zero() -> i64 { 0 } fn one() -> i64 { 1 } }
impl Sum for u8 { fn zero() -> u8 { 0 } fn one() -> u8 { 1 } }
impl Sum for u16 { fn zero() -> u16 { 0 } fn one() -> u16 { 1 } }
impl Sum for u32 { fn zero() -> u32 { 0 } fn one() -> u32 { 1 } }
impl Sum for u64 { fn zero() -> u64 { 0 } fn one() -> u64 { 1 } }
impl Sum for f32 { fn zero() -> f32 { 0.0 } fn one() -> f32 { 1.0 } }
impl Sum for f64 { fn zero() -> f64 { 0.0 } fn one() -> f64 { 1.0 } }

// Types `collect()` can build.
trait FromIterator<A> { fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self; }
// `collect()` into a `Result`: the collection of the `Ok` values, or the
// first `Err`.
impl<A, E, V: FromIterator<A>> FromIterator<Result<A, E>> for Result<V, E> {
    fn from_iter<I: Iterator<Item = Result<A, E>>>(iter: I) -> Result<V, E> {
        let mut items: Vec<A> = Vec::new();
        let mut it = iter;
        while let Option::Some(r) = it.next() {
            match r {
                Result::Ok(x) => items.push(x),
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Ok(V::from_iter(items.into_iter()))
    }
}
impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: Iterator<Item = T>>(iter: I) -> Vec<T> { iter.collect_vec() }
}
impl FromIterator<char> for String {
    fn from_iter<I: Iterator<Item = char>>(iter: I) -> String { String::from_chars(iter.collect_vec()) }
}
impl<K: Eq + Hash, V> FromIterator<(K, V)> for HashMap<K, V> {
    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {
        let mut it = iter;
        let mut m: HashMap<K, V> = HashMap::new();
        while let Option::Some(kv) = it.next() { m.insert(kv.0, kv.1); }
        m
    }
}

// What a range counts over: the integer types.
trait Step {
    fn forward(self) -> Self;
    fn backward(self) -> Self;
    fn steps_between(start: Self, end: Self) -> i64;
}
macro_rules! step_ints {
    ($($t:ty)*) => { $(
        impl Step for $t {
            fn forward(self) -> $t { self + 1 }
            fn backward(self) -> $t { self - 1 }
            fn steps_between(start: $t, end: $t) -> i64 { if end > start { (end - start) as i64 } else { 0 } }
        }
    )* };
}
step_ints!(i8 i16 i32 i64 i128 u8 u16 u32 u64 u128);

// `lo..hi` used as a value; `lo..=hi` ends one later.
struct Range<T> { start: T, end: T }
impl<T: Step> Iterator for Range<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        if self.start < self.end {
            let x = self.start;
            self.start = x.forward();
            Option::Some(x)
        } else { Option::None }
    }
}
impl<T: Step> Range<T> {
    fn rev(self) -> RangeRev<T> { RangeRev { start: self.start, end: self.end } }
    fn len(self) -> i64 { T::steps_between(self.start, self.end) }
    fn contains(self, x: T) -> bool { x >= self.start && x < self.end }
    fn is_empty(self) -> bool { self.start >= self.end }
}
// `lo..` used as a value: counts up without end.
struct RangeFrom<T> { start: T }
impl<T: Step> Iterator for RangeFrom<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        let x = self.start;
        self.start = x.forward();
        Option::Some(x)
    }
}
struct RangeRev<T> { start: T, end: T }
impl<T: Step> Iterator for RangeRev<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        if self.start < self.end {
            self.end = self.end.backward();
            Option::Some(self.end)
        } else { Option::None }
    }
}

// `v.iter()` / `v.into_iter()`: a Vec's elements, front to back.
struct VecIter<T> { v: Vec<T>, i: i64, end: i64 }
impl<T> Iterator for VecIter<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        if self.i < self.end {
            let x = self.v[self.i];
            self.i = self.i + 1;
            Option::Some(x)
        } else { Option::None }
    }
}
impl<T> VecIter<T> {
    fn rev(self) -> VecIterRev<T> { VecIterRev { v: self.v, i: self.i, end: self.end } }
    fn len(self) -> i64 { self.end - self.i }
}
struct VecIterRev<T> { v: Vec<T>, i: i64, end: i64 }
impl<T> Iterator for VecIterRev<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        if self.i < self.end {
            self.end = self.end - 1;
            Option::Some(self.v[self.end])
        } else { Option::None }
    }
}
impl<T> Vec<T> {
    fn iter(self) -> VecIter<T> { VecIter { v: self, i: 0, end: self.len } }
    fn into_iter(self) -> VecIter<T> { VecIter { v: self, i: 0, end: self.len } }
    fn iter_mut(self) -> VecIter<T> { VecIter { v: self, i: 0, end: self.len } }
    // Iterator adapters straight on a Vec (`s.chars().rev()`); each starts
    // from `iter()`. `map`, `filter`, `fold`, ... are the Vec's own eager forms.
    fn rev(self) -> VecIterRev<T> { VecIterRev { v: self, i: 0, end: self.len } }
    fn count(self) -> i64 { self.len }
    fn nth(self, n: i64) -> Option<T> { self.get(n) }
    fn enumerate(self) -> Enumerate<VecIter<T>> { self.iter().enumerate() }
    fn skip(self, n: i64) -> Skip<VecIter<T>> { self.iter().skip(n) }
    fn take(self, n: i64) -> Take<VecIter<T>> { self.iter().take(n) }
    fn step_by(self, n: i64) -> StepBy<VecIter<T>> { self.iter().step_by(n) }
    fn zip<J: IntoIterator>(self, other: J) -> Zip<VecIter<T>, J::IntoIter> { self.iter().zip(other) }
    fn peekable(self) -> Peekable<VecIter<T>, T> { self.iter().peekable() }
    fn filter_map<B>(self, f: fn(T) -> Option<B>) -> FilterMap<VecIter<T>, T, B> { self.iter().filter_map(f) }
    fn flat_map<J: Iterator>(self, f: fn(T) -> J) -> FlatMap<VecIter<T>, T, J> { self.iter().flat_map(f) }
    fn take_while(self, p: fn(T) -> bool) -> TakeWhile<VecIter<T>, T> { self.iter().take_while(p) }
    fn skip_while(self, p: fn(T) -> bool) -> SkipWhile<VecIter<T>, T> { self.iter().skip_while(p) }
    fn cloned(self) -> Vec<T> { self }
    fn copied(self) -> Vec<T> { self }
    // A Vec is its own slice (`match v.as_slice() { [first, ..] => .. }`).
    fn as_slice(self) -> Vec<T> { self }
    fn to_vec(self) -> Vec<T> { self.clone() }

    fn drain(mut self) -> VecIter<T> {
        let copy = self.clone();
        self.clear();
        VecIter { v: copy, i: 0, end: copy.len }
    }
}
impl<K: Eq + Hash, V> HashMap<K, V> {
    // (key, value) pairs; like Rust's, in no particular order.
    fn iter(self) -> VecIter<(K, V)> {
        let ks = self.keys();
        let vs = self.values();
        let mut pairs: Vec<(K, V)> = Vec::new();
        let mut i = 0;
        while i < ks.len() { pairs.push((ks[i], vs[i])); i += 1; }
        pairs.iter()
    }
}

struct Map<I, A, B> { iter: I, f: fn(A) -> B }
impl<I: Iterator<Item = A>, A, B> Iterator for Map<I, A, B> {
    type Item = B;
    fn next(mut self) -> Option<B> {
        match self.iter.next() { Option::Some(x) => Option::Some((self.f)(x)), Option::None => Option::None }
    }
}
struct Filter<I, A> { iter: I, p: fn(A) -> bool }
impl<I: Iterator<Item = A>, A> Iterator for Filter<I, A> {
    type Item = A;
    fn next(mut self) -> Option<A> {
        while let Option::Some(x) = self.iter.next() { if (self.p)(x) { return Option::Some(x); } }
        Option::None
    }
}
struct FilterMap<I, A, B> { iter: I, f: fn(A) -> Option<B> }
impl<I: Iterator<Item = A>, A, B> Iterator for FilterMap<I, A, B> {
    type Item = B;
    fn next(mut self) -> Option<B> {
        while let Option::Some(x) = self.iter.next() {
            match (self.f)(x) { Option::Some(y) => { return Option::Some(y); }, Option::None => {} }
        }
        Option::None
    }
}
struct Enumerate<I> { iter: I, i: i64 }
impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (i64, I::Item);
    fn next(mut self) -> Option<(i64, I::Item)> {
        match self.iter.next() {
            Option::Some(x) => { let i = self.i; self.i = i + 1; Option::Some((i, x)) }
            Option::None => Option::None,
        }
    }
}
struct Take<I> { iter: I, n: i64 }
impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(mut self) -> Option<I::Item> {
        if self.n <= 0 { return Option::None; }
        self.n = self.n - 1;
        self.iter.next()
    }
}
struct Skip<I> { iter: I, n: i64 }
impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    fn next(mut self) -> Option<I::Item> {
        while self.n > 0 {
            self.n = self.n - 1;
            if self.iter.next().is_none() { return Option::None; }
        }
        self.iter.next()
    }
}
struct StepBy<I> { iter: I, step: i64, first: bool }
impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    fn next(mut self) -> Option<I::Item> {
        if self.first {
            self.first = false;
            return self.iter.next();
        }
        let mut k = 1;
        while k < self.step {
            if self.iter.next().is_none() { return Option::None; }
            k += 1;
        }
        self.iter.next()
    }
}
struct Zip<I, J> { a: I, b: J }
impl<I: Iterator, J: Iterator> Iterator for Zip<I, J> {
    type Item = (I::Item, J::Item);
    fn next(mut self) -> Option<(I::Item, J::Item)> {
        match self.a.next() {
            Option::Some(x) => match self.b.next() {
                Option::Some(y) => Option::Some((x, y)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }
}
struct Chain<I, J> { a: I, b: J, first: bool }
impl<I: Iterator, J: Iterator> Iterator for Chain<I, J> {
    type Item = I::Item;
    fn next(mut self) -> Option<I::Item> {
        if self.first {
            match self.a.next() {
                Option::Some(x) => { return Option::Some(x); }
                Option::None => { self.first = false; }
            }
        }
        self.b.next()
    }
}
struct TakeWhile<I, A> { iter: I, p: fn(A) -> bool, done: bool }
impl<I: Iterator<Item = A>, A> Iterator for TakeWhile<I, A> {
    type Item = A;
    fn next(mut self) -> Option<A> {
        if self.done { return Option::None; }
        match self.iter.next() {
            Option::Some(x) => { if (self.p)(x) { Option::Some(x) } else { self.done = true; Option::None } }
            Option::None => Option::None,
        }
    }
}
struct SkipWhile<I, A> { iter: I, p: fn(A) -> bool, started: bool }
impl<I: Iterator<Item = A>, A> Iterator for SkipWhile<I, A> {
    type Item = A;
    fn next(mut self) -> Option<A> {
        if self.started { return self.iter.next(); }
        while let Option::Some(x) = self.iter.next() {
            if !(self.p)(x) { self.started = true; return Option::Some(x); }
        }
        Option::None
    }
}
struct FlatMap<I, A, J> { iter: I, f: fn(A) -> J, current: Option<J> }
impl<I: Iterator<Item = A>, A, J: Iterator> Iterator for FlatMap<I, A, J> {
    type Item = J::Item;
    fn next(mut self) -> Option<J::Item> {
        loop {
            match self.current {
                Option::Some(inner) => {
                    let mut cur = inner;
                    match cur.next() {
                        Option::Some(x) => { return Option::Some(x); }
                        Option::None => { self.current = Option::None; }
                    }
                }
                Option::None => {
                    match self.iter.next() {
                        Option::Some(x) => { self.current = Option::Some((self.f)(x)); }
                        Option::None => { return Option::None; }
                    }
                }
            }
        }
    }
}
struct Inspect<I, A> { iter: I, f: fn(A) }
impl<I: Iterator<Item = A>, A> Iterator for Inspect<I, A> {
    type Item = A;
    fn next(mut self) -> Option<A> {
        match self.iter.next() {
            Option::Some(x) => { (self.f)(x); Option::Some(x) }
            Option::None => Option::None,
        }
    }
}
struct Peekable<I, A> { iter: I, peeked: Option<Option<A>> }
impl<I: Iterator<Item = A>, A> Iterator for Peekable<I, A> {
    type Item = A;
    fn next(mut self) -> Option<A> {
        match self.peeked {
            Option::Some(p) => { self.peeked = Option::None; p }
            Option::None => self.iter.next(),
        }
    }
}
impl<I: Iterator<Item = A>, A> Peekable<I, A> {
    fn peek(mut self) -> Option<A> {
        match self.peeked {
            Option::Some(p) => p,
            Option::None => {
                let p = self.iter.next();
                self.peeked = Option::Some(p);
                p
            }
        }
    }
}

// ---- char methods ---------------------------------------------------------------

impl char {
    // The char with code point `u`; None for surrogates and values past U+10FFFF.
    fn from_u32(u: u32) -> Option<char> {
        if u > 0x10FFFF || (u >= 0xD800 && u < 0xE000) { Option::None } else { Option::Some(u as char) }
    }

    fn is_ascii_digit(self) -> bool { self >= '0' && self <= '9' }
    fn is_ascii_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    fn is_ascii_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    fn is_ascii_alphabetic(self) -> bool { self.is_ascii_lowercase() || self.is_ascii_uppercase() }
    fn is_ascii_alphanumeric(self) -> bool { self.is_ascii_alphabetic() || self.is_ascii_digit() }
    fn is_ascii_whitespace(self) -> bool { self == ' ' || self == '\t' || self == '\n' || self == '\r' || (self as i64) == 12 }
    fn is_ascii_punctuation(self) -> bool {
        let c = self as i64;
        (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)
    }
    fn is_ascii_hexdigit(self) -> bool { self.is_ascii_digit() || (self >= 'a' && self <= 'f') || (self >= 'A' && self <= 'F') }
    fn is_ascii(self) -> bool { (self as i64) < 128 }
    // Unicode classes beyond ASCII are approximated by their ASCII ranges
    // plus "any non-ASCII letter-like char" for alphabetic.
    fn is_alphabetic(self) -> bool { self.is_ascii_alphabetic() || (self as i64) > 127 }
    fn is_numeric(self) -> bool { self.is_ascii_digit() }
    fn is_alphanumeric(self) -> bool { self.is_alphabetic() || self.is_numeric() }
    fn is_whitespace(self) -> bool { self.is_ascii_whitespace() || (self as i64) == 11 || (self as i64) == 133 || (self as i64) == 160 }
    fn is_lowercase(self) -> bool { self.is_ascii_lowercase() }
    fn is_uppercase(self) -> bool { self.is_ascii_uppercase() }
    fn is_control(self) -> bool { (self as i64) < 32 || (self as i64) == 127 }
    fn to_ascii_uppercase(self) -> char { if self.is_ascii_lowercase() { ((self as i64) - 32) as char } else { self } }
    fn to_ascii_lowercase(self) -> char { if self.is_ascii_uppercase() { ((self as i64) + 32) as char } else { self } }
    fn eq_ignore_ascii_case(self, other: char) -> bool { self.to_ascii_lowercase() == other.to_ascii_lowercase() }
    // The value of the digit `self` in base `radix`, if it is one.
    fn to_digit(self, radix: i64) -> Option<i64> {
        let c = self as i64;
        let d = if c >= 48 && c <= 57 { c - 48 }
            else if c >= 97 && c <= 122 { c - 87 }
            else if c >= 65 && c <= 90 { c - 55 }
            else { 99 };
        if d < radix { Option::Some(d) } else { Option::None }
    }
    fn from_digit(d: i64, radix: i64) -> Option<char> {
        if d < 0 || d >= radix { return Option::None; }
        Option::Some(if d < 10 { (d + 48) as char } else { (d + 87) as char })
    }
    fn len_utf8(self) -> i64 {
        let c = self as i64;
        if c < 128 { 1 } else if c < 2048 { 2 } else if c < 65536 { 3 } else { 4 }
    }
}

// ---- Operator traits for the numeric primitives -------------------------------
// Scalars use the built-in operators directly; these impls let generic code
// bound by `T: Add<Output = T>` (and the rest) accept them.

macro_rules! numeric_ops {
    ($($t:ty)*) => { $(
        impl Add for $t { fn add(self, rhs: $t) -> $t { self + rhs } }
        impl Sub for $t { fn sub(self, rhs: $t) -> $t { self - rhs } }
        impl Mul for $t { fn mul(self, rhs: $t) -> $t { self * rhs } }
        impl Div for $t { fn div(self, rhs: $t) -> $t { self / rhs } }
        impl Rem for $t { fn rem(self, rhs: $t) -> $t { self % rhs } }
        impl AddAssign for $t { fn add_assign(mut self, rhs: $t) { self = self + rhs; } }
        impl SubAssign for $t { fn sub_assign(mut self, rhs: $t) { self = self - rhs; } }
        impl MulAssign for $t { fn mul_assign(mut self, rhs: $t) { self = self * rhs; } }
        impl DivAssign for $t { fn div_assign(mut self, rhs: $t) { self = self / rhs; } }
    )* };
}
numeric_ops!(i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64);
macro_rules! signed_ops {
    ($($t:ty)*) => { $( impl Neg for $t { fn neg(self) -> $t { 0 as $t - self } } )* };
}
signed_ops!(i8 i16 i32 i64 i128 f32 f64);
macro_rules! bit_ops {
    ($($t:ty)*) => { $(
        impl BitAnd for $t { fn bitand(self, rhs: $t) -> $t { self & rhs } }
        impl BitOr for $t { fn bitor(self, rhs: $t) -> $t { self | rhs } }
        impl BitXor for $t { fn bitxor(self, rhs: $t) -> $t { self ^ rhs } }
    )* };
}
bit_ops!(i8 i16 i32 i64 i128 u8 u16 u32 u64 u128);
impl Not for bool { fn not(self) -> bool { !self } }

// ---- async / await -------------------------------------------------------------
// Futures are lazy and synchronous: an `async` function or block builds an
// `Async` holding its body, and `.await` (`Future::wait`) runs it to completion
// on the awaiting thread. There is no executor and no interleaving at
// `.await`; use `Thread::spawn` for concurrency.

trait Future {
    type Output;
    fn wait(self) -> Self::Output;
}
struct Async<T> { body: fn() -> T }
impl<T> Future for Async<T> {
    type Output = T;
    fn wait(self) -> T { (self.body)() }
}
// A future that is already complete (`std::future::ready`).
fn ready<T>(value: T) -> Async<T> { Async { body: move || value } }
// Run a future to completion (`futures::executor::block_on`).
fn block_on<F: Future>(future: F) -> F::Output { future.wait() }

// ---- IntoIterator -----------------------------------------------------------------
// What a `for` loop (or `I: IntoIterator<Item = T>`) accepts: collections and
// every iterator.

trait IntoIterator {
    type Item;
    type IntoIter;
    fn into_iter(self) -> Self::IntoIter;
}
// `Some(x)` / `Ok(x)` yield `x`; `None` / `Err(_)` yield nothing.
struct OptionIter<T> { v: Option<T> }
impl<T> Iterator for OptionIter<T> {
    type Item = T;
    fn next(mut self) -> Option<T> {
        let v = self.v;
        self.v = Option::None;
        v
    }
}
impl<T> IntoIterator for Option<T> {
    type Item = T;
    type IntoIter = OptionIter<T>;
    fn into_iter(self) -> OptionIter<T> { OptionIter { v: self } }
}
impl<T, E> IntoIterator for Result<T, E> {
    type Item = T;
    type IntoIter = OptionIter<T>;
    fn into_iter(self) -> OptionIter<T> { OptionIter { v: self.ok() } }
}
impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = VecIter<T>;
    fn into_iter(self) -> VecIter<T> { VecIter { v: self, i: 0, end: self.len } }
}
impl<K: Eq + Hash, V> IntoIterator for HashMap<K, V> {
    type Item = (K, V);
    type IntoIter = VecIter<(K, V)>;
    fn into_iter(self) -> VecIter<(K, V)> { self.iter() }
}
impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;
    fn into_iter(self) -> I { self }
}
