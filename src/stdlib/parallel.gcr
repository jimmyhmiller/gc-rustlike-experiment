// Bounded, ordered parallel map. A batch is joined completely before the next
// batch starts. No worker outlives the call; input/output order is preserved.
impl<T: Sync> Vec<T> {
    fn parallel_map<U: Sync>(self, workers: i64, f: fn(T) -> U) -> Result<Vec<U>, String> {
        if workers < 1 || workers > 64 { return Err("worker count must be between 1 and 64"); }
        let mut output: Vec<U> = Vec::with_capacity(self.len());
        let mut start = 0;
        while start < self.len() {
            let mut handles: Vec<Thread<U>> = Vec::new();
            let mut end = start;
            while end < self.len() && end - start < workers {
                let item = self[end];
                handles.push(Thread::spawn(|| f(item)));
                end += 1;
            }
            let mut i = 0;
            while i < handles.len() {
                output.push(handles[i].join());
                i += 1;
            }
            start = end;
        }
        Ok(output)
    }
}
