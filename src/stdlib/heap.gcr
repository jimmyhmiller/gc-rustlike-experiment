// Single-owner/external-synchronization minimum priority queue. Like ordinary
// Vec/HashMap, this is not a concurrent collection. Elements compare through Ord.
struct MinHeap<T> { items: Vec<T> }
impl<T: Ord> MinHeap<T> {
    fn new() -> MinHeap<T> { MinHeap { items: Vec::new() } }
    fn len(self) -> i64 { self.items.len() }
    fn is_empty(self) -> bool { self.items.is_empty() }
    fn peek(self) -> Option<T> { self.items.first() }
    fn push(mut self, item: T) {
        self.items.push(item);
        let mut index = self.items.len() - 1;
        while index > 0 {
            let parent = (index - 1) / 2;
            let child_value = self.items[index];
            let parent_value = self.items[parent];
            if child_value >= parent_value { break; }
            self.items[index] = parent_value;
            self.items[parent] = child_value;
            index = parent;
        }
    }
    fn pop(mut self) -> Option<T> {
        if self.items.is_empty() { return None; }
        let result = self.items[0];
        let last = self.items.pop().unwrap();
        if !self.items.is_empty() {
            self.items[0] = last;
            let mut index = 0;
            loop {
                let left = index * 2 + 1;
                if left >= self.items.len() { break; }
                let right = left + 1;
                let mut child = left;
                if right < self.items.len() && self.items[right] < self.items[left] { child = right; }
                let current = self.items[index];
                let next = self.items[child];
                if current <= next { break; }
                self.items[index] = next;
                self.items[child] = current;
                index = child;
            }
        }
        Some(result)
    }
}
