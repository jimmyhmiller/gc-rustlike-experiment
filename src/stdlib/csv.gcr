// Strict, bounded UTF-8 CSV. Comma separators; LF, CRLF and CR record endings.
// A quote is legal only at a field's start; doubled quotes escape a quote.
struct CsvError { record: i64, byte: i64, message: String }
struct CsvField { text: String, next: i64 }
impl CsvError {
    // `byte` is a zero-based offset; the error reports it one-based.
    fn new(record: i64, byte: i64, message: String) -> CsvError {
        CsvError { record: record, byte: byte + 1, message: message }
    }
}
impl ToString for CsvError {
    fn to_string(self) -> String {
        "CSV record " + self.record.to_string() + " at byte " + self.byte.to_string() + ": " + self.message
    }
}
fn csv_delimiter(byte: i64) -> bool { byte == 44 || byte == 10 || byte == 13 }
fn csv_decode_field(text: String, start: i64, record: i64) -> Result<CsvField, CsvError> {
    let length = text.len();
    if start >= length || text.byte_at(start) != 34 {
        let mut i = start;
        while i < length && !csv_delimiter(text.byte_at(i)) {
            if text.byte_at(i) == 34 { return Err(CsvError::new(record, i, "quote inside unquoted field")); }
            i += 1;
            if i - start > 1048576 { return Err(CsvError::new(record, i, "field exceeds 1 MiB")); }
        }
        return Ok(CsvField { text: text.substring(start, i), next: i });
    }
    let mut pieces: Vec<String> = Vec::new();
    let mut i = start + 1;
    let mut segment = i;
    let mut bytes = 0;
    while i < length {
        if text.byte_at(i) == 34 {
            bytes += i - segment;
            if bytes > 1048576 { return Err(CsvError::new(record, i, "field exceeds 1 MiB")); }
            pieces.push(text.substring(segment, i));
            if i + 1 < length && text.byte_at(i + 1) == 34 {
                pieces.push("\"");
                bytes += 1;
                if bytes > 1048576 { return Err(CsvError::new(record, i, "field exceeds 1 MiB")); }
                i += 2;
                segment = i;
            } else {
                i += 1;
                if i < length && !csv_delimiter(text.byte_at(i)) {
                    return Err(CsvError::new(record, i, "characters after closing quote"));
                }
                return Ok(CsvField { text: pieces.join(""), next: i });
            }
        } else {
            i += 1;
            if bytes + i - segment > 1048576 { return Err(CsvError::new(record, i, "field exceeds 1 MiB")); }
        }
    }
    Err(CsvError::new(record, length, "unterminated quoted field"))
}
fn csv_parse(text: String, max_records: i64, max_fields: i64) -> Result<Vec<Vec<String>>, CsvError> {
    if max_records < 1 || max_fields < 1 {
        return Err(CsvError::new(1, 0, "CSV limits must be positive"));
    }
    if text.len() > 16777216 { return Err(CsvError::new(1, 0, "CSV input exceeds 16 MiB")); }
    let mut rows: Vec<Vec<String>> = Vec::new();
    let mut position = if text.starts_with("\u{feff}") { 3 } else { 0 };
    while position < text.len() {
        let record = rows.len() + 1;
        if record > max_records { return Err(CsvError::new(record, position, "record limit exceeded")); }
        let mut row: Vec<String> = Vec::new();
        loop {
            if row.len() >= max_fields { return Err(CsvError::new(record, position, "field count limit exceeded")); }
            let field = csv_decode_field(text, position, record)?;
            row.push(field.text);
            position = field.next;
            if position == text.len() { break; }
            let separator = text.byte_at(position);
            position += 1;
            if separator != 44 {
                if separator == 13 && position < text.len() && text.byte_at(position) == 10 { position += 1; }
                break;
            }
        }
        rows.push(row);
    }
    Ok(rows)
}
fn csv_escape(text: String) -> String {
    // Quote a leading BOM so the parser cannot mistake field text for a file BOM.
    let mut quote = text.starts_with("\u{feff}");
    let mut i = 0;
    while i < text.len() {
        if csv_delimiter(text.byte_at(i)) || text.byte_at(i) == 34 { quote = true; }
        i += 1;
    }
    if !quote { return text; }
    let mut pieces: Vec<String> = Vec::new();
    pieces.push("\"");
    let mut start = 0;
    i = 0;
    while i < text.len() {
        if text.byte_at(i) == 34 {
            pieces.push(text.substring(start, i));
            pieces.push("\"\"");
            start = i + 1;
        }
        i += 1;
    }
    pieces.push(text.substring(start, i));
    pieces.push("\"");
    pieces.join("")
}
fn csv_encode(rows: Vec<Vec<String>>) -> Result<String, CsvError> {
    let mut pieces: Vec<String> = Vec::new();
    let mut bytes = 0;
    let mut r = 0;
    while r < rows.len() {
        let row = rows[r];
        if row.is_empty() { return Err(CsvError::new(r + 1, bytes, "cannot encode a zero-field record")); }
        let mut c = 0;
        while c < row.len() {
            let field = row[c];
            if field.len() > 1048576 { return Err(CsvError::new(r + 1, bytes, "field exceeds 1 MiB")); }
            let encoded = csv_escape(field);
            bytes = bytes + encoded.len() + if c > 0 { 1 } else { 0 };
            if bytes > 16777216 - 2 { return Err(CsvError::new(r + 1, bytes, "CSV output exceeds 16 MiB")); }
            if c > 0 { pieces.push(","); }
            pieces.push(encoded);
            c += 1;
        }
        pieces.push("\r\n");
        bytes += 2;
        r += 1;
    }
    Ok(pieces.join(""))
}
