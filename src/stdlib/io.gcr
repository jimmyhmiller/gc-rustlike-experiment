// Managed syscall response ABI; applications use the typed wrappers below.
struct IoResponse { text: String, entries: Array<String>, code: i64, kind: i64 }
// kind: 1 not found, 2 permission denied, 3 invalid data/input, 4 other I/O.
struct IoError { operation: String, path: String, kind: i64, message: String }
impl IoError {
    fn from_response(r: IoResponse, operation: String, path: String) -> IoError {
        IoError { operation: operation, path: path, kind: r.code, message: r.text }
    }
}
impl ToString for IoError {
    fn to_string(self) -> String { self.operation + " " + self.path + ": " + self.message }
}
fn fs_read_text(path: String, max_bytes: i64) -> Result<String, IoError> {
    let r = host_io(1, path, "", max_bytes);
    if r.code == 0 { Ok(r.text) } else { Err(IoError::from_response(r, "read", path)) }
}
fn fs_read_dir(path: String) -> Result<Array<String>, IoError> {
    let r = host_io(2, path, "", 100000);
    if r.code == 0 { Ok(r.entries) } else { Err(IoError::from_response(r, "list", path)) }
}
// Does not follow symlinks: 1 regular file, 2 directory, 3 symlink, 4 other.
fn fs_kind(path: String) -> Result<i64, IoError> {
    let r = host_io(3, path, "", 0);
    if r.code == 0 { Ok(r.kind) } else { Err(IoError::from_response(r, "stat", path)) }
}
fn path_absolute(path: String) -> Result<String, IoError> {
    let r = host_io(4, path, "", 0);
    if r.code == 0 { Ok(r.text) } else { Err(IoError::from_response(r, "resolve", path)) }
}
fn path_join(parent: String, name: String) -> String {
    if name.starts_with("/") { name }
    else if parent.ends_with("/") || parent.is_empty() { parent + name }
    else { parent + "/" + name }
}
fn fs_write_text_atomic(path: String, text: String) -> Result<i64, IoError> {
    let r = host_io(5, path, text, 0);
    if r.code == 0 { Ok(0) } else { Err(IoError::from_response(r, "write", path)) }
}
fn process_args() -> Result<Array<String>, IoError> {
    let r = host_io(0, "", "", 0);
    if r.code == 0 { Ok(r.entries) } else { Err(IoError::from_response(r, "arguments", "")) }
}
fn stdout_line(text: String) -> Result<i64, IoError> {
    let r = host_io(7, "", text, 0);
    if r.code == 0 { Ok(0) } else { Err(IoError::from_response(r, "stdout", "")) }
}
fn stderr_line(text: String) -> i64 { let r = host_io(6, "", text, 0); r.code }
fn stderr_write(text: String) -> i64 { let r = host_io(8, "", text, 0); r.code }

// JSON string encoding preserves UTF-8 and escapes every ASCII control byte.
fn json_quote(text: String) -> String {
    let mut parts: Vec<String> = Vec::new();
    parts.push("\"");
    let mut start = 0;
    let mut i = 0;
    let hex = "0123456789abcdef";
    while i < text.len() {
        let b = text.byte_at(i);
        if b < 32 || b == 34 || b == 92 {
            parts.push(text[start..i]);
            if b == 34 { parts.push("\\\""); }
            else if b == 92 { parts.push("\\\\"); }
            else {
                parts.push("\\u00" + hex[b / 16..b / 16 + 1] + hex[b % 16..b % 16 + 1]);
            }
            start = i + 1;
        }
        i += 1;
    }
    parts.push(text[start..i]);
    parts.push("\"");
    parts.join("")
}
