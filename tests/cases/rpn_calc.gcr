// RPN calculator: tokenize, evaluate with a stack, return Result on error.
fn rpn(input: String) -> Result<i64, i64> {
  let parts = input.split(" ");
  let mut stack: Vec<i64> = Vec::new();
  let mut i = 0;
  while i < parts.len() {
    let p = parts[i];
    if p == "+" || p == "*" || p == "-" {
      if stack.len() < 2 { return Result::Err(1); }
      let b = stack.pop().unwrap(); let a = stack.pop().unwrap();
      let r = if p == "+" { a + b } else { if p == "*" { a * b } else { a - b } };
      stack.push(r);
    } else {
      match p.parse_i64() { Option::Some(n) => { stack.push(n); } Option::None => { return Result::Err(2); } }
    }
    i = i + 1;
  }
  if stack.len() == 1 { Result::Ok(stack.pop().unwrap()) } else { Result::Err(3) }
}
fn main() -> i64 {
  let a = match rpn("3 4 + 6 *") { Result::Ok(v) => v, Result::Err(e) => 0 };   // 42
  let b = match rpn("1 +") { Result::Ok(v) => v, Result::Err(e) => e };          // Err(1) -> 1
  let c = match rpn("5 x +") { Result::Ok(v) => v, Result::Err(e) => e };        // Err(2) -> 2
  a - b - c + 3   // 42 - 1 - 2 + 3 = 42
}
