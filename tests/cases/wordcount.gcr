fn main() -> i64 {
    let words = "the cat the dog the cat the".split(" ");
    let mut counts: HashMap<String, i64> = HashMap::new();
    let mut i = 0;
    while i < words.len() {
        let w = words[i];
        let c = match counts.get(w) { Option::Some(n) => n, Option::None => 0 };
        counts.insert(w, c + 1);
        i = i + 1;
    }
    let the = match counts.get("the") { Option::Some(n) => n, Option::None => 0 };
    let cat = match counts.get("cat") { Option::Some(n) => n, Option::None => 0 };
    let dog = match counts.get("dog") { Option::Some(n) => n, Option::None => 0 };
    the * 10 + cat - dog + 1
}
