fn main() -> i64 {
  let a = "one,two,three".replace(",", " | ");           // longer
  let b = "aXbXcXd".replace("X", "");                    // remove
  let c = "no match here".replace("zzz", "!");           // none
  let ok1 = if a == "one | two | three" { 1 } else { 0 };
  let ok2 = if b == "abcd" { 1 } else { 0 };
  let ok3 = if c == "no match here" { 1 } else { 0 };
  ok1 * 10 + ok2 * 10 + ok3 * 10 + 12                    // 30 + 12 = 42
}
