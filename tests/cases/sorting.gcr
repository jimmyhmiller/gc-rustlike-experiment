struct Score { name: String, points: i64 }
fn main() -> i64 {
  let mut v = Vec::new(); v.push(5); v.push(2); v.push(8); v.push(1); v.push(9);
  v.sort();                                                 // [1,2,5,8,9]
  let mut b = Vec::new();
  b.push(Score{name:"a",points:30}); b.push(Score{name:"b",points:50}); b.push(Score{name:"c",points:40});
  b.sort_by(|x: Score, y: Score| x.points.cmp(y.points));  // [30,40,50]
  v[0] + v[4] + b[0].points + b[2].points - 48   // 1+9+30+50-48 = 42
}
