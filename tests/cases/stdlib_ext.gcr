fn main() -> i64 {
  let mut v = Vec::new(); v.push(1); v.push(2); v.push(3);
  let mut r = v.clone(); r.reverse();
  let hit = if r.contains(2) { 1 } else { 0 };
  let idx = r.position(|x: i64| x == 1).unwrap();
  let sl = "xy".repeat(4).len();
  let si = "find the needle".find("needle").unwrap();
  r[0] + hit + idx + sl + si + 19
}
