fn ieq(a: String, b: String) -> bool { a.to_lowercase() == b.to_lowercase() }
fn main() -> i64 {
  let lo = "MixedCase123".to_lowercase();        // "mixedcase123"
  let up = "MixedCase123".to_uppercase();        // "MIXEDCASE123"
  let a = if lo == "mixedcase123" { 1 } else { 0 };
  let b = if up == "MIXEDCASE123" { 1 } else { 0 };
  let c = if ieq("Hello", "HELLO") { 1 } else { 0 };
  let d = if ieq("x", "y") { 0 } else { 1 };
  a * 10 + b * 10 + c * 10 + d * 10 + 2          // 1*10*4 + 2 = 42
}
