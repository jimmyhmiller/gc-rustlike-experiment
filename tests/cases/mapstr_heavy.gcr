fn main() -> i64 {
  let mut m: HashMap<String, i64> = HashMap::new();
  let mut i = 0;
  while i < 50000 { m.insert("k" + i.to_string(), i); i = i + 1; }
  let a = match m.get("k100") { Option::Some(n) => n, Option::None => 0 };
  let b = match m.get("k49999") { Option::Some(n) => n, Option::None => 0 };
  a + b - 50057
}
