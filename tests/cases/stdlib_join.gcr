fn main() -> i64 {
  let mut a = Vec::new(); a.push(1); a.push(2);
  let mut b = Vec::new(); b.push(3); b.push(4);
  let mut c = a.clone(); c.extend(b);                      // [1,2,3,4]
  let sum = c[0]+c[1]+c[2]+c[3];  // 10
  let parts = "alpha beta gamma".split(" ");        // 3 words
  let joined = parts.join("_");                         // "alpha_beta_gamma"
  let ok = if joined == "alpha_beta_gamma" { 1 } else { 0 };
  sum + c.len() + joined.len() + ok + 11               // 10 + 4 + 16 + 1 + 11 = 42
}
