#[value] struct Label { text: String, number: i64 }
#[value] enum Inline { Record(Label), Other(i64, String) }
enum Packet { Data(i8, Inline, i64, Option<String>), Empty }
fn collect_noise() -> i64 {
    let mut i = 0;
    while i < 50 { let s = "temporary" + i.to_string(); i += s.len() / s.len(); }
    i
}
fn inspect(packet: Packet) -> i64 {
    collect_noise();
    match packet {
        Packet::Data(prefix, inline, suffix, tail) if prefix == 7 => {
            let label = match inline { Inline::Record(label) if label.number == 42 => label, _ => { return 1; } };
            if label.text != "persist λ" || suffix != 91 { return 2; }
            match tail { Some(text) if (text == "tail 🦀") => 0, _ => 3 }
        },
        _ => 4
    }
}
fn main() -> i64 {
    let unit: Option<()> = Some(());
    let unit_status = match unit { Some(value) if true => { let copy = value; 0 }, _ => 14 };
    if unit_status != 0 { return unit_status; }
    let unit_ref: Result<(),String> = Ok(());
    let ref_status = match unit_ref { Ok(value) if true => { let copy = value; 0 }, _ => 15 };
    if ref_status != 0 { return ref_status; }
    let packet = Packet::Data(7,Inline::Record(Label { text:"persist λ",number:42 }),91,Some("tail 🦀"));
    if field_count(packet) != 4 || field_i64(packet,0) != 7 || field_kind(packet,1) != 5
        || field_i64(packet,2) != 91 || field_kind(packet,3) != 5 { return 13; }
    if field_name(packet,1) != "1" || field_name(packet,3) != "3" { return 16; }
    let status = inspect(packet);
    if status != 0 { return status; }
    match packet {
        Packet::Data(prefix, inline, suffix, tail) => {
            let label = match inline { Inline::Record(label) => label, _ => { return 5; } };
            collect_noise();
            if prefix != 7 || suffix != 91 || label.number != 42 || label.text != "persist λ" { return 6; }
            if (tail.expect("tail") == "tail 🦀") == false { return 7; }
        },
        _ => { return 8; }
    };
    let other = Packet::Data(7,Inline::Other(12,"other"),91,None);
    collect_noise();
    match other {
        Packet::Data(_, inner, _, tail) => {
            match inner { Inline::Other(n,text) if n == 12 && (text == "other") => {}, _ => { return 9; } };
            if tail.is_some() { return 10; }
        },
        _ => { return 11; }
    };
    let empty: Packet = Packet::Empty;
    match empty { Packet::Data(_, _, _, _) if false => 12, _ => 0 }
}
