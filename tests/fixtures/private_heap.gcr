// Private, aliased object graphs and pointer-field barriers survive moving GC.
// Shared reference arrays publish their children to both workers.
struct Item { value: i64 }
impl Sync for Item {}
struct Cell { child: Item }
fn private_work(n: i64) -> i64 {
    let mut cell = Cell { child: Item { value: 3 } };
    let mut items: Array<Item> = array_new(2);
    array_set(items,0,cell.child);
    array_set(items,1,cell.child);
    let mut sum = 0;
    let mut i = 0;
    while i < n {
        let mut item = items[i % 2];
        item.value = item.value + i % 7;
        sum = sum + item.value;
        let replacement = Item { value: i+100 };
        cell.child = replacement;
        let mut scratch: Array<i64> = array_new(4096);
        array_set(scratch,0,i);
        sum = sum + cell.child.value + scratch[0];
        i = i+1;
    }
    sum + items[0].value + items[1].value + cell.child.value
}
fn shared_work(items: Array<Item>, index: i64) -> i64 {
    let mut item = items[index];
    let mut i = 0;
    while i < 1000 { item.value = item.value+1; i = i+1; }
    item.value
}
fn main() -> i64 {
    let mut shared: Array<Item> = array_new(2);
    array_set(shared,0,Item { value: 10 });
    array_set(shared,1,Item { value: 20 });
    let first = thread_spawn(|| private_work(128) + shared_work(shared,0));
    let second = thread_spawn(|| private_work(129) + shared_work(shared,1));
    let own = private_work(130);
    let a = thread_join(first);
    let b = thread_join(second);
    print_int(own+a+b);
    0
}
