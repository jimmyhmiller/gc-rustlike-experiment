fn main() -> i64 {
    let mut field = "x";
    let mut i = 0;
    while i < 20 { field += field; i += 1; }
    if field.len() != 1048576 { return 1; }
    let rows = match csv_parse(field,1,1) { Ok(r) => r, Err(_) => { return 2; } };
    if rows[0][0].len() != 1048576 { return 3; }
    let too_long = field + "x";
    match csv_parse(too_long,1,1) { Err(e) => { if !e.message.contains("1 MiB") { return 4; } }, Ok(_) => { return 5; } };
    let mut long_row: Vec<String> = Vec::new();
    long_row.push(too_long);
    let mut long_rows: Vec<Vec<String>> = Vec::new();
    long_rows.push(long_row);
    if csv_encode(long_rows).is_ok() { return 6; }
    let quoted = "\"" + field + "\"";
    match csv_parse(quoted,1,1) { Ok(r) => { if r[0][0].len() != 1048576 { return 7; } }, Err(_) => { return 8; } };
    let quoted_long = "\"" + too_long + "\"";
    if csv_parse(quoted_long,1,1).is_ok() { return 9; }
    // Include record terminators in the exact encoded output boundary.
    let mut row: Vec<String> = Vec::new();
    row.push(field[0..1048574]);
    let mut output_rows: Vec<Vec<String>> = Vec::new();
    i = 0;
    while i < 16 { output_rows.push(row); i += 1; }
    let output = match csv_encode(output_rows) { Ok(s) => s, Err(_) => { return 10; } };
    if output.len() != 16777216 { return 11; }
    let extra = output + "x";
    if csv_parse(extra,20,1).is_ok() { return 12; }
    let mut extra_row: Vec<String> = Vec::new();
    extra_row.push("");
    output_rows.push(extra_row);
    if csv_encode(output_rows).is_ok() { return 13; }
    match csv_parse("a\n\"b\"suffix",2,1) { Err(e) => { if e.record != 2 || e.byte != 6 { return 14; } }, Ok(_) => { return 15; } };
    match csv_parse("a,b,",1,3) { Ok(r) => { if r[0].len() != 3 || r[0][2].len() != 0 { return 16; } }, Err(_) => { return 17; } };
    0
}
