fn main() -> i64 {
    let mut field = "x";
    let mut i = 0;
    while i < 20 { field = str_concat(field,field); i = i + 1; }
    if str_len(field) != 1048576 { return 1; }
    let rows = match csv_parse(field,1,1) { Result::Ok(r) => r, Result::Err(_) => { return 2; } };
    if str_len(vec_at(vec_at(rows,0),0)) != 1048576 { return 3; }
    let too_long = str_concat(field,"x");
    match csv_parse(too_long,1,1) { Result::Err(e) => { if str_find_from(e.message,"1 MiB",0) < 0 { return 4; } }, Result::Ok(_) => { return 5; } };
    let mut long_row: Vec<String> = vec_new();
    long_row = vec_push(long_row,too_long);
    let mut long_rows: Vec<Vec<String>> = vec_new();
    long_rows = vec_push(long_rows,long_row);
    if result_is_ok(csv_encode(long_rows)) { return 6; }
    let quoted = str_concat3("\"",field,"\"");
    match csv_parse(quoted,1,1) { Result::Ok(r) => { if str_len(vec_at(vec_at(r,0),0)) != 1048576 { return 7; } }, Result::Err(_) => { return 8; } };
    let quoted_long = str_concat3("\"",too_long,"\"");
    if result_is_ok(csv_parse(quoted_long,1,1)) { return 9; }
    // Include record terminators in the exact encoded output boundary.
    let mut row: Vec<String> = vec_new();
    row = vec_push(row,str_substring(field,0,1048574));
    let mut output_rows: Vec<Vec<String>> = vec_new();
    i = 0;
    while i < 16 { output_rows = vec_push(output_rows,row); i = i + 1; }
    let output = match csv_encode(output_rows) { Result::Ok(s) => s, Result::Err(_) => { return 10; } };
    if str_len(output) != 16777216 { return 11; }
    let extra = str_concat(output,"x");
    if result_is_ok(csv_parse(extra,20,1)) { return 12; }
    let mut extra_row: Vec<String> = vec_new();
    extra_row = vec_push(extra_row,"");
    output_rows = vec_push(output_rows,extra_row);
    if result_is_ok(csv_encode(output_rows)) { return 13; }
    match csv_parse("a\n\"b\"suffix",2,1) { Result::Err(e) => { if e.record != 2 || e.byte != 6 { return 14; } }, Result::Ok(_) => { return 15; } };
    match csv_parse("a,b,",1,3) { Result::Ok(r) => { if vec_len(vec_at(r,0)) != 3 || str_len(vec_at(vec_at(r,0),2)) != 0 { return 16; } }, Result::Err(_) => { return 17; } };
    0
}
