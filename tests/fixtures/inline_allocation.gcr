// Alternate compiled fixed allocation with runtime variable-sized allocation.
// Retained values must survive nursery reset, buffer reuse, and child allocation.
struct Item { sequence: i64, text: String }

fn work(seed: i64) -> i64 {
    let mut keep: Array<Item> = Array::new(8);
    let mut i = 0;
    while i < 8 {
        keep[i] = Item { sequence: seed + i, text: i.to_string() };
        i += 1;
    }
    let mut total = 0;
    i = 0;
    while i < 192 {
        let mut scratch: Array<i64> = Array::new(1024);
        scratch[1023] = i;
        let item = Item { sequence: seed + i, text: i.to_string() };
        keep[i % 8] = item;
        total += item.sequence + item.text.len() + scratch[1023];
        i += 1;
    }
    i = 0;
    while i < 8 {
        total += keep[i].sequence;
        i += 1;
    }
    total
}

fn main() -> i64 {
    let sentinel = Item { sequence: 42, text: 42.to_string() };
    let child = Thread::spawn(|| work(1000));
    let result = work(0) + child.join();
    if sentinel.sequence != 42 || !(sentinel.text == "42") { panic("caller root was not refreshed"); }
    if result != 277276 { panic("inline allocation corrupted retained data"); }
    print_int(result);
    0
}
