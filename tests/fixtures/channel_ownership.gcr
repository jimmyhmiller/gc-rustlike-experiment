struct Link { channel: Channel<Link>, n: i64 }
fn abandon_cycle() -> i64 {
    let c: Channel<Link> = Channel::new(1);
    match c.send(Link { channel: c, n: 17 }) {
        Result::Ok(_) => 0,
        Result::Err(_) => 1,
    }
}
fn roundtrip() -> i64 {
    let mut c: Channel<Link> = Channel::new(1);
    let alias = c;
    c.buf = Array::new(0);
    match alias.send(Link { channel: c, n: 42 }) {
        Result::Ok(_) => {}, Result::Err(_) => { return 1; }
    }
    let mut i = 0;
    while i < 40 { let pressure = "channel" + "λ"; i = i + 1; }
    alias.close();
    match c.recv() {
        Option::Some(value) => {
            if value.n != 42 { return 2; }
            value.channel.close();
        },
        Option::None => { return 3; }
    }
    match alias.recv() { Option::Some(_) => 4, Option::None => 0 }
}
fn main() -> i64 {
    let mut i = 0;
    while i < 100 {
        if abandon_cycle() != 0 { return 1; }
        let pressure = "cycle" + "λ";
        i = i + 1;
    }
    if roundtrip() != 0 { return 2; }
    let c: Channel<i64> = Channel::new(1);
    let receiver = Thread::spawn(|| c.recv_value());
    while c.waiting_receivers() == 0 { Thread::sleep(1); }
    i = 0;
    while i < 100 { let pressure = "blocked" + "λ"; i = i + 1; }
    match c.send(42) { Result::Ok(_) => {}, Result::Err(_) => { return 3; } }
    if receiver.join() != 42 || c.waiting_senders() != 0 { return 4; }
    c.close();
    0
}
