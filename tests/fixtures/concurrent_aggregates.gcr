struct Leaf { n: i64 }
#[value] struct Pair { left: Leaf, right: Leaf, sequence: i64 }
struct Holder { pair: Pair, scalar: i64, late: Array<Leaf> }
// Pair/scalar use managed synchronization; late is immutable after publication.
impl Sync for Holder {}
struct Container { holder: Holder }
struct Graph { live: Array<Leaf> }
// Published after initialization; readers never mutate this graph.
impl Sync for Graph {}
impl Sync for Container {}
fn valid(pair: Pair) -> bool {
    pair.left.n == pair.sequence && pair.right.n == 0 - pair.sequence
}
fn writer(published: Atom<Holder>, done: AtomicI64, id: i64) -> i64 {
    let mut i = 1;
    // Completion uses a native atomic load, which does not park during copying.
    while i < 20000 || i % 1024 != 0 || done.load() == 0 {
        let n = id * 1000000 + i;
        let pair = Pair { left: Leaf { n: n }, right: Leaf { n: 0 - n }, sequence: n };
        let mut holder = published.deref();
        holder.pair = pair;
        holder.scalar = id;
        if !valid(holder.pair) { return 81; }
        i = i + 1;
    }
    0
}
// Only Holder retains this graph after construction. Discovery must continue
// through its 120000 leaves after publishing Holder's forwarding pointer.
fn make_holder() -> Holder {
    let mut late: Array<Leaf> = Array::new(120000);
    for i in 0..120000 { late[i] = Leaf { n: i }; }
    Holder { pair: Pair { left: Leaf { n: 0 }, right: Leaf { n: 0 }, sequence: 0 },
        scalar: 1, late: late }
}
fn main() -> i64 {
    let mut live: Array<Leaf> = Array::new(120000);
    for i in 0..120000 { live[i] = Leaf { n: i }; }
    let container = Container { holder: make_holder() };
    let published = Atom::new(container.holder);
    let done = AtomicI64::new(0);
    let graph = Graph { live: live };
    let a = Thread::spawn(|| writer(published, done, 1));
    let b = Thread::spawn(|| writer(published, done, 2));
    let reader = Thread::spawn(|| {
        let mut i = 0;
        while i < 40000 || i % 1024 != 0 || done.load() == 0 {
            let holder = published.deref();
            if !valid(holder.pair) { return 82; }
            let scalar = holder.scalar;
            if scalar != 1 && scalar != 2 { return 83; }
            if graph.live[i % 120000].n != i % 120000 { return 84; }
            i = i + 1;
        }
        0
    });
    let ra = a.join(); let rb = b.join(); let rr = reader.join();
    for i in 0..120000 { if graph.live[i].n != i { return 85; } }
    for i in 0..120000 { if container.holder.late[i].n != i { return 87; } }
    if !valid(container.holder.pair) { return 86; }
    if ra != 0 { ra } else if rb != 0 { rb } else if rr != 0 { rr } else { 42 }
}
