// Immutable after construction: publish the whole summary with pointer CAS.
struct Summary { files: i64, bytes: i64, lines: i64, errors: i64, warnings: i64 }

fn empty() -> Summary { Summary { files: 0, bytes: 0, lines: 0, errors: 0, warnings: 0 } }
fn merge(a: Summary, b: Summary) -> Summary {
    Summary { files: a.files + b.files, bytes: a.bytes + b.bytes, lines: a.lines + b.lines,
        errors: a.errors + b.errors, warnings: a.warnings + b.warnings }
}
fn analyze(text: String) -> Summary {
    let mut lines = 0;
    let mut errors = 0;
    let mut warnings = 0;
    let mut start = 0;
    while start < text.len() {
        let end = text.find_from("\n", start).unwrap_or(text.len());
        if text.find_between("ERROR", start, end).is_some() { errors += 1; }
        if text.find_between("WARN", start, end).is_some() { warnings += 1; }
        lines += 1;
        start = end + 1;
    }
    Summary { files: 1, bytes: text.len(), lines: lines, errors: errors, warnings: warnings }
}
fn worker(paths: Vec<String>, next: AtomicI64, total: Atom<Summary>) -> Result<i64, String> {
    loop {
        let index = next.fetch_add(1);
        if index >= paths.len() { return Ok(0); }
        let path = paths[index];
        let text = match fs_read_text(path, 1048576) {
            Ok(s) => s,
            Err(e) => { return Err(e.to_string()); }
        };
        let delta = analyze(text);
        // The retry callback has no effects: each successful CAS commits one file.
        total.swap(|old: Summary| merge(old, delta));
    }
}
fn worker_count(text: String) -> i64 {
    if text.is_empty() || text.len() > 2 { return 0; }
    let mut n = 0;
    let mut i = 0;
    while i < text.len() {
        let digit = text.byte_at(i) - 48;
        if digit < 0 || digit > 9 { return 0; }
        n = n * 10 + digit;
        i += 1;
    }
    if n >= 1 && n <= 64 { n } else { 0 }
}
fn fail(message: String) -> i64 { stderr_line("gcr-logstats: " + message); 1 }
fn main() -> i64 {
    let args = match process_args() { Ok(a) => a, Err(e) => { return fail(e.to_string()); } };
    if args.len() < 3 || args.len() > 10002 {
        stderr_line("usage: gcr-logstats <workers:1..64> <file> [file ...]");
        return 2;
    }
    let workers = worker_count(args[1]);
    if workers == 0 { return fail("worker count must be an integer from 1 to 64"); }
    let mut paths: Vec<String> = Vec::new();
    let mut i = 2;
    while i < args.len() { paths.push(args[i]); i += 1; }
    let next = AtomicI64::new(0);
    let total: Atom<Summary> = Atom::new(empty());
    let mut threads: Vec<Thread<Result<i64, String>>> = Vec::new();
    let count = if workers < paths.len() { workers } else { paths.len() };
    i = 0;
    while i < count {
        threads.push(Thread::spawn(|| worker(paths, next, total)));
        i += 1;
    }
    let mut failure: Option<String> = None;
    i = 0;
    while i < threads.len() {
        match threads[i].join() {
            Ok(_) => {},
            Err(e) => { match failure { None => { failure = Some(e); }, Some(_) => {} }; }
        };
        i += 1;
    }
    match failure { Some(e) => { return fail(e); }, None => {} };
    let s = total.deref();
    let mut parts: Vec<String> = Vec::new();
    parts.push("{\"files\":"); parts.push(s.files.to_string());
    parts.push(",\"bytes\":"); parts.push(s.bytes.to_string());
    parts.push(",\"lines\":"); parts.push(s.lines.to_string());
    parts.push(",\"error_lines\":"); parts.push(s.errors.to_string());
    parts.push(",\"warning_lines\":"); parts.push(s.warnings.to_string());
    parts.push("}");
    match stdout_line(parts.join("")) { Ok(_) => 0, Err(e) => fail(e.to_string()) }
}
