struct Edge { target: i64, cost: i64 }
struct Node { name: String, edges: Vec<Edge> }
struct Graph { nodes: Vec<Node>, names: HashMap<String, i64>, edges: i64 }
struct Candidate { node: i64, distance: i64 }
struct Route { reachable: bool, distance: i64, path: Vec<String> }
impl Ord for Candidate {
    fn cmp(self, other: Candidate) -> Ordering {
        match self.distance.cmp(other.distance) {
            Ordering::Equal => self.node.cmp(other.node),
            order => order,
        }
    }
}
fn failure(message: String) -> i64 { stderr_line("gcr-routes: " + message); 1 }
fn node(mut graph: Graph, name: String) -> Result<i64, String> {
    match graph.names.get(name) {
        Some(index) => Ok(index),
        None => {
            let index = graph.nodes.len();
            if index >= 5000 { return Err("node count exceeds 5000"); }
            graph.names.insert(name, index);
            graph.nodes.push(Node { name: name, edges: Vec::new() });
            Ok(index)
        }
    }
}
fn load(text: String) -> Result<Graph, String> {
    let rows = match csv_parse(text, 10001, 3) { Ok(r) => r, Err(e) => { return Err(e.to_string()); } };
    if rows.is_empty() { return Err("missing from,to,cost header"); }
    let header = rows[0];
    if header.len() != 3 || header[0] != "from" || header[1] != "to" || header[2] != "cost" { return Err("expected from,to,cost header"); }
    let mut graph = Graph { nodes: Vec::new(), names: HashMap::new(), edges: 0 };
    let mut i = 1;
    while i < rows.len() {
        let row = rows[i];
        if row.len() != 3 { return Err("wrong field count at record " + (i + 1).to_string()); }
        let from = row[0];
        let to = row[1];
        if from.is_empty() || to.is_empty() { return Err("node names must be nonempty"); }
        let cost = match row[2].trim().parse_i64() { Some(n) => n, None => { return Err("invalid cost at record " + (i + 1).to_string()); } };
        if cost < 0 { return Err("edge costs must be nonnegative"); }
        let source = node(graph, from)?;
        let target = node(graph, to)?;
        let mut source_node = graph.nodes[source];
        source_node.edges.push(Edge { target: target, cost: cost });
        graph.edges += 1;
        i += 1;
    }
    Ok(graph)
}
fn connected(graph: Graph, from: i64, to: i64) -> bool {
    let mut seen: Array<bool> = Array::new(graph.nodes.len());
    let mut queue: Vec<i64> = Vec::new();
    queue.push(from);
    seen[from] = true;
    let mut head = 0;
    while head < queue.len() {
        let current = queue[head];
        if current == to { return true; }
        let edges = graph.nodes[current].edges;
        let mut i = 0;
        while i < edges.len() {
            let target = edges[i].target;
            if !seen[target] {
                seen[target] = true;
                queue.push(target);
            }
            i += 1;
        }
        head += 1;
    }
    false
}
fn route(graph: Graph, from: String, to: String) -> Result<Route, String> {
    let source = match graph.names.get(from) { Some(n) => n, None => { return Err("unknown source: " + from); } };
    let target = match graph.names.get(to) { Some(n) => n, None => { return Err("unknown destination: " + to); } };
    let mut distances: Array<i64> = Array::new(graph.nodes.len());
    let mut reached: Array<bool> = Array::new(graph.nodes.len());
    let mut previous: Array<i64> = Array::new(graph.nodes.len());
    let mut queue: MinHeap<Candidate> = MinHeap::new();
    reached[source] = true;
    previous[source] = 0 - 1;
    queue.push(Candidate { node: source, distance: 0 });
    while !queue.is_empty() {
        let current = queue.pop().expect("route queue invariant");
        if current.distance != distances[current.node] { continue; }
        if current.node == target { break; }
        let edges = graph.nodes[current.node].edges;
        let mut i = 0;
        while i < edges.len() {
            let edge = edges[i];
            // Ignore candidates outside i64; a separate reachability check
            // distinguishes an unreachable target from an unrepresentable path.
            match current.distance.checked_add(edge.cost) {
                Some(distance) => {
                    if !reached[edge.target] || distance < distances[edge.target] {
                        reached[edge.target] = true;
                        distances[edge.target] = distance;
                        previous[edge.target] = current.node;
                        queue.push(Candidate { node: edge.target, distance: distance });
                    }
                },
                None => {}
            };
            i += 1;
        }
    }
    if !reached[target] {
        if connected(graph, source, target) { return Err("shortest route cost exceeds i64 range"); }
        return Ok(Route { reachable: false, distance: 0, path: Vec::new() });
    }
    let mut reverse: Vec<String> = Vec::new();
    let mut index = target;
    while index >= 0 {
        if reverse.len() >= graph.nodes.len() { return Err("predecessor cycle invariant"); }
        reverse.push(graph.nodes[index].name);
        index = previous[index];
    }
    let mut path: Vec<String> = Vec::new();
    index = reverse.len();
    while index > 0 { index -= 1; path.push(reverse[index]); }
    Ok(Route { reachable: true, distance: distances[target], path: path })
}
fn render(result: Route, graph: Graph, from: String, to: String) -> String {
    let mut parts: Vec<String> = Vec::new();
    parts.push("{\"from\":" + json_quote(from) + ",\"to\":");
    parts.push(json_quote(to));
    parts.push(if result.reachable { ",\"reachable\":true,\"distance\":" } else { ",\"reachable\":false,\"distance\":" });
    parts.push(if result.reachable { result.distance.to_string() } else { "null" });
    parts.push(",\"path\":[");
    let mut i = 0;
    while i < result.path.len() { if i > 0 { parts.push(","); } parts.push(json_quote(result.path[i])); i += 1; }
    parts.push("],\"nodes\":" + graph.nodes.len().to_string() + ",\"edges\":");
    parts.push(graph.edges.to_string() + "}");
    parts.join("")
}
fn main() -> i64 {
    let args = match process_args() { Ok(a) => a, Err(e) => { return failure(e.to_string()); } };
    if args.len() != 5 { stderr_line("usage: gcr-routes <edges.csv> <from> <to> <output.json|->"); return 2; }
    let text = match fs_read_text(args[1], 1048576) { Ok(s) => s, Err(e) => { return failure(e.to_string()); } };
    let graph = match load(text) { Ok(g) => g, Err(e) => { return failure(e); } };
    let from = args[2];
    let to = args[3];
    let result = match route(graph, from, to) { Ok(r) => r, Err(e) => { return failure(e); } };
    let json = render(result, graph, from, to);
    let output = args[4];
    let written = if output == "-" { stdout_line(json) } else { fs_write_text_atomic(output, json + "\n") };
    match written { Ok(_) => 0, Err(e) => failure(e.to_string()) }
}
