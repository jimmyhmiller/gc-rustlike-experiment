struct Group { name: String, count: i64, sum: i64, minimum: i64, maximum: i64 }
struct FileReport { rows: i64, bytes: i64, total: i64, groups: Vec<Group> }
struct Completion { index: i64, report: Result<FileReport, String> }
impl Ord for Group { fn cmp(self, other: Group) -> Ordering { self.name.cmp(other.name) } }
fn failure(message: String) -> i64 { stderr_line("gcr-csvreport: " + message); 1 }
fn column(header: Vec<String>, name: String) -> Option<i64> {
    let mut i = 0;
    while i < header.len() { if header[i] == name { return Some(i); } i += 1; }
    None
}
fn report(text: String, group_column: String, value_column: String) -> Result<FileReport, String> {
    let rows = match csv_parse(text, 20001, 256) {
        Ok(r) => r,
        Err(e) => { return Err(e.to_string()); }
    };
    if rows.is_empty() { return Err("missing CSV header"); }
    let header = rows[0];
    let mut names: HashMap<String, bool> = HashMap::new();
    let mut c = 0;
    while c < header.len() {
        let name = header[c];
        if name.is_empty() || names.contains_key(name) { return Err("CSV headers must be nonempty and unique"); }
        names.insert(name, true);
        c += 1;
    }
    let group_index = match column(header, group_column) { Some(i) => i, None => { return Err("missing column: " + group_column); } };
    let value_index = match column(header, value_column) { Some(i) => i, None => { return Err("missing column: " + value_column); } };
    let mut groups: HashMap<String, Group> = HashMap::new();
    let mut total = 0;
    let mut r = 1;
    while r < rows.len() {
        let row = rows[r];
        if row.len() != header.len() { return Err("wrong field count at record " + (r + 1).to_string()); }
        let key = row[group_index];
        let value = match row[value_index].trim().parse_i64() {
            Some(n) => n,
            None => { return Err("invalid signed integer at record " + (r + 1).to_string()); }
        };
        total = match total.checked_add(value) { Some(n) => n, None => { return Err("file total overflow"); } };
        match groups.get(key) {
            Some(mut group) => {
                group.sum = match group.sum.checked_add(value) { Some(n) => n, None => { return Err("group total overflow"); } };
                group.count += 1;
                group.minimum = group.minimum.min(value);
                group.maximum = group.maximum.max(value);
            },
            None => {
                if groups.len() >= 10000 { return Err("group count exceeds 10000"); }
                groups.insert(key, Group { name: key, count: 1, sum: value, minimum: value, maximum: value });
            }
        };
        r += 1;
    }
    Ok(FileReport { rows: rows.len() - 1, bytes: text.len(), total: total, groups: groups.values() })
}
fn worker(paths: Vec<String>, next: AtomicI64, done: Channel<Completion>, group: String, value: String) -> i64 {
    let mut count = 0;
    loop {
        let index = next.fetch_add(1);
        if index >= paths.len() { return count; }
        let path = paths[index];
        let result = match fs_read_text(path, 524288) {
            Ok(text) => report(text, group, value),
            Err(e) => Err(e.to_string())
        };
        match done.send(Completion { index: index, report: result }) {
            Ok(_) => {},
            Err(_) => { return count; }
        };
        count += 1;
    }
}
fn merge(reports: Array<Result<FileReport, String>>, paths: Vec<String>) -> Result<FileReport, String> {
    let mut groups: HashMap<String, Group> = HashMap::new();
    let mut rows = 0;
    let mut bytes = 0;
    let mut total = 0;
    let mut i = 0;
    while i < reports.len() {
        let file = match reports[i] {
            Ok(f) => f,
            Err(e) => { return Err(paths[i] + ": " + e); }
        };
        rows += file.rows;
        if rows > 200000 { return Err("total row count exceeds 200000"); }
        bytes += file.bytes;
        total = match total.checked_add(file.total) { Some(n) => n, None => { return Err("combined total overflow"); } };
        let mut g = 0;
        while g < file.groups.len() {
            let incoming = file.groups[g];
            match groups.get(incoming.name) {
                Some(mut existing) => {
                    existing.sum = match existing.sum.checked_add(incoming.sum) { Some(n) => n, None => { return Err("combined group total overflow"); } };
                    existing.count += incoming.count;
                    existing.minimum = existing.minimum.min(incoming.minimum);
                    existing.maximum = existing.maximum.max(incoming.maximum);
                },
                None => {
                    if groups.len() >= 10000 { return Err("group count exceeds 10000"); }
                    groups.insert(incoming.name, incoming);
                }
            };
            g += 1;
        }
        i += 1;
    }
    let mut sorted = groups.values();
    sorted.sort();
    Ok(FileReport { rows: rows, bytes: bytes, total: total, groups: sorted })
}
fn render(summary: FileReport, files: i64) -> String {
    let mut parts: Vec<String> = Vec::new();
    parts.push("{\"files\":" + files.to_string() + ",\"rows\":");
    parts.push(summary.rows.to_string() + ",\"bytes\":" + summary.bytes.to_string());
    parts.push(",\"total\":" + summary.total.to_string() + ",\"groups\":[");
    let mut i = 0;
    while i < summary.groups.len() {
        if i > 0 { parts.push(","); }
        let g = summary.groups[i];
        parts.push("{\"key\":" + json_quote(g.name) + ",\"count\":");
        parts.push(g.count.to_string() + ",\"sum\":" + g.sum.to_string());
        parts.push(",\"min\":" + g.minimum.to_string() + ",\"max\":");
        parts.push(g.maximum.to_string() + "}");
        i += 1;
    }
    parts.push("]}");
    parts.join("")
}
fn main() -> i64 {
    let args = match process_args() { Ok(a) => a, Err(e) => { return failure(e.to_string()); } };
    if args.len() < 6 || args.len() > 37 {
        stderr_line("usage: gcr-csvreport <workers:1..8> <group-column> <value-column> <output.json|-> <file> [file ...] (at most 32 files)");
        return 2;
    }
    let workers = match args[1].parse_i64() { Some(n) => n, None => 0 };
    if workers < 1 || workers > 8 { return failure("worker count must be between 1 and 8"); }
    let group = args[2];
    let value = args[3];
    let output = args[4];
    let mut paths: Vec<String> = Vec::new();
    let mut i = 5;
    while i < args.len() { paths.push(args[i]); i += 1; }
    let count = workers.min(paths.len());
    let done: Channel<Completion> = Channel::new(count);
    let next = AtomicI64::new(0);
    let mut threads: Vec<Thread<i64>> = Vec::new();
    i = 0;
    while i < count { threads.push(Thread::spawn(|| worker(paths, next, done, group, value))); i += 1; }
    let mut reports: Array<Result<FileReport, String>> = Array::new(paths.len());
    i = 0;
    while i < paths.len() {
        let completion = done.recv_value();
        reports[completion.index] = completion.report;
        i += 1;
    }
    done.close();
    i = 0;
    let mut completed = 0;
    while i < threads.len() { completed += threads[i].join(); i += 1; }
    if completed != paths.len() { return failure("worker completion count mismatch"); }
    let summary = match merge(reports, paths) { Ok(s) => s, Err(e) => { return failure(e); } };
    let json = render(summary, paths.len());
    let written = if output == "-" { stdout_line(json) } else { fs_write_text_atomic(output, json + "\n") };
    match written { Ok(_) => 0, Err(e) => failure(e.to_string()) }
}
