#[value]
pub struct Document { path: String, text: String }
struct Task { path: String, relative: String, depth: i64 }
pub struct Scan { documents: Vec<Document>, skipped: i64, bytes: i64 }

fn excluded(name: String) -> bool {
    name == ".git" || name == "target" || name == ".worktrees" || name == "node_modules" || name == ".gcr-search.index"
}

pub fn scan(root: String, destination: String) -> Result<Scan, String> {
    let mut pending: Vec<Task> = Vec::new();
    pending.push(Task { path: root, relative: "", depth: 0 });
    let mut docs: Vec<Document> = Vec::new();
    let mut skipped = 0;
    let mut bytes = 0;
    let mut visited = 0;
    while !pending.is_empty() {
        visited += 1;
        if visited > 100000 { return Err("scan exceeds 100000 path limit"); }
        let task = pending.pop().unwrap();
        if task.depth > 128 { return Err("directory depth limit: " + task.path); }
        let kind = match fs_kind(task.path) { Ok(k) => k, Err(e) => { return Err(e.to_string()); } };
        if task.depth == 0 && kind != 2 { return Err("index root must be a directory"); }
        if kind == 2 {
            let entries = match fs_read_dir(task.path) { Ok(es) => es, Err(e) => { return Err(e.to_string()); } };
            let mut i = entries.len() - 1;
            while i >= 0 {
                let name = match entries.get(i) { Some(n) => n, None => "" };
                if !excluded(name) {
                    let path = path_join(task.path, name);
                    if path != destination {
                        if pending.len() >= 10000 { return Err("scan exceeds 10000 queued path limit"); }
                        pending.push(Task { path: path, relative: path_join(task.relative, name), depth: task.depth + 1 });
                    }
                }
                i -= 1;
            }
        } else if kind == 1 {
            match fs_read_text(task.path, 1048576) {
                Ok(text) => {
                    if text.contains("\0") { skipped += 1; }
                    else {
                        bytes += text.len();
                        if bytes > 16777216 || docs.len() >= 10000 { return Err("index exceeds 16 MiB or 10000 document limit"); }
                        docs.push(Document { path: task.relative, text: text });
                    }
                },
                Err(e) => {
                    if e.kind == 3 { skipped += 1; }
                    else { return Err(e.to_string()); }
                }
            }
        } else { skipped += 1; }
    }
    Ok(Scan { documents: docs, skipped: skipped, bytes: bytes })
}

// Versioned length framing, in UTF-8 bytes. Names/text may contain newlines,
// NULs, colons, and Unicode without confusing the framing.
pub fn encode(docs: Vec<Document>) -> String {
    let mut parts: Vec<String> = Vec::new();
    parts.push("GCRSEARCH1\n");
    parts.push(docs.len().to_string());
    parts.push("\n");
    let mut i = 0;
    while i < docs.len() {
        let doc = docs[i];
        parts.push(doc.path.len().to_string());
        parts.push("\n");
        parts.push(doc.path);
        parts.push(doc.text.len().to_string());
        parts.push("\n");
        parts.push(doc.text);
        i += 1;
    }
    parts.join("")
}

struct Cursor { offset: i64 }
fn number(text: String, mut cursor: Cursor) -> Result<i64, String> {
    let mut value = 0;
    let mut digits = 0;
    while cursor.offset < text.len() {
        let b = text.byte_at(cursor.offset);
        cursor.offset += 1;
        if b == 10 {
            if digits == 0 { return Err("empty index length"); }
            return Ok(value);
        }
        if b < 48 || b > 57 { return Err("invalid index length"); }
        let digit = b - 48;
        if value > (9223372036854775807 - digit) / 10 { return Err("index length overflow"); }
        value = value * 10 + digit;
        digits += 1;
    }
    Err("truncated index length")
}
fn framed(text: String, mut cursor: Cursor) -> Result<String, String> {
    let size = match number(text, cursor) { Ok(n) => n, Err(e) => { return Err(e); } };
    if size > text.len() - cursor.offset { return Err("truncated index record"); }
    let out = text.substring(cursor.offset, cursor.offset + size);
    cursor.offset += size;
    Ok(out)
}
pub fn decode(text: String) -> Result<Vec<Document>, String> {
    if !text.starts_with("GCRSEARCH1\n") { return Err("unsupported index format"); }
    let cursor = Cursor { offset: 11 };
    let count = match number(text, cursor) { Ok(n) => n, Err(e) => { return Err(e); } };
    if count > 10000 || count > text.len() / 4 { return Err("invalid document count"); }
    let mut docs: Vec<Document> = Vec::new();
    let mut i = 0;
    while i < count {
        let path = match framed(text, cursor) { Ok(s) => s, Err(e) => { return Err(e); } };
        let body = match framed(text, cursor) { Ok(s) => s, Err(e) => { return Err(e); } };
        if path.is_empty() || path.starts_with("/") { return Err("invalid document path"); }
        docs.push(Document { path: path, text: body });
        i += 1;
    }
    if cursor.offset != text.len() { return Err("trailing data in index"); }
    Ok(docs)
}
