struct Task { name: String, duration: i64, depends: Vec<i64>, children: Vec<i64> }
struct Ready { name: String, index: i64 }
struct Running { name: String, index: i64, finish: i64, worker: i64 }
struct Schedule { tasks: Vec<Task>, starts: Array<i64>, finishes: Array<i64>, workers: Array<i64>, makespan: i64, critical: i64 }
impl Ord for Ready { fn cmp(self, other: Ready) -> i64 { str_compare(self.name, other.name) } }
impl Ord for Running {
    fn cmp(self, other: Running) -> i64 {
        if self.finish < other.finish { 0 - 1 } else if self.finish > other.finish { 1 }
        else { str_compare(self.name, other.name) }
    }
}
fn failure(message: String) -> i64 { stderr_line(str_concat("gcr-buildplan: ", message)); 1 }
fn load(text: String) -> Result<Vec<Task>, String> {
    let rows = match csv_parse(text, 2001, 3) { Result::Ok(r) => r, Result::Err(e) => { return Result::Err(csv_error_message(e)); } };
    if vec_len(rows) == 0 { return Result::Err("missing task,duration,depends header"); }
    let header = vec_at(rows, 0);
    if vec_len(header) != 3 || str_eq(vec_at(header, 0), "task") == false || str_eq(vec_at(header, 1), "duration") == false || str_eq(vec_at(header, 2), "depends") == false {
        return Result::Err("expected task,duration,depends header");
    }
    let mut tasks: Vec<Task> = vec_new();
    let mut names: MapStr<i64> = mapstr_new();
    let mut r = 1;
    while r < vec_len(rows) {
        let row = vec_at(rows, r);
        if vec_len(row) != 3 { return Result::Err(str_concat("wrong field count at record ", to_string(r + 1))); }
        let name = str_trim(vec_at(row, 0));
        if str_len(name) == 0 || str_contains_byte(name, 59) { return Result::Err("task names must be nonempty and contain no semicolons"); }
        if mapstr_contains(names, name) { return Result::Err(str_concat("duplicate task: ", name)); }
        let duration = match parse_int(str_trim(vec_at(row, 1))) { Option::Some(n) => n, Option::None => { return Result::Err(str_concat("invalid duration for ", name)); } };
        if duration < 0 { return Result::Err(str_concat("negative duration for ", name)); }
        names = mapstr_insert(names, name, vec_len(tasks));
        tasks = vec_push(tasks, Task { name: name, duration: duration, depends: vec_new(), children: vec_new() });
        r = r + 1;
    }
    let mut edges = 0;
    r = 0;
    while r < vec_len(tasks) {
        let mut task = vec_at(tasks, r);
        let text = str_trim(vec_at(vec_at(rows, r + 1), 2));
        if str_len(text) > 0 {
            let dependencies = str_split_byte(text, 59);
            let mut i = 0;
            while i < vec_len(dependencies) {
                let name = str_trim(vec_at(dependencies, i));
                let index = match mapstr_get(names, name) { Option::Some(n) => n, Option::None => { return Result::Err(str_concat("unknown dependency: ", name)); } };
                if index == r { return Result::Err(str_concat("self dependency: ", task.name)); }
                if vec_contains_i64(task.depends, index) { return Result::Err(str_concat("duplicate dependency for ", task.name)); }
                task.depends = vec_push(task.depends, index);
                let mut parent = vec_at(tasks, index);
                parent.children = vec_push(parent.children, r);
                edges = edges + 1;
                if edges > 10000 { return Result::Err("dependency count exceeds 10000"); }
                i = i + 1;
            }
        }
        r = r + 1;
    }
    Result::Ok(tasks)
}
fn schedule(tasks: Vec<Task>, worker_count: i64) -> Result<Schedule, String> {
    let count = vec_len(tasks);
    let mut pending: Array<i64> = array_new(count);
    let mut earliest: Array<i64> = array_new(count);
    let mut starts: Array<i64> = array_new(count);
    let mut finishes: Array<i64> = array_new(count);
    let mut assignments: Array<i64> = array_new(count);
    let mut complete: Array<bool> = array_new(count);
    let mut busy: Array<bool> = array_new(worker_count);
    let mut ready: MinHeap<Ready> = heap_new();
    let mut running: MinHeap<Running> = heap_new();
    let mut i = 0;
    while i < count {
        let task = vec_at(tasks, i);
        array_set(pending, i, vec_len(task.depends));
        if vec_len(task.depends) == 0 { heap_push(ready, Ready { name: task.name, index: i }); }
        i = i + 1;
    }
    let mut completed = 0;
    let mut now = 0;
    let mut critical = 0;
    while completed < count {
        while heap_len(running) < worker_count && heap_len(ready) > 0 {
            let job = opt_expect(heap_pop(ready), "ready queue invariant");
            let task = vec_at(tasks, job.index);
            let end = match checked_add_i64(now, task.duration) { Option::Some(n) => n, Option::None => { return Result::Err("schedule duration overflow"); } };
            let mut worker = 0;
            while array_get_unchecked(busy, worker) { worker = worker + 1; }
            array_set(busy, worker, true);
            array_set(starts, job.index, now);
            array_set(finishes, job.index, end);
            array_set(assignments, job.index, worker + 1);
            heap_push(running, Running { name: task.name, index: job.index, finish: end, worker: worker });
        }
        if heap_len(running) == 0 {
            let mut blocked: Vec<String> = vec_new();
            i = 0;
            while i < count { if array_get_unchecked(complete, i) == false { blocked = vec_push(blocked, vec_at(tasks, i).name); } i = i + 1; }
            return Result::Err(str_concat("dependency cycle or blocked tasks: ", str_join(vec_sort(blocked), ", ")));
        }
        now = opt_expect(heap_peek(running), "running queue invariant").finish;
        // Finish every job at this instant before dispatching lexically ready jobs.
        loop {
            match heap_peek(running) {
                Option::Some(event) => { if event.finish != now { break; } },
                Option::None => { break; }
            };
            let event = opt_expect(heap_pop(running), "running queue invariant");
            let task = vec_at(tasks, event.index);
            array_set(busy, event.worker, false);
            array_set(complete, event.index, true);
            completed = completed + 1;
            let path_end = match checked_add_i64(array_get_unchecked(earliest, event.index), task.duration) { Option::Some(n) => n, Option::None => { return Result::Err("critical path overflow"); } };
            critical = max_i64(critical, path_end);
            i = 0;
            while i < vec_len(task.children) {
                let child = vec_at(task.children, i);
                let remaining = array_get_unchecked(pending, child) - 1;
                array_set(pending, child, remaining);
                array_set(earliest, child, max_i64(array_get_unchecked(earliest, child), path_end));
                if remaining == 0 { heap_push(ready, Ready { name: vec_at(tasks, child).name, index: child }); }
                i = i + 1;
            }
        }
    }
    Result::Ok(Schedule { tasks: tasks, starts: starts, finishes: finishes, workers: assignments, makespan: now, critical: critical })
}
fn render(plan: Schedule, workers: i64) -> String {
    let mut parts: Vec<String> = vec_new();
    parts = vec_push(parts, str_concat3("{\"workers\":", to_string(workers), ",\"makespan\":"));
    parts = vec_push(parts, str_concat3(to_string(plan.makespan), ",\"critical_path\":", to_string(plan.critical)));
    parts = vec_push(parts, ",\"tasks\":[");
    let mut order: Vec<Ready> = vec_new();
    let mut i = 0;
    while i < vec_len(plan.tasks) { order = vec_push(order, Ready { name: vec_at(plan.tasks, i).name, index: i }); i = i + 1; }
    order = vec_sort(order);
    i = 0;
    while i < vec_len(order) {
        if i > 0 { parts = vec_push(parts, ","); }
        let job = vec_at(order, i);
        parts = vec_push(parts, str_concat3("{\"task\":", json_quote(job.name), ",\"start\":"));
        parts = vec_push(parts, str_concat3(to_string(array_get_unchecked(plan.starts, job.index)), ",\"finish\":", to_string(array_get_unchecked(plan.finishes, job.index))));
        parts = vec_push(parts, str_concat3(",\"worker\":", to_string(array_get_unchecked(plan.workers, job.index)), "}"));
        i = i + 1;
    }
    parts = vec_push(parts, "]}");
    str_join(parts, "")
}
fn main() -> i64 {
    let args = match process_args() { Result::Ok(a) => a, Result::Err(e) => { return failure(io_error_message(e)); } };
    if array_len(args) != 4 { stderr_line("usage: gcr-buildplan <tasks.csv> <workers:1..64> <output.json|->"); return 2; }
    let workers = match parse_int(array_get_unchecked(args, 2)) { Option::Some(n) => n, Option::None => 0 };
    if workers < 1 || workers > 64 { return failure("worker count must be between 1 and 64"); }
    let text = match fs_read_text(array_get_unchecked(args, 1), 1048576) { Result::Ok(s) => s, Result::Err(e) => { return failure(io_error_message(e)); } };
    let tasks = match load(text) { Result::Ok(t) => t, Result::Err(e) => { return failure(e); } };
    let plan = match schedule(tasks, workers) { Result::Ok(p) => p, Result::Err(e) => { return failure(e); } };
    let json = render(plan, workers);
    let output = array_get_unchecked(args, 3);
    let result = if str_eq(output, "-") { stdout_line(json) } else { fs_write_text_atomic(output, str_concat(json, "\n")) };
    match result { Result::Ok(_) => 0, Result::Err(e) => failure(io_error_message(e)) }
}
