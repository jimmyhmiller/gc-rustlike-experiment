// n-body — gc-rust port of the Computer Language Benchmarks Game algorithm
// (the classic 5-body solar-system simulation, single-threaded). Faithful
// translation of the same algorithm as nbody.go / .rs / .java in this directory
// (based on the C program by Christoph Bauer), so the printed energy is directly
// comparable. Bodies are held in parallel f64 arrays because gc-rust value
// structs are immutable; the arithmetic is identical.
//
// Algorithm origin: The Computer Language Benchmarks Game (BSD-3-Clause); this
// gc-rust translation written for the gc-rust benchmark comparison.
//
// STEPS is hardcoded to match the CLI arg the harness passes to the other langs.

fn energy(x: Array<f64>, y: Array<f64>, z: Array<f64>,
          vx: Array<f64>, vy: Array<f64>, vz: Array<f64>,
          mass: Array<f64>, nb: i64) -> f64 {
    let mut e = 0.0;
    let mut i = 0;
    while i < nb {
        let mi = mass[i];
        e = e + 0.5 * mi *
            (vx[i] * vx[i] +
             vy[i] * vy[i] +
             vz[i] * vz[i]);
        let mut j = i + 1;
        while j < nb {
            let dx = x[i] - x[j];
            let dy = y[i] - y[j];
            let dz = z[i] - z[j];
            let dist = sqrt(dx * dx + dy * dy + dz * dz);
            e = e - mi * mass[j] / dist;
            j = j + 1;
        }
        i = i + 1;
    }
    e
}

fn advance(mut x: Array<f64>, mut y: Array<f64>, mut z: Array<f64>,
           mut vx: Array<f64>, mut vy: Array<f64>, mut vz: Array<f64>,
           mass: Array<f64>, nb: i64, dt: f64) -> i64 {
    let mut i = 0;
    while i < nb {
        let mut ivx = vx[i];
        let mut ivy = vy[i];
        let mut ivz = vz[i];
        let mi = mass[i];
        let mut j = i + 1;
        while j < nb {
            let dx = x[i] - x[j];
            let dy = y[i] - y[j];
            let dz = z[i] - z[j];
            let d2 = dx * dx + dy * dy + dz * dz;
            let dist = sqrt(d2);
            let mag = dt / (d2 * dist);
            let mj = mass[j];
            ivx = ivx - dx * mj * mag;
            ivy = ivy - dy * mj * mag;
            ivz = ivz - dz * mj * mag;
            vx[j] = vx[j] + dx * mi * mag;
            vy[j] = vy[j] + dy * mi * mag;
            vz[j] = vz[j] + dz * mi * mag;
            j = j + 1;
        }
        vx[i] = ivx;
        vy[i] = ivy;
        vz[i] = ivz;
        x[i] = x[i] + dt * ivx;
        y[i] = y[i] + dt * ivy;
        z[i] = z[i] + dt * ivz;
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let steps = 5000000;
    let pi = 3.141592653589793;
    let solar_mass = 4.0 * pi * pi;
    let year = 365.24;
    let nb = 5;

    let mut x: Array<f64> = Array::new(nb);
    let mut y: Array<f64> = Array::new(nb);
    let mut z: Array<f64> = Array::new(nb);
    let mut vx: Array<f64> = Array::new(nb);
    let mut vy: Array<f64> = Array::new(nb);
    let mut vz: Array<f64> = Array::new(nb);
    let mut mass: Array<f64> = Array::new(nb);

    // Sun
    x[0] = 0.0;  y[0] = 0.0;  z[0] = 0.0;
    vx[0] = 0.0; vy[0] = 0.0; vz[0] = 0.0;
    mass[0] = solar_mass;

    // Jupiter
    x[1] = 4.84143144246472090e+00;
    y[1] = -1.16032004402742839e+00;
    z[1] = -1.03622044471123109e-01;
    vx[1] = 1.66007664274403694e-03 * year;
    vy[1] = 7.69901118419740425e-03 * year;
    vz[1] = -6.90460016972063023e-05 * year;
    mass[1] = 9.54791938424326609e-04 * solar_mass;

    // Saturn
    x[2] = 8.34336671824457987e+00;
    y[2] = 4.12479856412430479e+00;
    z[2] = -4.03523417114321381e-01;
    vx[2] = -2.76742510726862411e-03 * year;
    vy[2] = 4.99852801234917238e-03 * year;
    vz[2] = 2.30417297573763929e-05 * year;
    mass[2] = 2.85885980666130812e-04 * solar_mass;

    // Uranus
    x[3] = 1.28943695621391310e+01;
    y[3] = -1.51111514016986312e+01;
    z[3] = -2.23307578892655734e-01;
    vx[3] = 2.96460137564761618e-03 * year;
    vy[3] = 2.37847173959480950e-03 * year;
    vz[3] = -2.96589568540237556e-05 * year;
    mass[3] = 4.36624404335156298e-05 * solar_mass;

    // Neptune
    x[4] = 1.53796971148509165e+01;
    y[4] = -2.59193146099879641e+01;
    z[4] = 1.79258772950371181e-01;
    vx[4] = 2.68067772490389322e-03 * year;
    vy[4] = 1.62824170038242295e-03 * year;
    vz[4] = -9.51592254519715870e-05 * year;
    mass[4] = 5.15138902046611451e-05 * solar_mass;

    // offset momentum so the sun cancels the system's total momentum
    let mut px = 0.0;
    let mut py = 0.0;
    let mut pz = 0.0;
    let mut i = 0;
    while i < nb {
        px = px + vx[i] * mass[i];
        py = py + vy[i] * mass[i];
        pz = pz + vz[i] * mass[i];
        i = i + 1;
    }
    vx[0] = 0.0 - px / solar_mass;
    vy[0] = 0.0 - py / solar_mass;
    vz[0] = 0.0 - pz / solar_mass;

    print_float(energy(x, y, z, vx, vy, vz, mass, nb));
    let mut s = 0;
    while s < steps {
        let _a = advance(x, y, z, vx, vy, vz, mass, nb, 0.01);
        s = s + 1;
    }
    print_float(energy(x, y, z, vx, vy, vz, mass, nb));
    0
}
