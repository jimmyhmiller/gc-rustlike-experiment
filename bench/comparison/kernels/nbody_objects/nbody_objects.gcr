// n-body — gc-rust port of the Computer Language Benchmarks Game algorithm
// (the classic 5-body solar-system simulation, single-threaded). Faithful
// translation of the same algorithm as nbody.go / .rs / .java in this directory
// (based on the C program by Christoph Bauer), so the printed energy is directly
// comparable. This diagnostic variant stores mutable Body objects in an
// array, with per-body caching and multiplication grouping matching Java.
//
// Algorithm origin: The Computer Language Benchmarks Game (BSD-3-Clause); this
// gc-rust translation written for the gc-rust benchmark comparison.
//
// STEPS is hardcoded to match the CLI arg the harness passes to the other langs.

// Object-layout variant: mirrors Java's Body[] and caches per-body values.
// The original structure-of-arrays port remains a separate benchmark.
struct Body { x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, mass: f64 }

fn energy(bodies: Array<Body>, count: i64) -> f64 {
    let mut e = 0.0;
    let mut i = 0;
    while i < count {
        let bi = array_get_unchecked(bodies, i);
        let xi = bi.x; let yi = bi.y; let zi = bi.z;
        let vx = bi.vx; let vy = bi.vy; let vz = bi.vz;
        let mass = bi.mass;
        e = e + 0.5 * mass * (vx * vx + vy * vy + vz * vz);
        let mut j = i + 1;
        while j < count {
            let bj = array_get_unchecked(bodies, j);
            let dx = xi - bj.x; let dy = yi - bj.y; let dz = zi - bj.z;
            e = e - mass * bj.mass / sqrt(dx * dx + dy * dy + dz * dz);
            j = j + 1;
        }
        i = i + 1;
    }
    e
}

fn advance(bodies: Array<Body>, count: i64, dt: f64) -> i64 {
    let mut i = 0;
    while i < count {
        let mut bi = array_get_unchecked(bodies, i);
        let xi = bi.x; let yi = bi.y; let zi = bi.z;
        let mass = bi.mass;
        let mut vx = bi.vx; let mut vy = bi.vy; let mut vz = bi.vz;
        let mut j = i + 1;
        while j < count {
            let mut bj = array_get_unchecked(bodies, j);
            let dx = xi - bj.x; let dy = yi - bj.y; let dz = zi - bj.z;
            let d2 = dx * dx + dy * dy + dz * dz;
            let mag = dt / (d2 * sqrt(d2));
            let mj_mag = bj.mass * mag;
            vx = vx - dx * mj_mag;
            vy = vy - dy * mj_mag;
            vz = vz - dz * mj_mag;
            let mi_mag = mass * mag;
            bj.vx = bj.vx + dx * mi_mag;
            bj.vy = bj.vy + dy * mi_mag;
            bj.vz = bj.vz + dz * mi_mag;
            j = j + 1;
        }
        bi.vx = vx; bi.vy = vy; bi.vz = vz;
        bi.x = xi + dt * vx; bi.y = yi + dt * vy; bi.z = zi + dt * vz;
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let steps = 5000000;
    let pi = 3.141592653589793;
    let solar_mass = 4.0 * pi * pi;
    let year = 365.24;
    let count = 5;
    let mut bodies: Array<Body> = array_new(count);
    array_set(bodies, 0, Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass });
    array_set(bodies, 1, Body { x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03 * year, vy: 7.69901118419740425e-03 * year, vz: -6.90460016972063023e-05 * year, mass: 9.54791938424326609e-04 * solar_mass });
    array_set(bodies, 2, Body { x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03 * year, vy: 4.99852801234917238e-03 * year, vz: 2.30417297573763929e-05 * year, mass: 2.85885980666130812e-04 * solar_mass });
    array_set(bodies, 3, Body { x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03 * year, vy: 2.37847173959480950e-03 * year, vz: -2.96589568540237556e-05 * year, mass: 4.36624404335156298e-05 * solar_mass });
    array_set(bodies, 4, Body { x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03 * year, vy: 1.62824170038242295e-03 * year, vz: -9.51592254519715870e-05 * year, mass: 5.15138902046611451e-05 * solar_mass });
    let mut px = 0.0; let mut py = 0.0; let mut pz = 0.0;
    let mut i = 0;
    while i < count {
        let b = array_get_unchecked(bodies, i);
        px = px + b.vx * b.mass; py = py + b.vy * b.mass; pz = pz + b.vz * b.mass;
        i = i + 1;
    }
    let mut sun = array_get_unchecked(bodies, 0);
    sun.vx = (0.0 - px) / solar_mass;
    sun.vy = (0.0 - py) / solar_mass;
    sun.vz = (0.0 - pz) / solar_mass;
    print_float(energy(bodies, count));
    i = 0;
    while i < steps {
        advance(bodies, count, 0.01);
        i = i + 1;
    }
    print_float(energy(bodies, count));
    0
}
