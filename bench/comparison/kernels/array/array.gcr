// Matched single-threaded integer kernel, signed 64-bit throughout.
fn main() -> i64 { let mut a: Array<i64> = Array::new(1024); let mut i = 0; while i < 1024 { a[i] = 7; i = i + 1; } i = 0; while i < 5000000 { let k = i % 1024; let x = a[k]; a[k] = (x * 17 + i) % 1000000007; i = i + 1; } let mut sum = 0; i = 0; while i < 1024 { sum = sum + a[i]; i = i + 1; } print_int(sum); 0 }
