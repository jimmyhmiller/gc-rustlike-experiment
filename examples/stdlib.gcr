// A tour of the gc-rust standard library (all written in gc-rust itself, in the
// prelude): Vec with combinators, a String-keyed HashMap, the Eq/Ord traits,
// and generic sort/contains/max that work for user types too.

struct Score { name: String, points: i64 }

// Make Score orderable by points so the generic `sort`/`max` work on it.
impl Ord for Score {
    fn cmp(self, other: Score) -> Ordering { self.points.cmp(other.points) }
}

fn main() -> i64 {
    // Vec + iterator combinators.
    let mut nums: Vec<i64> = Vec::new();
    for n in 1..11 { nums.push(n); }                   // [1..10]
    let squares = nums.map(|x: i64| x * x);       // [1,4,9,...,100]
    let big = squares.filter(|x: i64| x > 25);    // [36,49,64,81,100]
    let sum_big = big.fold(0, |a: i64, x: i64| a + x);  // 330
    println!("sum of squares > 25: {}", sum_big);

    // HashMap: word -> length.
    let mut lengths: HashMap<String, i64> = HashMap::new();
    let words = "the quick brown fox".split(" ");   // split on space
    let mut i = 0;
    while i < words.len() {
        let w = words[i];
        lengths.insert(w, w.len());
        i += 1;
    }
    println!("len(quick) = {}", lengths.get("quick").unwrap_or(0));

    // Generic Ord-based sort on a user struct.
    let mut board: Vec<Score> = Vec::new();
    board.push(Score { name: "alice", points: 30 });
    board.push(Score { name: "bob", points: 50 });
    board.push(Score { name: "carol", points: 40 });
    let top = board.max().unwrap_or(Score { name: "none", points: 0 });
    println!("top scorer: {} with {}", top.name, top.points);

    board.sort();                                      // ascending by points
    // Checksum: sum_big + map length + lowest & highest points.
    sum_big + lengths.len() + board[0].points + top.points
    // 330 + 4 + 30 + 50 = 414
}
