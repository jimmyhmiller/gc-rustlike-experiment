// Uses the auto-imported prelude — no `Option`/`Result` declaration needed,
// and integer methods like `max` and `pow` come for free.

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a.abs();
    let mut y = b.abs();
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    x
}

fn safe_div(a: i64, b: i64) -> Result<i64, i64> {
    if b == 0 { Err(0 - 1) } else { Ok(a / b) }
}

fn first_even(n: i64) -> Option<i64> {
    let mut i = 0;
    while i < n {
        if i % 2 == 0 {
            return Some(i);
        }
        i += 1;
    }
    None
}

fn main() -> i64 {
    let q = safe_div(84, 2).unwrap_or(0);      // 42
    let e = first_even(5).unwrap_or(0 - 1);        // 0
    let m = q.max(10);                              // 42
    let p = 2.pow(5);                               // 32
    let g = gcd(48, 36);                                 // 12
    let none: Option<i64> = None;
    let none_default = none.unwrap_or(7);           // 7
    q + e + (m - 42) + (p - 32) + (g - 12) + (none_default - 7)
    // = 42 + 0 + 0 + 0 + 0 + 0 = 42
}
