// Strings are a built-in, GC-managed, varlen heap type (UTF-8 bytes) with
// methods (`len`, `is_empty`, `find`, `split`, ...) from the prelude. `+`
// concatenates and `==` compares contents. Concatenation allocates a fresh
// String and is fully GC-safe — the collector relocates live strings under
// stress.

fn shout(s: String) -> String {
    s + "!"
}

fn main() -> i64 {
    let name = "world";
    let greeting = "Hello, " + name + "";
    println(shout(greeting));            // "Hello, world!"

    // Equality is byte-wise.
    let yes = if name == "world" { 1 } else { 0 };

    // Build a longer string in a loop; each concat allocates, the running
    // accumulator stays rooted and survives every collection.
    let mut acc = "";
    for i in 0..5 {
        acc = acc + "ab";
    }
    println(acc);                        // "ababababab"

    // Formatting: numbers become strings with `to_string`, then concat.
    println!("answer = {}", 42);   // "answer = 42"
    println!("pi ~ {}", 3.14);     // "pi ~ 3.14"

    // Stdlib algorithms (written in gc-rust over the primitives): trim,
    // prefix/suffix tests, substring, byte search.
    let padded = "  trimmed  ";
    let clean = padded.trim();
    println(clean);                      // "trimmed"
    let pre = if clean.starts_with("trim") { 1 } else { 0 };
    let mid = clean[0..4];
    println(mid);                        // "trim"

    // Return a checksum: greeting len + acc len + equality + prefix flag +
    // trimmed len + mid len.
    greeting.len() + acc.len() + yes + pre + clean.len() + mid.len()
    // 12 + 10 + 1 + 1 + 7 + 4 = 35
}
