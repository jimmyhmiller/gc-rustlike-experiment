// A growable vector written in user code: an `impl` with `mut self` methods
// that update the struct in place (the prelude's `Vec<T>` works the same way).
struct IntVec { data: Array<i64>, len: i64 }

impl IntVec {
    fn new() -> IntVec { IntVec { data: Array::new(4), len: 0 } }

    fn get(self, i: i64) -> i64 { self.data[i] }

    fn push(mut self, x: i64) {
        if self.len == self.data.len() {
            let mut grown: Array<i64> = Array::new(self.data.len() * 2);
            for i in 0..self.len { grown[i] = self.data[i]; }
            self.data = grown;
        }
        self.data[self.len] = x;
        self.len += 1;
    }
}

fn main() -> i64 {
    let mut v = IntVec::new();
    for i in 0..20 { v.push(i * i); }
    print_int(v.len);
    v.get(5) + v.get(19)
}
