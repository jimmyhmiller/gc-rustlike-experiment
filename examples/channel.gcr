// Channels: bounded, blocking message passing between threads. Native queue
// slots root message boxes, so their Vec payloads are traced and relocated.
// A runtime control block provides the lock and parking. send blocks
// while full, recv blocks while empty (no busy-spin). See docs/threads.md.

fn produce(ch: Channel<Vec<i64>>, base: i64, n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let mut v: Vec<i64> = Vec::new();
        v.push(base + i);
        let _s = ch.send(v);
        i += 1;
    }
    0
}

fn main() -> i64 {
    // A small (capacity 4) channel forces real backpressure: producers block on
    // send when it fills, the consumer drains it.
    let ch: Channel<Vec<i64>> = Channel::new(4);
    let t1 = Thread::spawn(|| produce(ch, 0, 100));
    let t2 = Thread::spawn(|| produce(ch, 1000, 100));

    let mut total = 0;
    let mut got = 0;
    while got < 200 {
        let item = ch.recv_value();
        total += item[0];
        got += 1;
    }
    let _a = t1.join();
    let _b = t2.join();
    ch.close();
    total   // sum(0..99) + sum(1000..1099) = 4950 + 104950 = 109900
}
