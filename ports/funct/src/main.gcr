// The funct CLI (funct's src/main.rs), plus comparison modes for the port:
//   lex <file>                 print each token with {:?}
//   lexbench <file> <iters>    lex the file `iters` times; print ns per pass
//   parse <file>               print the program with {:#?}
//   parsebench <file> <iters>  lex + parse the file `iters` times
mod ast;
mod bytecode;
mod compiler;
mod imbl;
mod interop;
mod json;
mod lexer;
mod parser;
mod prelude;
mod serde;
mod serde_json;
mod snapshot;
mod testing;
mod value;
mod vm;

pub use interop::{FromValue, ToValue};
pub use value::{Value, VariantPayload};
pub use vm::{Cause, Fault, Funct, FunctError, RunResult, Status, StepResult, StopWhen, VmState};

use lexer::lex;
use parser::parse;

extern "C" fn clock_gettime_nsec_np(clock: i32) -> u64;
const CLOCK_UPTIME_RAW: i32 = 8;

fn now_ns() -> u64 { unsafe { clock_gettime_nsec_np(CLOCK_UPTIME_RAW) } }

fn main() {
    let args: Vec<String> = std::env::args().collect();
    if args.len() >= 4 && args[1] == "bench" {
        benchmark_batch(args);
        return;
    }
    // PORT: the comparison modes are not part of funct.
    if args.len() >= 3 && matches!(args[1].as_str(), "lex" | "lexbench" | "parse" | "parsebench" | "newbench") {
        compare_driver(args);
        return;
    }
    // `funct test [path]` — run funct-written tests (test_* functions)
    if args.get(1).map(|s| s.as_str()) == Some("test") {
        let target = args.get(2).map(String::as_str).unwrap_or(".");
        let ok = testing::run_and_print(std::path::Path::new(target));
        std::process::exit(if ok { 0 } else { 1 });
    }
    let path = match args.as_slice() {
        [_, cmd, path] if cmd == "run" => path.clone(),
        [_, path] => path.clone(),
        _ => {
            eprintln!("usage: funct [run] <file.ft> | funct test [file-or-dir]");
            std::process::exit(2);
        }
    };
    let src = match std::fs::read_to_string(path) {
        Ok(s) => s,
        Err(e) => {
            eprintln!("error: cannot read {}: {}", path, e);
            std::process::exit(2);
        }
    };
    let mut vm = Funct::new();
    // imports resolve relative to the script's directory
    if let Some(dir) = std::path::Path::new(path).parent() {
        if !dir.as_os_str().is_empty() {
            vm.set_module_root(dir);
        }
    }
    match vm.eval(src) {
        Ok(Value::Unit) => {}
        Ok(v) => println!("{}", v),
        Err(e) => {
            eprintln!("{}", e);
            std::process::exit(1);
        }
    }
}

fn compare_driver(args: Vec<String>) {
    if args.len() < 3 {
        eprintln!("usage: funct-port (lex|lexbench|parse|parsebench) <file> [iters]");
        std::process::exit(2);
    }
    let src = std::fs::read_to_string(args[2]).expect("read source");
    match args[1].as_str() {
        "lex" => match lex(src) {
            Ok(toks) => { for t in toks { println!("{:?}", t); } }
            Err(e) => println!("error: {}", e),
        },
        "lexbench" => {
            let iters: i64 = args[3].parse().unwrap();
            let mut count = 0;
            let start = now_ns();
            for _ in 0..iters { count += lex(src).unwrap().len(); }
            let elapsed = now_ns() - start;
            println!("tokens={} ns_per_pass={}", count / iters, elapsed / iters as u64);
        }
        "parse" => match parse(src) {
            Ok(program) => println!("{:#?}", program),
            Err(e) => println!("error: {}", e),
        },
        "parsebench" => {
            let iters: i64 = args[3].parse().unwrap();
            let mut count = 0;
            let start = now_ns();
            for _ in 0..iters { count += parse(src).unwrap().items.len(); }
            let elapsed = now_ns() - start;
            println!("items={} ns_per_pass={}", count / iters, elapsed / iters as u64);
        }
        "newbench" => {
            let iters: i64 = args[3].parse().unwrap();
            let mut count = 0;
            let start = now_ns();
            for _ in 0..iters { count += Funct::new().fns.len() as i64; }
            let elapsed = now_ns() - start;
            println!("fns={} ns_per_pass={}", count / iters, elapsed / iters as u64);
        }
        other => println!("unknown mode {}", other),
    }
}

// Run several workloads after one compiler startup. Each eval gets a fresh VM.
// bench <warmup> <samples> (<run|lex|parse|test> <path>)+
fn benchmark_batch(args: Vec<String>) {
    let warmup: i64 = args[2].parse().expect("warmup");
    let samples: i64 = args[3].parse().expect("samples");
    assert!(warmup >= 0 && samples > 0 && args.len() > 4 && args.len() % 2 == 0);
    let mut k = 4;
    while k < args.len() {
        let mode = args[k].as_str();
        let path = std::path::Path::new(args[k + 1]);
        for i in 0..warmup + samples {
            let start = Instant::now();
            match mode {
                "run" => {
                    let src = std::fs::read_to_string(path).expect("read workload");
                    let mut vm = Funct::new();
                    if let Some(dir) = path.parent() { vm.set_module_root(dir); }
                    match vm.eval(src).expect("eval workload") {
                        Value::Unit => {},
                        v => println!("{}", v),
                    }
                },
                "lex" => {
                    let src = std::fs::read_to_string(path).expect("read workload");
                    println!("tokens={}", lex(src).expect("lex workload").len());
                },
                "parse" => {
                    let src = std::fs::read_to_string(path).expect("read workload");
                    println!("items={}", parse(src).expect("parse workload").items.len());
                },
                "test" => assert!(testing::run_and_print(path)),
                _ => panic!("unknown benchmark mode"),
            }
            let elapsed = start.elapsed().as_nanos() as i64;
            println!("@sample {} {} {}", (k - 4) / 2, i, elapsed);
        }
        k += 2;
    }
}
